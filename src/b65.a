; B65 BASIC for the MEGA65 - top level build file
; An altered (45GS02) version of BBC BASIC (Z80) v5 by R.T. Russell.
; See LICENSE and docs/DESIGN.md.
!cpu m65
!to "build/b65.prg", cbm
!sl "build/b65.sym"
!src "src/zp.a"
!src "src/main.a"
!src "src/exec.a"
!src "src/exec2.a"
!src "src/dos.a"
!src "src/eval.a"
!src "src/funcs.a"
!src "src/fp.a"
!src "src/fp2.a"
!src "src/vars.a"
!src "src/os.a"
!src "src/tables.a"
!src "src/font.a"
!src "src/ovl.a"
!src "src/m65.a"
!src "src/sound.a"
NOVL = 1
ovltab: !word ovl_asm_img, ovl_asm_end-$e000
code_end:
        !align 255, 0
prog_start:
!if prog_start > $9000 { !error "interpreter too large" }
; ---- overlay images: copied to bank 4 at start-up, then free for programs ----
!src "src/asm.a"
!if ovl_asm_end-$e000 > $1ffa { !error "overlay 0 too large" }
ovl_images_end:
!if ovl_images_end > $c000 { !error "PRG too large" }
