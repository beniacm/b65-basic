; B65 BASIC - file system via MEGA65 Hyppo DOS traps (FAT32 SD card)
; Altered version of BBC BASIC (Z80) v5 by R.T. Russell (zlib licence) - see LICENSE
; Replaces the CP/M file layer (CMOS.Z80 OSLOAD/OSSAVE/OSOPEN/OSBGET...).
; Program files are the tokenised program, byte-compatible with BBC BASIC
; (Z80) v5. Names are 8.3; ".BBC" is appended when there is no extension.

FNBUF   = $07c0             ; (shared with FP stack area start: only used transiently)
FEXBUF  = $0760             ; 11 bytes: 8.3 name for directory compare
DIRENT  = $0700             ; Hyppo dirent buffer (87 bytes, page aligned)
NCHAN   = 4

; ---- Hyppo trap: A = function; returns carry set on success, A = result/error
hyppo:  clc
        sta $d640
        clv
        ldz #0
        rts

; DOSINIT: make sure the default drive is selected (needed when started
; before the ROM has initialised DOS, e.g. from the test boot stub)
dosinit:
        lda #$02                ; get default drive
        jsr hyppo
        tax
        lda #$06                ; select drive X
        jmp hyppo

; SETFNAME: ACCS/slen -> FNBUF (upper case, default .BBC) and Hyppo setname
!zone setfname
setfname:
        jsr dosinit
        ldx #0
        ldy #0
        lda #0
        sta tmp3                ; '.' seen
.l      cpx slen
        beq .e
        lda ACCS,x
        inx
        cmp #' '
        beq .l
        cmp #'"'
        beq .l
        cmp #'.'
        bne +
        sta tmp3
+       cmp #'a'
        bcc +
        cmp #'z'+1
        bcs +
        and #$df
+       sta FNBUF,y
        iny
        cpy #30
        bcc .l
.e      lda tmp3
        bne +
        lda #'.'
        sta FNBUF,y
        iny
        lda #'B'
        sta FNBUF,y
        iny
        lda #'B'
        sta FNBUF,y
        iny
        lda #'C'
        sta FNBUF,y
        iny
+       lda #0
        sta FNBUF,y
        ldx #<FNBUF
        ldy #>FNBUF
        lda #$2e                ; setname
        jsr hyppo
        bcs +
        jmp badname
+       rts

; FEXISTS: carry set if FNBUF names an existing file (scans the directory;
; independent of Hyppo findfile semantics)
!zone fexists
fexists:
        ldx #0                  ; build 8.3 raw name in FEXBUF
        lda #' '
-       sta FEXBUF,x
        inx
        cpx #11
        bne -
        ldx #0
        ldy #0
-       lda FNBUF,x
        beq .raw
        cmp #'.'
        beq .ext
        cpy #8
        bcs +
        sta FEXBUF,y
        iny
+       inx
        bra -
.ext    inx
        ldy #8
-       lda FNBUF,x
        beq .raw
        cpy #11
        bcs .raw
        sta FEXBUF,y
        iny
        inx
        bra -
.raw    lda #$12                ; opendir
        jsr hyppo
        bcc .no
        sta tmp6
.ent    ldx tmp6
        ldy #>DIRENT
        lda #$14                ; readdir
        jsr hyppo
        bcc .nf
        ldx #10                 ; short name compare
-       lda DIRENT+65,x
        cmp FEXBUF,x
        bne .lfn
        dex
        bpl -
        bra .yes
.lfn    ldx #0                  ; long name compare (case-insensitive)
-       lda DIRENT,x
        jsr .up
        sta tmp0
        lda FNBUF,x
        cmp tmp0
        bne .ent
        cmp #0
        beq .yes
        inx
        cpx #63
        bne -
        bra .ent
.yes    jsr .close
        sec
        rts
.nf     jsr .close
.no     clc
        rts
.close  ldx tmp6
        lda #$16
        jmp hyppo
.up     cmp #'a'
        bcc +
        cmp #'z'+1
        bcs +
        and #$df
+       rts

setname2:                       ; re-issue setname for FNBUF
        ldx #<FNBUF
        ldy #>FNBUF
        lda #$2e
        jmp hyppo

notfound:
        lda #<msg_nf
        ldx #>msg_nf
        ldy #214
        bra dosmsg
badname:
        lda #<msg_bn
        ldx #>msg_bn
        ldy #204
        bra dosmsg
diskerr:
        lda #<msg_de
        ldx #>msg_de
        ldy #199
dosmsg: sta errtxt
        stx errtxt+1
        sty errnum
        lda #$38                ; Hyppo: get last error code -> DOSERR
        jsr hyppo
        sta doserr
        lda errnum
        jmp exterr
msg_nf: !text "File not found",0
msg_bn: !text "Bad name",0
msg_de: !text "Disk fault",0

; ---- LOAD "name" (command) ----
load:   jsr fname
        jsr loadprg
        jmp clopp
fname:  jsr exprs
        jmp setfname
; LOADPRG: load file at PAGE, check it
loadprg:
        jsr fexists
        bcs +
        jmp notfound
+       jsr setname2
        ldx page                ; loadfile: load address $ZZYYXX
        ldy page+1
        ldz #0
        lda #$36
        jsr hyppo
        bcs +
        jsr newit
        jmp notfound
+       jmp clean               ; checks the program (Bad program) and CLEAR

; ---- SAVE "name" (command) ----
!zone save
save:   jsr ovjmp           ; own FAT32 writer (Hyppo's mkfile does not work)
        !byte 3
        !word fsave

; ---- CHAIN "name" / RUN "name" ----
chain:  jsr fname
        jsr loadprg
        jmp run0

; ---- *commands: *CAT (*.), *DELETE name, *DIR (cd root) ----
!zone star
star:   ldy #0
        lda [tp],z
        cmp #'.'
        beq .cat
        jsr .word
        cmp #'C'
        bne +
        jmp .cat
+       cmp #'D'
        bne .bad
        jmp .del
.bad    jmp rem                 ; unknown * command: ignored
.word   +ldtpy              ; first letter (upper case), skip the word
        and #$df
        pha
-       inw tp
        +ldtpy
        cmp #' '
        beq +
        cmp #CR
        beq +
        bra -
+       pla
        rts
.cat    lda #$12                ; opendir
        jsr hyppo
        bcs +
        jmp diskerr
+       sta tmp6
.ent    ldx tmp6
        ldy #>DIRENT
        lda #$14                ; readdir
        jsr hyppo
        bcc .endc
        lda DIRENT+86           ; attributes: skip volume labels / hidden
        and #$0a
        bne .ent
        ldx #0                  ; short name: 8 + '.' + 3, blanks trimmed
        ldy #0
-       lda DIRENT+65,x
        cmp #' '
        beq +
        jsr outchr
        iny
+       inx
        cpx #8
        bne -
        lda DIRENT+73
        cmp #' '
        beq +
        lda #'.'
        jsr outchr
        iny
-       lda DIRENT+65,x
        cmp #' '
        beq +
        jsr outchr
        iny
        inx
        cpx #11
        bne -
+       lda #' '
-       cpy #14
        bcs +
        jsr outchr
        iny
        bra -
+       lda DIRENT+82           ; length
        sta acc
        lda DIRENT+83
        sta acc+1
        lda DIRENT+84
        sta acc+2
        lda DIRENT+85
        sta acc+3
        lda #0
        sta accx
        jsr numstr
        stx tmp0
        ldx #0
-       cpx tmp0
        beq +
        lda NUMBUF,x
        jsr outchr
        inx
        bra -
+       jsr crlf
        bra .ent
.endc   ldx tmp6
        lda #$16                ; closedir
        jsr hyppo
        jmp rem
.del    jsr nxt                 ; *DELETE name (rest of line)
        ldx #0
-       lda [tp],z
        cmp #CR
        beq +
        sta ACCS,x
        inx
        inw tp
        bra -
+       stx slen
        jsr setfname
        jsr fexists
        bcs +
        jmp notfound
+       jsr setname2
        lda #$34
        jsr hyppo
        bcs +
        jmp notfound
+       lda #$26
        jsr hyppo
        jmp xeq

; ---- channels: implemented in overlay 3 (fat.a); buffers in attic RAM ----
CHT     = MISC+16           ; 4 channels x 16 bytes
CH_OPEN = 1
CH_PTR  = 6
CH_EXT  = 10

f_openin:
        lda #1
        bra +
f_openout:
        lda #0
        bra +
f_openup:
        lda #2
+       sta omode
        jsr ovjsr
        !byte 3
        !word o_open
        rts
f_bget: jsr ovjsr
        !byte 3
        !word o_bget
        rts
f_eof:  jsr ovjsr
        !byte 3
        !word o_eof
        rts
f_ptr:  jsr ovjsr
        !byte 3
        !word o_ptr
        rts
f_ext:  jsr ovjsr
        !byte 3
        !word o_ext
        rts
f_getsch:
        jsr ovjsr
        !byte 3
        !word o_gets
        rts
close:  jsr ovjmp
        !byte 3
        !word o_close
ptrset: jsr ovjmp
        !byte 3
        !word o_ptrset
bput:   jsr ovjmp
        !byte 3
        !word o_bput
printh: jsr ovjmp
        !byte 3
        !word o_printh
install:
        jsr ovjmp
        !byte 3
        !word o_install
inputh: jsr ovjmp
        !byte 3
        !word o_inputh

; CHANNEL: '#' expr -> X = channel table offset (error if not open)
!zone channel
channel:
        jsr nxt
        cmp #'#'
        beq +
        lda #45                 ; Missing #
        jmp error
+       inw tp
        jsr itemi
chanx:  lda acc
        beq .bad
        cmp #NCHAN+1
        bcs .bad
        dec
        asl
        asl
        asl
        asl
        tax
        lda CHT+CH_OPEN,x
        beq .bad
        rts
.bad    lda #<msg_ch
        ldx #>msg_ch
        ldy #222
        jmp dosmsg
msg_ch: !text "Channel",0

