; B65 BASIC - expression evaluator (after BBC BASIC (Z80) v5 EVAL.Z80)
; Altered version of BBC BASIC (Z80) v5 by R.T. Russell (zlib licence) - see LICENSE
; Result: numeric in acc/accx (accx=0: 32-bit integer), etype=0
;         string in ACCS/slen, etype=$80
; Precedence (BASIC V): 1 OR EOR, 2 AND, 3 = <> < > <= >= << >> >>>,
;                       4 + -, 5 * / MOD DIV, 6 ^

OP_OR=0
OP_EOR=1
OP_AND=2
OP_EQ=3
OP_NE=4
OP_LT=5
OP_GT=6
OP_LE=7
OP_GE=8
OP_SHL=9
OP_ASR=10
OP_LSR=11
OP_ADD=12
OP_SUB=13
OP_MUL=14
OP_FDIV=15
OP_MOD=16
OP_IDIV=17
OP_POW=18

; ---- helpers ----
expri:  jsr expr
        jmp toint
itemi:  jsr item
toint:  lda etype
        bpl +
        lda #6
        jmp error
+       lda accx
        beq +
        jmp sfix
+       rts
exprn:  jsr expr
        lda etype
        bpl +
        lda #6
        jmp error
+       rts
exprs:  jsr expr
        lda etype
        bmi +
        lda #6
        jmp error
+       rts

comma:  jsr nxt
        cmp #','
        bne +
        inw tp
        rts
+       lda #5
        jmp error
braket: jsr nxt
        cmp #')'
        bne +
        inw tp
        rts
+       lda #27
        jmp error

; ---- EXPR ----
!zone expr
expr:   lda #1
exprp:  pha                     ; minimum precedence
        jsr item
.loop   jsr nxt
        jsr getop               ; A = prec (Z: none), X = op, Y = length
        beq .done
        sta tmp0
        pla
        pha
        cmp tmp0
        beq .ok
        bcs .done               ; minprec > prec
.ok     tya                     ; consume operator
        clc
        adc tp
        sta tp
        bcc +
        inc tp+1
+       phx                     ; op
        lda tmp0
        pha                     ; prec
        jsr pushval
        lda tmp0                ; next minprec = prec+1 (left-assoc)
        inc
        jsr exprp
        jsr popval              ; left operand -> arg/argx or STRBUF/tmp6, tmp5 = type
        pla                     ; prec
        plx                     ; op
        jsr binop
        bra .loop
.done   pla
        rts

; push current value: numeric acc(4),accx,etype ; string bytes,len,etype
!zone pushval
pushval:
        pla                     ; return address
        sta tmpw
        pla
        sta tmpw+1
        lda etype
        bmi .s
        lda acc
        pha
        lda acc+1
        pha
        lda acc+2
        pha
        lda acc+3
        pha
        lda accx
        pha
        lda etype               ; 0 = number, $40 = array reference
        pha
        bra .r
.s      ldx slen
        beq +
-       dex
        lda ACCS,x
        pha
        cpx #0
        bne -
+       lda slen
        pha
        lda #$80
        pha
.r      lda tmpw+1
        pha
        lda tmpw
        pha
        rts

!zone popval
popval: pla
        sta tmpw
        pla
        sta tmpw+1
        pla
        sta tmp5                ; type of left operand
        bmi .s
        pla
        sta argx
        pla
        sta arg+3
        pla
        sta arg+2
        pla
        sta arg+1
        pla
        sta arg
        bra .r
.s      pla
        sta tmp6                ; length
        ldx #0
-       cpx tmp6
        beq .r
        pla
        sta STRBUF,x
        inx
        bra -
.r      lda tmpw+1
        pha
        lda tmpw
        pha
        rts

; ---- GETOP: recognise binary operator at tp ----
!zone getop
getop:  ldy #0
        lda [tp],z
        tax
        lda optab,x             ; prec << 5 | op, $ff: relational, 0: none
        lbeq .ret
        cmp #$ff
        beq .rel
        tay
        and #$1f
        tax
        tya
        lsr
        lsr
        lsr
        lsr
        lsr
        ldy #1
        rts
.rel    lda [tp],z
        cmp #TOR
        bne +
        ldx #OP_OR
        lda #1
        lbra .l1
+       cmp #TEOR
        bne +
        ldx #OP_EOR
        lda #1
        lbra .l1
+       cmp #TAND
        bne +
        ldx #OP_AND
        lda #2
        lbra .l1
+       cmp #'+'
        bne +
        ldx #OP_ADD
        bra .p4
+       cmp #'-'
        bne +
        ldx #OP_SUB
.p4     lda #4
        lbra .l1
+       cmp #'*'
        bne +
        ldx #OP_MUL
        bra .p5
+       cmp #'/'
        bne +
        ldx #OP_FDIV
        bra .p5
+       cmp #TMOD
        bne +
        ldx #OP_MOD
        bra .p5
+       cmp #TDIV
        bne +
        ldx #OP_IDIV
.p5     lda #5
        bra .l1
+       cmp #'^'
        bne +
        ldx #OP_POW
        lda #6
        bra .l1
+       cmp #'='
        bne +
        ldx #OP_EQ
        iny
        +ldtpy
        cmp #'='                ; '==' synonym
        beq .p3b
        bra .p3
+       cmp #'<'
        bne .gt
        iny
        +ldtpy
        ldx #OP_LE
        cmp #'='
        beq .p3b
        ldx #OP_NE
        cmp #'>'
        beq .p3b
        ldx #OP_SHL
        cmp #'<'
        beq .p3b
        ldx #OP_LT
        bra .p3
.gt     cmp #'>'
        bne .none
        iny
        +ldtpy
        ldx #OP_GE
        cmp #'='
        beq .p3b
        cmp #'>'
        bne .gt1
        iny
        +ldtpy
        ldx #OP_LSR
        cmp #'>'
        beq .p3b
        ldx #OP_ASR
        bra .p3
.gt1    ldx #OP_GT
        bra .p3
.p3b    iny
.p3     lda #3
        bra .ret
.l1     ldy #1
.ret    cmp #0
        rts
.none   lda #0
        rts
optab:  !fill 256, 0
* = optab + '+', overlay
        !byte 4<<5 | OP_ADD
* = optab + '-', overlay
        !byte 4<<5 | OP_SUB
* = optab + '*', overlay
        !byte 5<<5 | OP_MUL
* = optab + '/', overlay
        !byte 5<<5 | OP_FDIV
* = optab + '^', overlay
        !byte 6<<5 | OP_POW
* = optab + '<', overlay
        !byte $ff
* = optab + '=', overlay
        !byte $ff
* = optab + '>', overlay
        !byte $ff
* = optab + TOR, overlay
        !byte 1<<5 | OP_OR
* = optab + TEOR, overlay
        !byte 1<<5 | OP_EOR
* = optab + TAND, overlay
        !byte 2<<5 | OP_AND
* = optab + TMOD, overlay
        !byte 5<<5 | OP_MOD
* = optab + TDIV, overlay
        !byte 5<<5 | OP_IDIV
* = optab + 256, overlay

; ---- BINOP: arg/argx (or STRBUF) OP acc -> acc; X = op, tmp5 = left type ----
!zone binop
binop:  lda tmp5
        eor etype
        bpl +
        lda #6                  ; Type mismatch
        jmp error
+       lda etype
        bpl .num
        ; strings
        cpx #OP_ADD
        bne +
        jmp sconcat
+       cpx #OP_EQ
        bcc .mis
        cpx #OP_GE+1
        bcs .mis
        jsr scomp               ; A = -1/0/1 (left vs right)
        jmp cmpres
.mis    lda #6
        jmp error
.num    lda argx
        ora accx
        beq .int
        jmp fpbinop
.int    txa
        asl
        tax
        jmp (opstab,x)

opstab: !word i_or, i_eor, i_and, i_cmp, i_cmp, i_cmp, i_cmp, i_cmp, i_cmp
        !word i_shl, i_asr, i_lsr, i_add, i_sub, i_mul, i_fdiv, i_mod, i_idiv, i_pow

i_or:   ldq arg
        orq acc
        stq acc
        ldz #0
        rts
i_eor:  ldq arg
        eorq acc
        stq acc
        ldz #0
        rts
i_and:  ldq arg
        andq acc
        stq acc
        ldz #0
        rts


; integer add/sub (arg OP acc); overflow promotes to floating point
!zone iaddsub
i_add:  clc
        lda arg
        adc acc
        sta fp64
        lda arg+1
        adc acc+1
        sta fp64+1
        lda arg+2
        adc acc+2
        sta fp64+2
        lda arg+3
        adc acc+3
        sta fp64+3
        lda arg+3
        eor acc+3
        bmi .ok                 ; different signs never overflow
        lda arg+3
        eor fp64+3
        bpl .ok
        ldx #OP_ADD
        jmp fpbinop
.ok     ldq fp64
        stq acc
        ldz #0
        rts
i_sub:  sec
        lda arg
        sbc acc
        sta fp64
        lda arg+1
        sbc acc+1
        sta fp64+1
        lda arg+2
        sbc acc+2
        sta fp64+2
        lda arg+3
        sbc acc+3
        sta fp64+3
        lda arg+3
        eor acc+3
        bpl .ok                 ; same signs never overflow
        lda arg+3
        eor fp64+3
        bpl .ok
        ldx #OP_SUB
        jmp fpbinop

i_shl:  lda acc
        and #31
        tax
        beq +
-       asl arg
        rol arg+1
        rol arg+2
        rol arg+3
        dex
        bne -
+       jmp argtoacc
i_lsr:  lda acc
        and #31
        tax
        beq +
-       lsr arg+3
        ror arg+2
        ror arg+1
        ror arg
        dex
        bne -
+       jmp argtoacc
i_asr:  lda acc
        and #31
        tax
        beq +
-       lda arg+3
        asl
        ror arg+3
        ror arg+2
        ror arg+1
        ror arg
        dex
        bne -
+       jmp argtoacc

argtoacc:
        ldq arg
        stq acc
        ldz #0
        lda #0
        sta accx
        rts

; comparisons (integer): signed compare arg vs acc
i_cmp:  txa
        lsr
        tax                     ; op index
        lda arg+3
        eor #$80
        sta arg+3
        lda acc+3
        eor #$80
        sta acc+3
        ldy #3
-       lda arg,y
        cmp acc,y
        bne .ne
        dey
        bpl -
        lda #0
        bra cmpres
.ne     bcc +
        lda #1
        bra cmpres
+       lda #$ff
; CMPRES: A = -1/0/1 (left<,=,> right), X = op -> acc = TRUE/FALSE
cmpres: sta tmp0
        ldy #0                  ; result false
        cpx #OP_EQ
        bne +
        lda tmp0
        bne .set
        bra .t
+       cpx #OP_NE
        bne +
        lda tmp0
        beq .set
        bra .t
+       cpx #OP_LT
        bne +
        lda tmp0
        bpl .set
        bra .t
+       cpx #OP_GT
        bne +
        lda tmp0
        cmp #1
        bne .set
        bra .t
+       cpx #OP_LE
        bne +
        lda tmp0
        cmp #1
        beq .set
        bra .t
+       lda tmp0                ; GE
        bmi .set
.t      ldy #$ff
.set    sty acc
        sty acc+1
        sty acc+2
        sty acc+3
        lda #0
        sta accx
        sta etype
        rts

; multiply: Z80 IMUL semantics (exact, overflow -> truncated float)
i_mul:  jsr fswap
        jmp imulz

absacc: lda acc+3
        bpl +
        jmp ineg
+       rts
absarg: lda arg+3
        bpl +
        lda #0
        sec
        sbc arg
        sta arg
        lda #0
        sbc arg+1
        sta arg+1
        lda #0
        sbc arg+2
        sta arg+2
        lda #0
        sbc arg+3
        sta arg+3
+       rts
; INEG: acc = -acc (integer)
ineg:   lda #0
        sec
        sbc acc
        sta acc
        lda #0
        sbc acc+1
        sta acc+1
        lda #0
        sbc acc+2
        sta acc+2
        lda #0
        sbc acc+3
        sta acc+3
        rts

; DIV / MOD (truncating, remainder takes sign of dividend)
!zone idiv
i_idiv: lda arg+3
        eor acc+3
        sta tmp4
        jsr udivmod
        ldq arg                 ; quotient
        stq acc
        ldz #0
        lda tmp4
        bpl +
        jmp ineg
+       rts
i_mod:  lda arg+3
        sta tmp4
        jsr udivmod
        ldq saveacc             ; remainder
        stq acc
        ldz #0
        lda tmp4
        bpl +
        jmp ineg
+       rts
; |arg| / |acc| -> arg = quotient, saveacc = remainder
udivmod:
        lda acc
        ora acc+1
        ora acc+2
        ora acc+3
        bne +
        lda #18                 ; Division by zero
        jmp error
+       jsr absacc
        jsr absarg
        lda fpsoft
        bne .soft
        ; math unit: quotient estimate from the divider, remainder from the
        ; multiplier, then corrected until 0 <= remainder < divisor
        ldq arg
        stq saveacc             ; dividend
        stq $d770
        ldq acc
        stq $d774
-       bit $d70f               ; divider busy
        bmi -
        ldq $d76c               ; integer part of the quotient
        stq arg
        stq $d770
-       bit $d70f               ; multiplier busy
        bvs -
        ldq $d778               ; quotient * divisor (low 32 bits)
        stq tmpw
        ldq saveacc
        sec
        sbcq tmpw
        stq saveacc             ; remainder (wraps negative if too big)
        ldz #0
.dn     lda saveacc+3           ; remainder < 0: quotient - 1
        bpl .up
        ldq saveacc
        clc
        adcq acc
        stq saveacc
        ldz #0
        deq arg
        bra .dn
.up     ldq saveacc             ; remainder >= divisor: quotient + 1
        sec
        sbcq acc
        bcc +
        stq saveacc
        ldz #0
        inq arg
        bra .up
+       ldz #0
        lda #0
        sta accx
        rts
.soft   lda #0
        sta saveacc
        sta saveacc+1
        sta saveacc+2
        sta saveacc+3
        ldx #32
.l      asl arg
        rol arg+1
        rol arg+2
        rol arg+3
        rol saveacc
        rol saveacc+1
        rol saveacc+2
        rol saveacc+3
        sec
        lda saveacc
        sbc acc
        sta tmp0
        lda saveacc+1
        sbc acc+1
        sta tmp1
        lda saveacc+2
        sbc acc+2
        sta tmp2
        lda saveacc+3
        sbc acc+3
        bcc +
        sta saveacc+3
        lda tmp2
        sta saveacc+2
        lda tmp1
        sta saveacc+1
        lda tmp0
        sta saveacc
        inc arg
+       dex
        bne .l
        lda #0
        sta accx
        rts

; ---- floating point binary operators ----
; in: arg = left, acc = right, X = op ; out: acc/accx
!zone fpbinop
i_fdiv: ldx #OP_FDIV
        bra fpbinop
i_pow:  ldx #OP_POW
fpbinop:
        stx fpopc
        jsr fswap               ; Z80 convention: FA = left, FB = right
        lda fpopc
        cmp #OP_POW
        bne +
        jsr fppow
        bra .num
+       cmp #OP_EQ
        bcc .intop
        cmp #OP_SHL
        bcs +
        jsr float2              ; comparisons: float both
        jsr sfloat
        jsr fcmp
        ldx fpopc
        jmp cmpres
+       cmp #OP_ADD
        bcc .intop              ; shifts
        cmp #OP_MOD
        bcs .intop              ; MOD, DIV
        pha
        jsr float2
        jsr sfloat
        pla
        cmp #OP_ADD
        bne +
        jsr fadd
        bra .num
+       cmp #OP_SUB
        bne +
        jsr fsub
        bra .num
+       cmp #OP_MUL
        bne +
        jsr fmul
        bra .num
+       jsr fdiv
.num    lda #0
        sta etype
        rts
.intop  jsr fix2                ; integer-only operator: fix both
        jsr sfix
        jsr fswap               ; back to arg = left
        lda fpopc
        asl
        tax
        jmp (opstab,x)
nofp:   lda #<msg_nofp
        sta errtxt
        lda #>msg_nofp
        sta errtxt+1
        lda #254
        jmp exterr
msg_nofp: !text "Floating point not implemented yet",0
msg_noimp: !text "Not implemented yet",0
noimp:  lda #<msg_noimp
        sta errtxt
        lda #>msg_noimp
        sta errtxt+1
        lda #254
        jmp exterr

; ---- strings ----
!zone sconcat
sconcat:
        lda tmp6
        clc
        adc slen
        bcc +
        lda #19                 ; String too long
        jmp error
+       sta tmp0
        ; move ACCS[0..slen) up by tmp6
        ldx slen
        beq .cp
-       dex
        lda ACCS,x
        phx
        pha
        txa
        clc
        adc tmp6
        tax
        pla
        sta ACCS,x
        plx
        cpx #0
        bne -
.cp     ldx #0
-       cpx tmp6
        beq +
        lda STRBUF,x
        sta ACCS,x
        inx
        bra -
+       lda tmp0
        sta slen
        rts

; compare STRBUF(tmp6) with ACCS(slen) -> A = -1/0/1
scomp:  ldy #0
.l      cpy tmp6
        beq .lend
        cpy slen
        beq .gt
        lda STRBUF,y
        cmp ACCS,y
        bne .ne
        iny
        bra .l
.lend   cpy slen
        beq .eq
        lda #$ff
        rts
.eq     lda #0
        rts
.ne     bcc +
.gt     lda #1
        rts
+       lda #$ff
        rts

; ---- ITEM ----
!zone item
item:   jsr nxt
        cmp #TNUM
        bne +
        jmp tnumget
+       cmp #'0'
        bcc +
        cmp #'9'+1
        bcs +
        jmp number
+       cmp #'.'
        bne +
        jmp number
+       cmp #'"'
        bne +
        jmp strlit
+       cmp #'('
        bne +
        inw tp
        jsr expr
        jmp braket
+       cmp #'-'
        bne +
        inw tp
        jsr item
        jsr chknum
        lda accx
        beq .negi
        lda acc+3
        eor #$80
        sta acc+3
        rts
.negi   lda acc+3               ; -(-2^31) needs floating point
        cmp #$80
        bne .ng
        lda acc
        ora acc+1
        ora acc+2
        bne .ng
        jsr sfloat
        lda acc+3
        eor #$80
        sta acc+3
        rts
.ng     jmp ineg
+       cmp #'+'
        bne +
        inw tp
        jmp item
+       cmp #'&'
        bne +
        jmp hexnum
+       cmp #'^'
        bne +
        inw tp
        jmp f_addr
+       cmp #'%'
        bne +
        jmp binnum
+       cmp #$80
        bcs .tok
        cmp #$20
        bcc .tok
        ; variable
        jsr getvar
        bcs .mist
        beq .found
        bra .undef
.found  lda vtype
        bmi +
        jmp loadn
+       jmp loads
.undef  lda asmq                ; assembler first pass: undefined label = P%
        beq +
        ldx #4
-       lda STAVAR+4*('P'-'@'),x
        sta acc,x
        dex
        bpl -
        lda #0
        sta accx
        sta etype
        rts
+       lda #26
        jmp error
.mist   lda #16                 ; Syntax error
        jmp error
.tok    inw tp
        sta tmp0
        ldx #0
-       lda functab,x
        beq .unk
        cmp tmp0
        beq .fnd
        inx
        inx
        inx
        bra -
.fnd    jmp (functab+1,x)
.unk    lda #16
        jmp error

chknum: lda etype
        bpl +
        lda #6
        jmp error
+       rts

; number constant: decimal integers of up to 9 digits directly (Q ops),
; anything else (more digits, '.', 'E') through CON (floating point package)
!zone number
number: lda tp
        sta fe_
        lda tp+1
        sta ff_
        lda #0
        sta acc
        sta acc+1
        sta acc+2
        sta acc+3
        sta accx
        sta etype
        lda #9                  ; digits allowed on the fast path
        sta fc_
.l      lda [tp],z
        cmp #'0'
        bcc .x
        cmp #'9'+1
        bcs .x
        dec fc_
        bmi .slow
        and #$0f
        sta fd_
        inw tp
        aslq acc                ; acc = 10 * acc + digit (Q = A,X,Y,Z)
        ldq acc
        aslq acc
        aslq acc
        clc
        adcq acc
        stq acc
        ldz #0
        lda acc
        clc
        adc fd_
        sta acc
        bcc .l
        inc acc+1
        bne .l
        inc acc+2
        bne .l
        inc acc+3
        bra .l
.x      cmp #'.'
        beq .slow
        cmp #'E'
        beq .slow
        rts
.slow   lda fe_
        sta tp
        lda ff_
        sta tp+1
        jmp con

!zone hexnum
hexnum: inw tp
        lda #0
        sta acc
        sta acc+1
        sta acc+2
        sta acc+3
        sta accx
        sta etype
        sta tmp1                ; digit count
.l      lda [tp],z
        cmp #'a'
        bcc +
        sbc #$20
+       sec
        sbc #'0'
        bcc .x
        cmp #10
        bcc .d
        sbc #7
        cmp #10
        bcc .x
        cmp #16
        bcs .x
.d      sta tmp0
        inw tp
        inc tmp1
        aslq acc
        aslq acc
        aslq acc
        aslq acc
        lda acc
        ora tmp0
        sta acc
        bra .l
.x      lda tmp1
        bne +
        lda #28                 ; Bad hex or binary
        jmp error
+       rts

; TNUMGET: tp -> TNUM: acc = the constant (integer), tp past it (Z = 0)
!zone tnumget
tnumget:
        ldz #1
        lda [tp],z
        and #7                  ; chunks - 1
        bne .n2
        ldz #3                  ; one chunk: 0..63
        lda [tp],z
        and #$3f
        sta acc
        lda #0
        sta acc+1
        sta acc+2
        sta acc+3
        sta accx
        sta etype
        ldz #0
        lda tp                  ; tp += 4
        clc
        adc #4
        sta tp
        bcc +
        inc tp+1
+       rts
.n2     sta tmp0
        cmp #1
        bne .gen
        ldz #4                  ; two chunks: 0..4095
        lda [tp],z
        and #$3f
        sta acc+1
        lsr acc+1
        ror
        lsr acc+1
        ror
        and #$c0
        sta acc
        dez
        lda [tp],z
        and #$3f
        ora acc
        sta acc
        lda #0
        sta acc+2
        sta acc+3
        bra .done
.gen    ldx #0                  ; 3..6 chunks into fp64..fp64+5 (missing = 0)
        stx fp64+3
        stx fp64+4
        stx fp64+5
        ldz #3
-       lda [tp],z
        and #$3f
        sta fp64,x
        inz
        inx
        cpx tmp0
        bcc -
        beq -
        lda fp64+1              ; acc   = c0 | c1 << 6
        asl
        asl
        asl
        asl
        asl
        asl
        ora fp64
        sta acc
        lda fp64+2              ; acc+1 = c1 >> 2 | c2 << 4
        asl
        asl
        asl
        asl
        sta acc+1
        lda fp64+1
        lsr
        lsr
        ora acc+1
        sta acc+1
        lda fp64+3              ; acc+2 = c2 >> 4 | c3 << 2
        asl
        asl
        sta acc+2
        lda fp64+2
        lsr
        lsr
        lsr
        lsr
        ora acc+2
        sta acc+2
        lda fp64+5              ; acc+3 = c4 | c5 << 6
        asl
        asl
        asl
        asl
        asl
        asl
        ora fp64+4
        sta acc+3
.done   lda #0
        sta accx
        sta etype
        ldz #0
        lda tmp0                ; tp += chunks + 3
        clc
        adc #4
        clc
        adc tp
        sta tp
        bcc +
        inc tp+1
+       rts

; TNUMLIST: tp -> TNUM: print the constant as typed; A = its length in bytes
!zone tnumlist
tnumlist:
        ldz #1
        lda [tp],z
        sta fa_                 ; D1
        ldz #2
        lda [tp],z
        and #$3f
        sta fb_                 ; digits typed
        ldz #0
        jsr tnumget
        lda fa_
        and #$20
        bne .hex
        ldx #8                  ; decimal: 10^8 .. 10^0
        stx fc_
.dl     lda #0
        sta fd_                 ; digit
.ds     ldx fc_
        sec
        lda acc
        sbc p10b0,x
        sta tmpw
        lda acc+1
        sbc p10b1,x
        sta tmpw+1
        lda acc+2
        sbc p10b2,x
        sta tmpw2
        lda acc+3
        sbc p10b3,x
        bcc .dp
        sta acc+3
        lda tmpw2
        sta acc+2
        lda tmpw+1
        sta acc+1
        lda tmpw
        sta acc
        inc fd_
        bra .ds
.dp     lda fd_
        bne .dpr
        lda fc_
        beq .dpr                ; last digit always
        cmp fb_
        bcs .dn                 ; leading zero beyond the digits typed
.dpr    lda #$ff
        sta fb_                 ; from now on every digit
        lda fd_
        ora #'0'
        jsr outchr
.dn     dec fc_
        bpl .dl
        bra .len
.hex    lda #'&'
        jsr outchr
        lda #0
        sta tmpw2
        ldx #7
.hl     txa                     ; nibble x
        lsr
        tay
        lda acc,y
        bcs +
        and #$0f
        bra ++
+       lsr
        lsr
        lsr
        lsr
++      bne .hpr
        cpx #0
        beq .hpr
        cpx fb_
        bcs .hn
.hpr    stx tmpw
        ldx #$ff
        stx fb_
        ldx tmpw
        cmp #10
        bcc +
        adc #'A'-10-1           ; (carry set)
        pha
        lda fa_                 ; D1 bit 4: typed in lower case (+$20)
        and #$10
        asl
        tsb tmpw2
        pla
        ora tmpw2
        bra ++
+       ora #'0'
++      jsr outchr
.hn     dex
        bpl .hl
.len    lda fa_
        and #7
        clc
        adc #4
        rts
p10b0:  !byte <1, <10, <100, <1000, <10000, <100000, <1000000, <10000000, <100000000
p10b1:  !byte >1, >10, >100, >1000, >10000, >100000, >1000000, >10000000, >100000000
p10b2:  !byte ^1, ^10, ^100, ^1000, ^10000, ^100000, ^1000000, ^10000000, ^100000000
p10b3:  !byte 0, 0, 0, 0, 0, 0, 0, 0, 100000000 >> 24

!zone binnum
binnum: inw tp
        lda #0
        sta acc
        sta acc+1
        sta acc+2
        sta acc+3
        sta accx
        sta etype
        sta tmp1
.l      lda [tp],z
        sec
        sbc #'0'
        bcc .x
        cmp #2
        bcs .x
        lsr
        rol acc
        rol acc+1
        rol acc+2
        rol acc+3
        inc tmp1
        inw tp
        bra .l
.x      lda tmp1
        bne +
        lda #28
        jmp error
+       rts

!zone strlit
strlit: inw tp
        ldx #0
.l      lda [tp],z
        cmp #CR
        beq .miss
        inw tp
        cmp #'"'
        bne .c
        lda [tp],z
        cmp #'"'
        bne .end
        inw tp
.c      sta ACCS,x
        inx
        bne .l
        lda #19
        jmp error
.end    stx slen
        lda #$80
        sta etype
        rts
.miss   lda #9                  ; Missing "
        jmp error
