; B65 BASIC - statement execution (after BBC BASIC (Z80) v5 EXEC.Z80)
; Altered version of BBC BASIC (Z80) v5 by R.T. Russell (zlib licence) - see LICENSE
; Control structures live on the (16-bit) CPU stack, as in the Z80 original.
; Frame marker byte is at SP+1:
;   FOR     16: TFOR, vptr(2), vtype, limit(5), step(5), looptp(2)
;   REPEAT   3: TREPEAT, tp(2)
;   WHILE    3: TWHILE, tp(2) (-> condition)
;   GOSUB    3: TGOSUB, tp(2)
;   PROC/FN  3: TPROC/TFN, tp(2) (return text pointer)
;   LOCAL    9: TLOCAL, vptr(2), vtype, value(5)
;   LOCAL$ 5+n: TLOCAL, vptr(2), $81, len, bytes...

PARBUF = $1000                  ; 8 slots of $200 bytes: parameter passing

; ---- stack frame helpers ----
; ALLOC: A = bytes; SP -= A; spz := new SP (frame at spz+1..)
!zone alloc
alloc:  sta tmp0
        pla
        sta tmpw
        pla
        sta tmpw+1
        tsx
        stx spz
        tsy
        sty spz+1
        lda spz
        sec
        sbc tmp0
        sta spz
        tax
        lda spz+1
        sbc #0
        sta spz+1
        tay
        +setsp
        lda tmpw+1
        pha
        lda tmpw
        pha
        rts
; DROP: A = bytes; SP += A
drop:   sta tmp0
        pla
        sta tmpw
        pla
        sta tmpw+1
        tsx
        stx spz
        tsy
        sty spz+1
        lda spz
        clc
        adc tmp0
        sta spz
        tax
        lda spz+1
        adc #0
        sta spz+1
        tay
        +setsp
        lda tmpw+1
        pha
        lda tmpw
        pha
        rts
; GETSP: spz := caller's SP (frame marker at (spz),1)
getsp:  tsx
        stx spz
        tsy
        sty spz+1
        lda spz
        clc
        adc #2
        sta spz
        bcc +
        inc spz+1
+       ldy #1
        lda (spz),y
        rts

; ---- RUN / XEQ ----
run:    jsr termq
        beq run0
        jmp chain               ; RUN "file"
run0:   jsr resetsp_jsr
        jsr clear
        lda #0
        sta errtrp
        sta errtrp+1
        sta datptr
        sta datptr+1
        lda page
        sta tp
        lda page+1
        jsr settph
; XEQ0: tp -> start of a program line (length byte)
xeq0:   lda tp                  ; (REM / ELSE / DATA skip to its end)
        sta linst
        lda tp+1
        sta linst+1
        jsr newlin
        jsr nxt
        cmp #TELSE
        bne +
        jmp mlelse
+       cmp #TWHEN
        beq +
        cmp #TOTHERWISE
        bne xeq
+       jmp whenskip
xeq:    lda tp
        sta curlin
        lda tp+1
        sta curlin+1
        lda escflag             ; TRAP only when ESCAPE is pending or the
        bne +                   ; keyboard is not interrupt driven
        bit irqon
        bmi ++
+       jsr trap
++      lda evpend
        beq xeq1
        jsr evcheck
xeq1:   lda [tp],z              ; (NXT inline)
        cmp #' '
        bne +
        jsr nxt
+       inw tp
        cmp #':'
        beq xeq1
        cmp #CR
        beq xeq0
        tax
        sec
        sbc #TCMD
        cmp #NCMD
        bcs .extras
        asl
        tay
        lda cmdjmp,y
        sta tmpw
        lda cmdjmp+1,y
        sta tmpw+1
        lda [tp],z              ; (NXT inline)
        cmp #' '
        bne +
        jsr nxt
+       jmp (tmpw)
.extras txa
        cmp #$80                ; characters: implied LET unless * = [
        bcs .xt
        cmp #$20
        bcc .xt
        cmp #'*'
        beq .xt
        cmp #'='
        beq .xt
        cmp #'['
        beq .xt
        dew tp
        jmp let
.xt     cmp #TLINE
        bne +
        jmp gs_line
+       cmp #TEVERY
        bne +
        jmp every
+       cmp #TAFTER
        bne +
        jmp after
+       cmp #TDI
        bne +
        jmp evdi
+       cmp #TEI
        bne +
        jmp evei
+       cmp #TSPRITE
        bne +
        jmp gs_sprite
+       cmp #TELSE
        bne +
        jmp rem
+       cmp #TERROR
        bne +
        jmp throw
+       cmp #'='
        bne +
        jmp fnret
+       cmp #'*'
        bne +
        jmp star
+       cmp #'['
        bne +
        jsr ovjmp
        !byte 0
        !word assem
+       dew tp                  ; implied LET
        jmp let

; NEWLIN: handle line header at tp
!zone newlin
newlin: ldy #0
        lda [tp],z
        bne +
        ; end of program (or of immediate line)
        lda tp
        cmp page
        lda tp+1
        sbc page+1
        bcs +++
        jmp clopp
+++     jmp warm
+       ldy #1
        +ldtpy
        sta lnum
        iny
        +ldtpy
        sta lnum+1
        lda tp
        clc
        adc #3
        sta tp
        bcc +
        inc tp+1
+       lda tracen
        ora tracen+1
        beq .x
        lda tracen
        cmp lnum
        lda tracen+1
        sbc lnum+1
        bcc .x
        lda #'['
        jsr outchr
        jsr pbcdl
        lda #']'
        jsr outchr
        lda #' '
        jsr outchr
.x      rts

; TERMQ: Z set if at statement terminator (: CR ELSE)
termq:  jsr nxt
        cmp #':'
        beq +
        cmp #CR
        beq +
        cmp #TELSE
+       rts

cmdjmp: !word leftsl, midsl, ritesl, syntax, syntax, syntax, syntax, while ; C0-C7
        !word case, whenskip, syntax, xeq, whenskip, xeq, endwhile, ptrset  ; C8-CF
        !word pagev, timev, noimp, himemv, sound, bput, call, chain         ; D0-D7
        !word clr, close, gs_clg, cls_st, rem, rem, dim, gs_draw            ; D8-DF
        !word end, endproc, envelope, for, gosub, goto, gs_gcol, if         ; E0-E7
        !word input, let, local, gs_mode, gs_move, next, on, vdu            ; E8-EF
        !word gs_plot, print, proc, read, rem, repeat, report_st, restore   ; F0-F7
        !word return, run, stop, gs_colour, trace, until, widthv, noimp     ; F8-FF
        !word rem, gs_circle, gs_ellipse, gs_fill, gs_mouse, gs_origin, quit, gs_rect ; 00-07
        !word swap, noimp, noimp, wait, install, rem, noimp, syntax         ; 08-0F
        !word exit                                                          ; 10 EXIT

syntax: lda #16
        jmp error
mistake:
        lda #4
        jmp error

; ---- simple statements ----
rem:    lda tp+2                ; program text: the line's own length, if
        beq .sc                 ; tp is inside the line XEQ0 entered last
        sta pp+2                ; (a jump back into an earlier line: scan)
        lda tp+3
        sta pp+3
        lda linst
        sta pp
        lda linst+1
        sta pp+1
        lda tp
        cmp pp
        lda tp+1
        sbc pp+1
        bcc .sc
        lda [pp],z              ; length: pp = the CR + 1
        clc
        adc pp
        sta pp
        bcc +
        inc pp+1
+       lda tp
        cmp pp
        lda tp+1
        sbc pp+1
        bcs .sc
        lda pp
        bne +
        dec pp+1
+       dec
        sta tp
        lda pp+1
        sta tp+1
        jmp xeq
.sc     ldz #0                  ; scan for the CR (Z as the index)
-       lda [tp],z
        cmp #CR
        beq +
        inz
        bne -
+       tza
        ldz #0
        clc
        adc tp
        sta tp
        bcc +
        inc tp+1
+       jmp xeq                 ; xeq1 will see CR and go to next line

end:    jmp warm
stop:   jsr tell
        !text CR,LF,"STOP",0
        lda curlin
        sta ptr1
        lda curlin+1
        sta ptr1+1
        jsr setlin
        lda erl
        ldx erl+1
        jsr sayln
        jsr crlf
        jmp warm
quit:   bit testmode
        bpl +
        lda #0
        jmp test_exit
+       jmp cold_test

clr:    jsr clear
        jmp xeq
cls_st: jsr cls
        jmp xeq
report_st:
        jsr report
        jmp xeq
widthv: jsr expri
        lda acc
        bne +
        lda #255
+       sta width
        jmp xeq
trace:  cmp #TOFF
        bne +
        inw tp
        lda #0
        sta tracen
        sta tracen+1
        jmp xeq
+       cmp #TON
        bne +
        inw tp
        lda #$ff
        sta tracen
        sta tracen+1
        jmp xeq
+       jsr expri
        lda acc
        sta tracen
        lda acc+1
        sta tracen+1
        jmp xeq
TOFF = $87

pagev:  jsr eqexpr               ; (bank bits ignored: always bank PBANK)
        lda acc+1
        cmp #>PMIN
        bcs +
        lda #0                  ; below PMIN: No room
        jmp error
+       lda acc
        sta page
        lda acc+1
        sta page+1
        jmp xeq
himemv: jmp noimp
timev:  jsr eqexpr
        sei
        lda acc
        sta tcs
        lda acc+1
        sta tcs+1
        lda acc+2
        sta tcs+2
        lda acc+3
        sta tcs+3
        bit irqon
        bpl +
        cli
+       jmp xeq
eqexpr: jsr nxt
        cmp #'='
        beq +
        jmp mistake
+       inw tp
        jmp expri

wait:   jsr termq
        bne +
-       lda $d011               ; wait for vsync
        bpl -
-       lda $d011
        bmi -
        jmp xeq
+       jsr expri
-       lda acc
        ora acc+1
        beq +
        jsr wait1cs
        lda acc
        bne ++
        dec acc+1
++      dec acc
        bra -
+       jmp xeq

; VDU list: item[;|,]...
!zone vdu
vdu:    jsr termq
        beq .x
        jsr expri
        lda acc
        jsr oswrch
        jsr nxt
        cmp #';'
        bne +
        inw tp
        lda acc+1
        jsr oswrch
        bra vdu
+       cmp #','
        bne +
        inw tp
        bra vdu
+       cmp #'|'
        bne vdu
        inw tp
        ldx #9
-       lda #0
        jsr oswrch
        dex
        bne -
        bra vdu
.x      jmp xeq

; ---- LET ----
!zone let
let:    lda tp+2                ; program text: compiled assignment (xc.a)?
        beq .lint
        lda curovl
        cmp #4
        beq +
        lda #4
        jsr ovmap
+       jsr $e003               ; XCLET: carry clear = done
        bcs .lint
        jmp xeq
.lint   lda [tp],z
        cmp #'?'
        lbeq .ind1
        cmp #'!'
        lbeq .ind4
        cmp #'@'                ; static integer @%, A%..Z% followed by '=': direct
        bcc .nst
        cmp #'Z'+1
        bcs .nst
        tax
        ldz #1
        lda [tp],z
        cmp #'%'
        bne .nst
        inz
        lda [tp],z
        cmp #'='
        bne .nst
        inz
        lda [tp],z
        cmp #'='
        beq .nst
        ldz #0
        txa
        sec
        sbc #'@'
        asl
        asl
        pha
        lda tp
        clc
        adc #3
        sta tp
        bcc +
        inc tp+1
+       jsr expr
        lda etype
        beq +
        lda #6                  ; Type mismatch
        jmp error
+       lda accx
        beq +
        jsr sfix
+       plx
        lda acc
        sta STAVAR,x
        lda acc+1
        sta STAVAR+1,x
        lda acc+2
        sta STAVAR+2,x
        lda acc+3
        sta STAVAR+3,x
        jmp xeq
.nst    ldz #0                  ; whole-array assignment (name followed by "()")?
-       lda [tp],z
        cmp #'('
        beq .arp
        inz
        jsr range0              ; name characters, $ % &
        bcc -
        bra .nar
.arp    inz
        lda [tp],z
        cmp #')'
        bne .nar
        ldz #0
        jsr arrlet
.nar    ldz #0
        jsr getvar
        bcc +
        jmp mistake
+       beq .got
        jsr putvar
.got    lda farflag             ; far target: keep its address
        beq +
        ldx #3
-       lda farad,x
        pha
        dex
        bpl -
+       lda farflag
        pha
        lda vptr
        pha
        lda vptr+1
        pha
        lda vtype
        pha
        jsr nxt
        ldx #$ff                ; no compound op
        cmp #'='
        beq .eq
        ldx #OP_ADD
        cmp #'+'
        beq .cmpd
        ldx #OP_SUB
        cmp #'-'
        beq .cmpd
        ldx #OP_MUL
        cmp #'*'
        beq .cmpd
        ldx #OP_FDIV
        cmp #'/'
        beq .cmpd
        ldx #OP_AND
        cmp #TAND
        beq .cmpd
        ldx #OP_OR
        cmp #TOR
        beq .cmpd
        ldx #OP_EOR
        cmp #TEOR
        beq .cmpd
        ldx #OP_MOD
        cmp #TMOD
        beq .cmpd
        ldx #OP_IDIV
        cmp #TDIV
        beq .cmpd
        jmp mistake
.cmpd   ldy #1
        +ldtpy
        cmp #'='
        beq +
        jmp mistake
+       inw tp
.eq     inw tp
        phx
        jsr expr
        plx
        pla
        sta vtype
        pla
        sta vptr+1
        pla
        sta vptr
        pla
        sta farflag
        beq +
        stx fpopc               ; (scratch) keep the op
        ldx #0                  ; restore the far address (and its data)
-       pla
        sta farad,x
        inx
        cpx #4
        bne -
        jsr farld
        ldx fpopc
+       cpx #$ff
        beq .store
        ; compound: var OP= rhs
        phx
        lda vptr
        pha
        lda vptr+1
        pha
        lda vtype
        pha
        jsr pushval             ; rhs
        jsr loadvar             ; left operand -> acc/ACCS
        jsr movleft             ; -> arg / STRBUF, tmp5 = type
        jsr popacc              ; rhs -> acc
        pla
        sta vtype
        pla
        sta vptr+1
        pla
        sta vptr
        plx
        lda vptr
        pha
        lda vptr+1
        pha
        lda vtype
        pha
        jsr binop
        pla
        sta vtype
        pla
        sta vptr+1
        pla
        sta vptr
.store  jsr storevar
        jmp xeq

; ?addr=expr / !addr=expr: no FARBUF round trip; compound ops (?a+=1) go
; on with the general path from the evaluated address
.ind1   lda #0
        bra .ind
.ind4   lda #4
.ind    pha                     ; vtype
        inw tp
        jsr itemi               ; address -> acc
        jsr nxt
        cmp #'='
        beq .plain
        pla
        sta vtype
        lda acc                 ; as GETVAR does for an indirection
        sta vptr
        lda acc+1
        sta vptr+1
        lda #0
        sta farflag
        lda acc+2
        ora acc+3
        beq +
        ldx #3
-       lda acc,x
        sta farad,x
        dex
        bpl -
        lda #$ff
        sta farflag
        lda #<FARBUF
        sta vptr
        lda #>FARBUF
        sta vptr+1
        jsr farld
+       jmp .got
.plain  inw tp
        ldq acc                 ; keep the address
        pha
        phx
        phy
        phz
        ldz #0
        jsr expr
        lda etype
        beq +
        lda #6                  ; Type mismatch
        jmp error
+       lda accx
        beq +
        jsr sfix
+       plz
        ply
        plx
        pla
        stq fptr
        ldz #0
        plx                     ; vtype: 0 = byte, 4 = word
        lda fptr+2
        ora fptr+3
        bne .farst
        ldy #0                  ; bank 0 (16-bit: I/O visible)
        lda acc
        sta (fptr),y
        cpx #0
        beq +
        iny
        lda acc+1
        sta (fptr),y
        iny
        lda acc+2
        sta (fptr),y
        iny
        lda acc+3
        sta (fptr),y
+       jmp xeq
.farst  lda acc                 ; 28-bit flat address
        sta [fptr],z
        cpx #0
        beq +
        inz
        lda acc+1
        sta [fptr],z
        inz
        lda acc+2
        sta [fptr],z
        inz
        lda acc+3
        sta [fptr],z
        ldz #0
+       jmp xeq

loadvar:
        lda vtype
        bmi +
        jmp loadn
+       jmp loads
storevar:
        lda vtype
        bmi +
        jsr storen
        bra ++
+       jsr stores
++      lda farflag
        beq +
        jmp farst
+       rts

; current value -> left operand (arg/argx or STRBUF/tmp6), tmp5 = type
movleft:
        lda etype
        sta tmp5
        bmi +
        ldq acc
        stq arg
        ldz #0
        lda accx
        sta argx
        rts
+       ldx #0
-       cpx slen
        beq +
        lda ACCS,x
        sta STRBUF,x
        inx
        bra -
+       stx tmp6
        rts

; POPACC: pop a pushval'd value directly into acc / ACCS (arg untouched)
!zone popacc
popacc: pla
        sta rtmp
        pla
        sta rtmp+1
        pla
        sta etype
        bmi .s
        pla
        sta accx
        pla
        sta acc+3
        pla
        sta acc+2
        pla
        sta acc+1
        pla
        sta acc
        bra .r
.s      pla
        sta slen
        ldx #0
-       cpx slen
        beq .r
        pla
        sta ACCS,x
        inx
        bra -
.r      lda rtmp+1
        pha
        lda rtmp
        pha
        rts

; ---- PRINT ----
!zone print
print:  jsr nxt
        cmp #'#'
        lbeq printh
        lda STAVAR              ; field width = @% low byte
        sta tmp3                ; C: field width
        lda #0
        sta prflag              ; B: bit0 no-newline, bit1 hex
.pc     jsr termq
        lbeq .p4
        pha
        lda #1
        trb prflag
        pla
        inw tp
        cmp #'~'
        bne +
        lda #2
        sta prflag
        bra .pc
+       cmp #';'
        bne +
        lda #1
        sta prflag
        lda #0
        sta tmp3
        bra .pc
+       cmp #','
        bne +
        jsr .tabz
        lda STAVAR
        sta tmp3
        lda #0
        sta prflag
        bra .pc
+       jsr format
        beq .pc
        dew tp
        lda tmp3
        pha
        lda prflag
        pha
        jsr expr
        pla
        sta prflag
        pla
        sta tmp3
        lda etype
        bmi .str
        lda prflag
        and #2
        beq +
        jsr numstr
        bra ++
+       lda STAVAR+1
        sta fmtd
        lda STAVAR+2
        sta fmtf
        jsr fmtnum
++      stx tmp0
        lda tmp3
        sec
        sbc tmp0
        bcc +
        beq +
        jsr spaces
+       ldx #0
-       cpx tmp0
        beq .pc
        lda NUMBUF,x
        phx
        jsr outchr
        plx
        inx
        bra -
.str    jsr ptext
        lbra .pc
.p4     lda prflag
        and #1
        bne +
        jsr crlf
+       jmp xeq
.tabz   lda STAVAR              ; tab to next print zone
        beq +
        lda count
        beq +
-       sec
        sbc STAVAR
        beq +
        bcs -
        eor #$ff
        inc
        jmp spaces
+       rts

ptext:  ldx #0
-       cpx slen
        beq +
        lda ACCS,x
        phx
        jsr outchr
        plx
        inx
        bra -
+       rts

; FORMAT: handles TAB( SPC ' ; Z set if one was processed (A = char)
!zone format
format: cmp #TTAB
        beq .tab
        cmp #TSPC
        beq .spc
        cmp #$27                ; '
        beq .nl
        rts
.nl     jsr crlf
        lda #0
        rts
.spc    jsr itemi
        lda acc
        jsr spaces
        lda #0
        rts
.tab    jsr expri
        jsr nxt
        cmp #','
        beq .tabxy
        jsr braket
        lda acc                 ; TAB(x): newline if past
        cmp count
        beq .tx
        bcs +
        jsr crlf
+       lda acc
        sec
        sbc count
        jsr spaces
.tx     lda #0
        rts
.tabxy  inw tp
        lda acc
        pha
        jsr expri
        jsr braket
        lda #31
        jsr oswrch
        pla
        sta count
        jsr oswrch
        lda acc
        jsr oswrch
        lda #0
        rts

; ---- GOTO / GOSUB / RETURN ----
goto:   jsr linetgt
        jsr termq
        beq +
        jmp syntax
+       lda ptr1
        sta tp
        lda ptr1+1
        jsr settph
        jmp xeq0
; ARRREFQ: ARRREF only when the name at tp is followed by "()" (else NZ,
; tp unchanged): saves the name scan of every argument, formal and LOCAL
arrrefq:
        ldz #0
-       lda [tp],z
        cmp #'('
        beq .ap
        inz
        jsr range0
        bcc -
.an     ldz #0
        lda #1
        rts
.ap     inz
        lda [tp],z
        cmp #')'
        bne .an
        ldz #0
        jmp arrref
PFB     = PARBUF+$100       ; formal list (slot 0's RETURN half: retmask is 0 here)
pfok    = $1fe8             ; $FF: formals of this DEF are being recorded
; XCCOMP: overlay 4 asks for a compile: map the compiler (overlay 2), run
; it, map overlay 4 back (A and carry from the compiler)
xccomp: lda #2
        jsr ovmap
        jsr xcomp
        php
        pha
        lda #4
        jsr ovmap
        pla
        plp
        rts
; XC4: call overlay 4 at $E000+X, mapping the caller's overlay back after
; it (FN calls can come from overlay code); carry from the call
xc4:    stx .xj+1
        lda curovl
        pha
        cmp #4
        beq +
        lda #4
        jsr ovmap
+       jsr .xj
        pla
        php
        cmp #4
        beq +
        cmp #$ff
        beq +
        jsr ovmap
+       plp
        rts
.xj     jmp $e000
; LINETGT: ptr1 = the line given at tp (GOTO/GOSUB), tp after it; program
; text asks the compiled-code overlay (cached line addresses) first
linetgt:
        lda tp+2
        beq .lint
        lda curovl
        cmp #4
        beq +
        lda #4
        jsr ovmap
+       jsr $e009               ; XCLINE
        bcc .lr
.lint   jsr itemi
        lda acc
        sta lnum
        lda acc+1
        sta lnum+1
        jsr findl
        beq .lr
        lda #41                 ; No such line
        jmp error
.lr     rts
goto1:  lda acc
        sta lnum
        lda acc+1
        sta lnum+1
        jsr findl
        beq +
        lda #41                 ; No such line
        jmp error
+       lda ptr1
        sta tp
        lda ptr1+1
        jsr settph
        jmp xeq0

gosub:  jsr linetgt
        jsr termq
        beq +
        jmp syntax
+       lda #3
        jsr alloc
        ldy #1
        lda #TGOSUB
        sta (spz),y
        iny
        lda tp
        sta (spz),y
        iny
        lda tp+1
        sta (spz),y
        lda ptr1
        sta tp
        lda ptr1+1
        jsr settph
        jmp xeq0

return: jsr getsp
        cmp #TGOSUB
        beq +
        cmp #TEVT               ; end of an EVERY/AFTER handler
        bne .ng
        lda #0
        sta inevt
        bra +
.ng     lda #38                 ; No GOSUB
        jmp error
+       jsr frametp
        lda #3
        jsr drop
        jmp xeq
frametp:                        ; tp := frame bytes 2,3
        ldy #2
        lda (spz),y
        sta tp
        iny
        lda (spz),y
        jsr settph
        rts

; ---- REPEAT / UNTIL ----
repeat: lda #3
        jsr alloc
        ldy #1
        lda #TREPEAT
        sta (spz),y
        iny
        lda tp
        sta (spz),y
        iny
        lda tp+1
        sta (spz),y
        jmp xeq
until:  jsr getsp
        cmp #TREPEAT
        beq +
        lda #43                 ; Not in a REPEAT loop
        jmp error
+       jsr expri
        jsr acczero
        bne +
        jsr getsp
        jsr frametp
        jmp xeq
+       lda #3
        jsr drop
        jmp xeq
acczero:                        ; Z set if acc == 0
        lda acc
        ora acc+1
        ora acc+2
        ora acc+3
        rts

; ---- WHILE / ENDWHILE ----
while:  lda tp
        pha
        lda tp+1
        pha
        jsr expri
        pla
        sta tmpw2+1
        pla
        sta tmpw2
        jsr acczero
        beq .skip
        lda #3
        jsr alloc
        ldy #1
        lda #TWHILE
        sta (spz),y
        iny
        lda tmpw2
        sta (spz),y
        iny
        lda tmpw2+1
        sta (spz),y
        jmp xeq
.skip   lda #TWHILE
        ldx #TENDWHILE
        jsr skipblk
        jmp xeq
endwhile:
        jsr getsp
        cmp #TWHILE
        beq +
        lda #46
        jmp error
+       lda tp
        sta tmpw2
        lda tp+1
        sta tmpw2+1
        jsr frametp
        lda tmpw2
        pha
        lda tmpw2+1
        pha
        jsr expri
        pla
        sta tmpw2+1
        pla
        sta tmpw2
        jsr acczero
        beq +
        jmp xeq
+       lda #3
        jsr drop
        lda tmpw2
        sta tp
        lda tmpw2+1
        jsr settph
        jmp xeq

; ---- program scanner ----
; SCAN: advance tp over one element. A = token found (0 = other),
; A = CR when a new line was entered (tp after its header),
; carry set at end of program.
!zone scan
scan:   lda [tp],z
        cmp #CR
        beq .cr
        inw tp
        cmp #'"'
        beq .q
        cmp #TREM
        beq .rem
        cmp #TDATA
        beq .rem
        cmp #TLINO
        beq .lino
        cmp #$80
        bcs .tok
        cmp #$20
        bcc .tok
        lda #0
.tok    clc
        rts
.q      lda [tp],z
        cmp #CR
        beq .z
        inw tp
        cmp #'"'
        bne .q
.z      lda #0
        clc
        rts
.rem    lda [tp],z
        cmp #CR
        beq .z
        inw tp
        bra .rem
.lino   lda tp
        clc
        adc #3
        sta tp
        bcc .z
        inc tp+1
        bra .z
.cr     inw tp                  ; -> length byte of next line
        lda tp
        cmp page                ; immediate-mode text: no further lines
        lda tp+1
        sbc page+1
        bcc .end
        ldy #0
        lda [tp],z
        beq .end
        lda tp
        clc
        adc #3
        sta tp
        bcc +
        inc tp+1
+       lda #CR
        clc
        rts
.end    sec
        rts

; SKIPBLK: A = opening token, X = closing token: skip to after the
; matching closing token (nesting counted).
!zone skipblk
skipblk:
        sta tmp4
        stx tmp5
        lda #0
        sta tmp6
.l      jsr scan
        bcs .miss
        cmp tmp4
        bne +
        inc tmp6
        bra .l
+       cmp tmp5
        bne .l
        lda tmp6
        beq .x
        dec tmp6
        bra .l
.x      rts
.miss   lda tmp5
        cmp #TENDWHILE
        bne +
        jsr tell                ; no specific error number upstream; use Missing ENDWHILE text
        !text 0
        lda #46
        jmp error
+       lda #49                 ; Missing ENDIF
        jmp error

; ---- IF ----
!zone if
; THENEOL: tp after THEN: skip spaces and an optional ';' (v5 "ELSE IF c THEN;")
; Z set if the line ends there (multi-line IF)
theneol:
        jsr nxt
        cmp #';'
        bne +
        inw tp
        jsr nxt
+       cmp #CR
        rts
; MLSCAN: skip a multi-line IF block. A = 0: stop at ELSE (line start) or
; ENDIF of this level; A = 1: stop only at ENDIF. "ELSE IF ... THEN" lines
; continue the chain and do not open a new level.
mlscan: sta tmp5
        lda #0
        sta tmp6                ; depth
.ml     jsr scan
        bcs .miss
        cmp #CR
        bne .mc
        lda #0
        sta elseln
        jsr nxt
        cmp #TELSE
        bne .ml
        lda #1
        sta elseln
        lda tmp6
        ora tmp5
        bne .ml
        inw tp                  ; ELSE at this level: run what follows it
        rts
.mc     cmp #TTHEN
        bne +
        jsr theneol
        bne .ml
        lda elseln              ; ELSE IF ... THEN: same chain
        bne .ml
        inc tmp6
        bra .ml
+       cmp #TENDIF
        bne .ml
        lda tmp6
        beq +
        dec tmp6
        bra .ml
+       rts
.miss   lda #49
        jmp error

if:     lda tp+2                ; program text: compiled IF (xc.a)?
        beq .iint
        lda curovl
        cmp #4
        beq +
        lda #4
        jsr ovmap
+       jsr $e006               ; XCIF
        bcs .iint
        cmp #1
        lbeq .felse             ; false, tp after ELSE
        jmp xeq                 ; true (tp after THEN) or false at the CR
.iint   jsr expri
        jsr nxt
        cmp #TTHEN
        bne .nothen
        inw tp
        jsr theneol
        beq .multi
.nothen jsr acczero
        beq .false
        jsr nxt
        cmp #TLINO
        bne +
        inw tp
        jsr f_decode
        jmp goto1
+       jmp xeq
.false  ; single line: look for ELSE on this line (Z = offset from tp)
-       lda [tp],z
        cmp #CR
        beq .fcr
        cmp #TELSE
        beq .fel
        inz
        cmp #'"'
        beq .fq
        cmp #TLINO
        beq .fln
        cmp #TREM
        beq .frem
        cmp #TDATA
        bne -
.frem   lda [tp],z              ; REM/DATA: no ELSE after it
        cmp #CR
        beq .fcr
        inz
        bra .frem
.fq     lda [tp],z              ; string
        cmp #CR
        beq .fcr
        inz
        cmp #'"'
        bne .fq
        bra -
.fln    inz                     ; line number: 3 more bytes
        inz
        inz
        bra -
.fcr    tza                     ; tp -> CR: XEQ goes on with the next line
        ldz #0
        clc
        adc tp
        sta tp
        bcc +
        inc tp+1
+       jmp xeq
.fel    inz                     ; tp -> after ELSE
        tza
        ldz #0
        clc
        adc tp
        sta tp
        bcc +
        inc tp+1
+
.felse  jsr nxt
        cmp #TLINO
        bne +
        inw tp
        jsr f_decode
        jmp goto1
+       jmp xeq
.multi  jsr acczero
        bne .mtrue
        lda #0                  ; false: to ELSE (maybe ELSE IF) or ENDIF
        sta elseln
        jsr mlscan
.mtrue  jmp xeq

!zone mlelse
; ELSE at start of a line reached in normal flow: skip to the matching ENDIF
mlelse: lda #1
        sta elseln
        jsr mlscan
        jmp xeq

; STKFRM: allocate a DIM LOCAL frame of tmpw2 bytes (incl. the 3-byte header)
; on the caller's stack; spz -> frame. Called from DIM (statement level).
stkfrm: pla
        sta rtmp
        pla
        sta rtmp+1
        tsx                     ; room check: SP - len > FREE + 256
        stx spz
        tsy
        sty spz+1
        lda spz
        sec
        sbc tmpw2
        sta spz
        tax
        lda spz+1
        sbc tmpw2+1
        sta spz+1
        tay
        lda free+1
        clc
        adc #1
        cmp spz+1
        bcc +
        lda #11                 ; DIM space
        jmp error
+       +setsp
        ldy #1
        lda #TDIM
        sta (spz),y
        iny
        lda tmpw2
        sta (spz),y
        iny
        lda tmpw2+1
        sta (spz),y
        lda rtmp+1
        pha
        lda rtmp
        pha
        rts

f_decode:                       ; TLINO function: tp after token
        jsr decode0
        lda lnum
        ldx lnum+1
        jmp setw

; ---- FOR / NEXT ----
!zone for
for:    jsr getvar
        bcc +
        jmp syntax
+       beq +
        jsr putvar
+       lda farflag             ; (far array elements cannot be FOR variables)
        bne .bfv
        lda vtype
        bpl +
.bfv    lda #34                 ; Bad FOR variable
        jmp error
+       lda vptr
        pha
        lda vptr+1
        pha
        lda vtype
        pha
        jsr nxt
        cmp #'='
        beq +
        jmp mistake
+       inw tp
        jsr exprn
        pla
        sta vtype
        pla
        sta vptr+1
        pla
        sta vptr
        jsr storen
        jsr nxt
        cmp #TTO
        beq +
        lda #36                 ; Missing TO
        jmp error
+       inw tp
        lda #16
        jsr alloc
        ldy #1
        lda #TFOR
        sta (spz),y
        iny
        lda vptr
        sta (spz),y
        iny
        lda vptr+1
        sta (spz),y
        iny
        lda vtype
        sta (spz),y
        jsr exprn               ; limit
        jsr getsp0
        ldy #5
        jsr putacc
        lda #1                  ; default STEP 1
        jsr setint8
        jsr nxt
        cmp #TSTEP
        bne +
        inw tp
        jsr exprn
+       jsr getsp0
        ldy #10
        jsr putacc
        ldy #15
        lda tp
        sta (spz),y
        iny
        lda tp+1
        sta (spz),y
        jmp xeq

getsp0: tsx                     ; spz = caller SP (no marker load)
        stx spz
        tsy
        sty spz+1
        lda spz
        clc
        adc #2
        sta spz
        bcc +
        inc spz+1
+       rts
putacc: ldx #0                  ; acc,accx -> (spz),y..y+4
-       lda acc,x
        sta (spz),y
        iny
        inx
        cpx #5
        bne -
        rts
getarg: ldx #0                  ; (spz),y.. -> arg,argx
-       lda (spz),y
        sta arg,x
        iny
        inx
        cpx #5
        bne -
        rts

!zone next
next:   jsr getsp
        cmp #TFOR
        beq +
        lda #32                 ; Not in a FOR loop
        jmp error
+       jsr termq
        beq .go2                ; (spz is still the frame from GETSP)
        lda [tp],z
        cmp #','
        beq .go
        jsr getvar              ; NEXT var: must match frame
        bcs .cm
        bne .cm
.chk    jsr getsp0
        ldy #1
        lda (spz),y
        cmp #TFOR
        bne .cm
        ldy #2
        lda (spz),y
        cmp vptr
        bne .pop
        iny
        lda (spz),y
        cmp vptr+1
        beq .go
.pop    lda #16                 ; drop inner loop and try the next
        jsr drop
        bra .chk
.cm     lda #33                 ; Can't match FOR
        jmp error
.go     jsr getsp0
.go2    ldy #2
        lda (spz),y
        sta vptr
        iny
        lda (spz),y
        sta vptr+1
        iny
        lda (spz),y
        sta vtype
        ; fast path: integer variable, integer limit and step
        cmp #4
        lbne .slow
        ldy #9
        lda (spz),y
        ldy #14
        ora (spz),y
        lbne .slow
        ldy #0                  ; acc = var + step (Y: var, Z: frame)
        ldz #10
        clc
        lda (vptr),y
        adc (spz),z
        sta acc+0
        iny
        inz
        lda (vptr),y
        adc (spz),z
        sta acc+1
        iny
        inz
        lda (vptr),y
        adc (spz),z
        sta acc+2
        iny
        inz
        lda (vptr),y
        adc (spz),z
        sta acc+3
        ldz #0
        bvs .slow               ; overflow: the general path decides
        sta (vptr),y            ; (Y = 3, A = acc+3)
        dey
        lda acc+2
        sta (vptr),y
        dey
        lda acc+1
        sta (vptr),y
        dey
        lda acc
        sta (vptr),y
        ldy #13                 ; step sign
        lda (spz),y
        bmi .fneg
        ldy #5                  ; past the limit if limit - var < 0
        sec
        lda (spz),y
        sbc acc+0
        iny
        lda (spz),y
        sbc acc+1
        iny
        lda (spz),y
        sbc acc+2
        iny
        lda (spz),y
        sbc acc+3
        bra .fcmp
.fneg   ldy #5                  ; past the limit if var - limit < 0
        sec
        lda acc+0
        sbc (spz),y
        iny
        lda acc+1
        sbc (spz),y
        iny
        lda acc+2
        sbc (spz),y
        iny
        lda acc+3
        sbc (spz),y
.fcmp   bvc +
        eor #$80
+       tax
        bmi .done
        ldy #15                 ; continue loop (same text bank as the FOR)
        lda (spz),y
        sta tp
        iny
        lda (spz),y
        sta tp+1
        jmp xeq
.slow   jsr loadn               ; var -> acc
        ldy #10
        jsr getarg              ; step -> arg
        lda arg+3
        sta hexflg              ; sign of step
        lda #0
        sta tmp5
        sta etype
        ldx #OP_ADD
        jsr binop               ; acc = var + step (int, or float)
        jsr storen
        ; compare new value with the limit
        ldx #4
-       lda acc,x
        sta arg,x
        dex
        bpl -
        jsr getsp0
        ldy #5
        ldx #0
-       lda (spz),y
        sta acc,x
        iny
        inx
        cpx #5
        bne -
        lda #0
        sta tmp5
        sta etype
        ldx #OP_GT
        bit hexflg
        bpl +
        ldx #OP_LT
+       jsr binop               ; TRUE if past the limit
        jsr acczero
        bne .done
        jsr getsp0              ; continue loop
        ldy #15
        lda (spz),y
        sta tp
        iny
        lda (spz),y
        jsr settph
        jmp xeq
.done   lda #16
        jsr drop
        jsr nxt
        cmp #','
        bne +
        inw tp
        jmp next
+       jmp xeq
swapaa: ldq saveacc             ; arg := var (saved), acc := limit (in arg)
        stq tmpw                ; (tmpw/tmpw2 = 4 bytes scratch)
        ldq arg
        stq acc
        ldq tmpw
        stq arg
        ldz #0
        lda #0
        sta accx
        sta argx
        rts

; ---- DIM (overlay 0; ends with XEQ or an error; DIM LOCAL allocates on
; the stack itself, the OVJMP stub leaves nothing there) ----
dim:    jsr ovjmp
        !byte 0
        !word o_dim

; ---- PROC / FN / LOCAL / ENDPROC / = ----
; procname: scan name after PROC/FN token into NBUF/nlen (alnum only)
!zone procname
procname:
        ldx #0
-       lda [tp],z
        jsr range1
        bcs +
        sta NBUF,x
        inx
        inw tp
        cpx #38
        bcc -
+       cmp #'$'                ; a type suffix belongs to the name (FNs$)
        beq +
        cmp #'%'
        beq +
        cmp #'&'
        bne ++
+       sta NBUF,x
        inx
        inw tp
++      stx nlen
        rts

; FINDDEF: A = TPROC/TFN. Find DEF, return ptr1 -> text after name
!zone finddef
; LIBNEXT: ptr1 = program text of the next installed library; carry set if none
libnext:
        lda libcur+1
        bne .adv
        lda libase
        sta libcur
        lda libase+1
        sta libcur+1
        bra .chk
.adv    lda libcur
        sta ptr1
        lda libcur+1
        sta ptr1+1
        ldy #0
        jsr lp1y
        clc
        adc #13
        php
        clc
        adc libcur
        sta libcur
        iny
        jsr lp1y
        adc libcur+1
        plp
        adc #0
        sta libcur+1
.chk    lda libcur
        cmp #<PLIM
        lda libcur+1
        sbc #>PLIM
        bcs .none
        lda libcur
        clc
        adc #13
        sta ptr1
        lda libcur+1
        adc #0
        sta ptr1+1
        clc
        rts
.none   sec
        rts
finddef:
        sta tmp4
        lda #0
        sta libcur+1            ; (scanning the program, not a library)
        lda tmp4
        ldx #<PROPTR
        cmp #TPROC
        beq +
        ldx #<FNPTR
+       stx ptr3
        lda #>PROPTR
        sta ptr3+1
        jsr locate_list
        bne .scan
        ldy #0                  ; found: value = DEF text pointer
        lda (vptr),y
        sta ptr1
        iny
        lda (vptr),y
        sta ptr1+1
        rts
.scan   ; ptr3 = last link of list; scan program for DEF <tok><name>
        lda ptr3
        pha
        lda ptr3+1
        pha
        lda page
        sta ptr1
        lda page+1
        sta ptr1+1
.ln     ldy #0
        jsr lp1y
        bne +
        jsr libnext             ; end of program: next library
        bcc .ln
        pla
        pla
        lda #29                 ; No such FN/PROC
        jmp error
+       ldy #3
-       jsr lp1y
        cmp #' '
        bne +
        iny
        bra -
+       cmp #TDEF
        lbne .nx
        iny
-       jsr lp1y
        cmp #' '
        bne +
        iny
        bra -
+       cmp tmp4
        bne .nx
        iny
        ldx #0
-       cpx nlen
        beq .end
        jsr lp1y
        cmp NBUF,x
        bne .nx
        iny
        inx
        bra -
.end    jsr lp1y            ; name must end here (no suffix left either)
        jsr range0
        bcs +
        cmp #'('
        bne .nx
+
        tya                     ; found: ptr1 += y
        clc
        adc ptr1
        sta tmpw2
        lda ptr1+1
        adc #0
        sta tmpw2+1
        pla
        sta ptr3+1
        pla
        sta ptr3
        ; create list entry: name, value = text pointer
        lda free
        ldy #0
        sta (ptr3),y
        lda free+1
        iny
        sta (ptr3),y
        lda free
        sta ptr1
        lda free+1
        sta ptr1+1
        lda #0
        tay
        sta (ptr1),y
        iny
        sta (ptr1),y
        ldx #0
-       cpx nlen
        beq +
        lda NBUF,x
        iny
        sta (ptr1),y
        inx
        bra -
+       lda #0
        iny
        sta (ptr1),y
        iny
        lda tmpw2
        sta (ptr1),y
        iny
        lda tmpw2+1
        sta (ptr1),y
        iny
        tya
        clc
        adc free
        sta free
        bcc +
        inc free+1
+       jsr check
        lda tmpw2
        sta ptr1
        lda tmpw2+1
        sta ptr1+1
        rts
.nx     ldy #0
        jsr lp1y
        clc
        adc ptr1
        sta ptr1
        bcc +
        inc ptr1+1
+       jmp .ln

; CALLSETUP: A = TPROC/TFN; tp after token. Evaluates arguments, pushes
; frame (marker A, return tp), binds parameters, leaves tp in DEF body.
; Must be JMPed to with the frame destination being the current stack top.
!zone callsetup
proc:   lda #TPROC
        bra +
fn_call:
        lda #TFN
+       sta fnlev
        lda tp+2                ; program text: the DEF of this call site
        beq .nc                 ; may be cached (overlay 4)
        ldx #$0c
        jsr xc4
        bcc callset2
        lda tp
        sta defkey
        lda tp+1
        sta defkey+1
        jsr procname
        lda fnlev
        jsr finddef
        jsr retscan             ; retmask: formals declared RETURN
        ldx #$0f
        jsr xc4
        bra callset2
.nc     jsr procname
        lda fnlev
        jsr finddef
callset:
        jsr retscan             ; retmask: formals declared RETURN
callset2:
        lda retmask
        pha
        lda fnlev
        pha
        lda ptr1                ; DEF text pointer
        pha
        lda ptr1+1
        pha
        lda #0
        sta cnt
        lda [tp],z
        cmp #'('
        lbne .noargs
        lda retmask             ; plain numeric arguments: straight into
        bne .sl                 ; PARBUF by overlay 4 (XCARGS)
        lda tp+2
        beq .sl
        ldx #$18
        jsr xc4
        lbcc .p2
.sl     inw tp
.a1     lda cnt
        cmp #6                  ; at most 6 parameters (PARBUF slots 0-5)
        bcc +
        jmp .badarg
+       pha
        jsr nxt
        jsr arrrefq             ; whole array argument: name()
        bne .ae
        lda ptr2
        sta acc
        lda ptr2+1
        sta acc+1
        lda #0
        sta acc+2
        sta acc+3
        sta accx
        lda #$40
        sta etype
        bra .ad
.ae     pla                     ; RETURN parameter?
        pha
        tax
        lda bitmask6,x
        and retmask
        beq .ae2
        lda retmask             ; (nested calls may change retmask)
        pha
        jsr getvar              ; actual must be a variable
        bcc +
        jmp syntax
+       beq +
        jsr putvar
+       pla
        sta retmask
        lda farflag             ; (far array element: farad must be kept)
        sta rfar
        ldx #3
-       lda farad,x
        sta rfad,x
        dex
        bpl -
        lda vptr
        sta rtmp2
        lda vptr+1
        sta rtmp2+1
        lda vtype
        pha
        jsr loadvar             ; current value goes in
        pla
        sta tmp3
        pla
        sta cnt
        jsr pushval_keep
        ldx #3                  ; then the variable's far address (0: near)
-       lda rfad,x
        bit rfar
        bmi +
        lda #0
+       pha
        dex
        bpl -
        lda rtmp2               ; and its address (3 bytes)
        pha
        lda rtmp2+1
        pha
        lda tmp3
        pha
        bra .ad2
.ae2    lda retmask
        pha
        jsr expr
        pla
        sta retmask
.ad     pla
        sta cnt
        jsr pushval_keep        ; value stays on stack under the counters
.ad2    inc cnt
        jsr nxt
        cmp #','
        bne +
        inw tp
        lbra .a1
+       jsr braket
.noargs ; pop args into PARBUF slots (last arg first)
        ldx cnt
        stx tmp2
.p1     ldx tmp2
        lbeq .p2
        dex
        stx tmp2
        txa
        asl
        clc
        adc #>PARBUF
        sta ptr2+1
        lda #0
        sta ptr2
        ldx tmp2                ; RETURN slot: variable address on top
        lda bitmask6,x
        and retmask
        beq +
        ldy #1
        pla
        sta (ptr2),y            ; slot+256: actual vtype, vptr hi, vptr lo
        inc ptr2+1
        ldy #0
        sta (ptr2),y
        pla
        iny
        sta (ptr2),y
        pla
        iny
        sta (ptr2),y
        ldx #4                  ; slot+259..262: far address
-       pla
        iny
        sta (ptr2),y
        dex
        bne -
        dec ptr2+1
+       pla                     ; type (PUSHVAL: acc..accx, then the type)
        bmi .pstr
        ldy #0                  ; a number: straight into the slot
        sta (ptr2),y
        ldy #5
-       pla
        sta (ptr2),y
        dey
        bne -
        bra .p1
.pstr   pha
        jsr popval              ; -> STRBUF/tmp6 ; tmp5 = type
        ldy #0
        lda tmp5
        sta (ptr2),y
.ps     lda tmp6
        iny
        sta (ptr2),y
        ldx #0
-       cpx tmp6
        beq .p1
        lda STRBUF,x
        iny
        sta (ptr2),y
        inx
        bra -
.p2     pla
        sta ptr1+1
        pla
        sta ptr1
        pla
        sta fnlev
        pla
        sta retmask
        ; push call frame
        lda #3
        jsr alloc
        ldy #1
        lda fnlev
        sta (spz),y
        iny
        lda tp
        sta (spz),y
        iny
        lda tp+1
        sta (spz),y
        lda ptr1
        sta tp
        lda ptr1+1
        jsr settph
        ; bind formal parameters: numeric formals known from an earlier
        ; call (overlay 4, kind 5: PFB) are bound without parsing them
        lda #0
        sta tmp2                ; slot index
        sta pfok
        lda tp+2
        beq .bp
        lda retmask
        bne .bp
        lda tp
        sta defkey
        lda tp+1
        sta defkey+1
        ldx #$12                ; XCFORM: PFB
        jsr xc4
        lbcc .fast
        lda #$ff                ; record them this time
        sta pfok
.bp     jsr nxt
        cmp #'('
        lbne .nof
        inw tp
.b1     lda tmp2
        cmp cnt
        lbcs .badarg
        jsr nxt
        cmp #TRETURN            ; RETURN formal: value comes back at exit
        bne +
        inw tp
        jsr nxt
+       jsr arrrefq             ; formal array parameter name()
        bne .fv
        lda #0                  ; (array formals: not recorded)
        sta pfok
        lda #2
        sta vtype
        jsr savelocal
        bra .fl
.fv     jsr getvar
        bcc +
        jmp syntax
+       beq +
        jsr putvar
+       jsr pfrec
        jsr savelocal
.fl     lda tmp2
        asl
        clc
        adc #>PARBUF
        sta ptr2+1
        lda #0
        sta ptr2
        ldy #0
        lda (ptr2),y
        sta etype
        bmi .bs
        ldx #0
-       iny
        lda (ptr2),y
        sta acc,x
        inx
        cpx #5
        bne -
        bra .bst
.bs     iny
        lda (ptr2),y
        sta slen
        ldx #0
-       cpx slen
        beq .bst
        iny
        lda (ptr2),y
        sta ACCS,x
        inx
        bra -
.bst    lda vtype
        cmp #2
        bne +
        lda etype               ; array reference -> pointer field
        cmp #$40
        lbne .badarg2
        lda #0
        sta etype
+       jsr storevar
        ldx tmp2                ; RETURN formal: push a copy-back frame
        lda bitmask6,x
        and retmask
        beq .nr
        lda #11
        jsr alloc
        lda vtype
        ldy #4
        sta (spz),y             ; formal vtype
        lda vptr+1
        dey
        sta (spz),y
        lda vptr
        dey
        sta (spz),y             ; formal vptr
        lda tmp2
        asl
        clc
        adc #(>PARBUF)+1
        sta ptr2+1
        lda #0
        sta ptr2
        ldy #0
        lda (ptr2),y            ; actual vtype
        ldy #7
        sta (spz),y
        ldy #1
        lda (ptr2),y            ; actual vptr hi
        ldy #6
        sta (spz),y
        ldy #2
        lda (ptr2),y
        ldy #5
        sta (spz),y
        ldx #4                  ; far address of the actual (slot+259..262)
-       ldy rfidx,x
        lda (ptr2),y
        pha
        txa
        clc
        adc #7
        tay
        pla
        sta (spz),y             ; frame +8..+11
        dex
        bne -
        ldy #1
        lda #TRETURN
        sta (spz),y
.nr     inc tmp2
        jsr nxt
        cmp #','
        bne +
        inw tp
        lbra .b1
+       jsr braket
        lda tmp2
        cmp cnt
        lbne .badarg
        bit pfok                ; all numeric: remember the formals
        bpl +
        lda cnt
        sta PFB
        lda tp
        sta PFB+1
        lda tp+1
        sta PFB+2
        ldx #$15                ; XCFORMPUT
        jsr xc4
+       jmp xeq
.nof    lda cnt
        lbne .badarg
        jmp xeq
; fast binding: PFB = count, text after the formals, (vptr, vtype) each
.fast   lda PFB
        cmp cnt
        lbne .badarg
.fb     lda tmp2
        cmp cnt
        bcs .fd
        asl                     ; vptr, vtype of formal tmp2
        adc tmp2
        tax
        lda PFB+3,x
        sta vptr
        lda PFB+4,x
        sta vptr+1
        lda PFB+5,x
        sta vtype
        jsr savelocal
        lda tmp2                ; its value from the PARBUF slot
        asl
        clc
        adc #>PARBUF
        sta ptr2+1
        lda #0
        sta ptr2
        ldy #0
        lda (ptr2),y
        sta etype
        bne .fg
        ldy #5                  ; integer value into an integer formal: copy
        lda (ptr2),y
        bne .fg
        lda vtype
        cmp #4
        bne .fg
        ldy #0
        ldz #0
-       iny
        lda (ptr2),y
        sta (vptr),z
        inz
        cpz #4
        bne -
        ldz #0
        bra .fn
.fg     ldy #0
        ldx #0
-       iny
        lda (ptr2),y
        sta acc,x
        inx
        cpx #5
        bne -
        jsr storen              ; (a string argument: Type mismatch)
.fn     inc tmp2
        bra .fb
.fd     lda PFB+1
        sta tp
        lda PFB+2
        jsr settph
        jmp xeq
; PFREC: note formal tmp2 (vptr, vtype) in PFB while binding (numeric only)
pfrec:  bit pfok
        bpl .px
        lda vtype
        cmp #4
        beq +
        cmp #5
        bne .pn
+       lda tmp2
        asl
        adc tmp2
        tax
        lda vptr
        sta PFB+3,x
        lda vptr+1
        sta PFB+4,x
        lda vtype
        sta PFB+5,x
        lda farflag
        beq .px
.pn     lda #0
        sta pfok
.px     rts
.badarg2
.badarg lda #31                 ; Bad arguments
        jmp error

bitmask6: !byte 1,2,4,8,16,32
rfidx:  !byte 0,3,4,5,6         ; (x=1..4: slot+259..262 -> frame +8..+11)
; RETSCAN: ptr1 -> DEF text after the name; retmask bit n = formal n is RETURN
!zone retscan
retscan:
        lda #0
        sta retmask
        ldy #0
        jsr lp1y
        cmp #'('
        bne .x
        ldx #0                  ; formal index
.f      iny
        jsr lp1y
        cmp #' '
        beq .f
        cmp #TRETURN
        bne .skip
        lda bitmask6,x
        tsb retmask
.skip   jsr lp1y            ; to ',' or ')'
        cmp #','
        beq .n
        cmp #')'
        beq .x
        cmp #CR
        beq .x
        iny
        bra .skip
.n      inx
        cpx #6
        bcc .f
.x      rts

; pushval variant used inside callset (keeps cnt etc. on top: they are
; pulled before the call, so plain pushval is fine)
pushval_keep = pushval

; SAVELOCAL: push LOCAL frame saving variable vptr/vtype, keep vptr/vtype
!zone savelocal
savelocal:
        pla                     ; our return address
        sta tmpw2
        pla
        sta tmpw2+1
        lda vtype
        bmi .str
        cmp #4                  ; integer / variant: copy the bytes
        beq .q
        cmp #5
        bne .gn
.q      tsx                     ; ALLOC 9 inline (our return address is off)
        txa
        sec
        sbc #9
        sta spz
        tax
        tsy
        tya
        sbc #0
        sta spz+1
        tay
        +setsp
        ldy #5
        ldz #0
-       lda (vptr),z
        sta (spz),y
        iny
        inz
        cpz vtype
        bne -
        ldz #0
        cpy #10                 ; (integer: exponent byte 0, as LOADN)
        beq .hdr
        lda #0
        sta (spz),y
        bra .hdr
.gn     jsr loadn
        lda #9
        jsr alloc
        ldy #5
        jsr putacc
        bra .hdr
.str    jsr loads
        lda slen
        clc
        adc #5
        jsr alloc
        ldy #5
        lda slen
        sta (spz),y
        ldx #0
-       cpx slen
        beq .hdr
        lda ACCS,x
        iny
        sta (spz),y
        inx
        bra -
.hdr    ldy #1
        lda #TLOCAL
        sta (spz),y
        iny
        lda vptr
        sta (spz),y
        iny
        lda vptr+1
        sta (spz),y
        iny
        lda vtype
        sta (spz),y
        lda tmpw2+1
        pha
        lda tmpw2
        pha
        rts

; LOCAL var[,var...]
!zone local
local:  cmp #TDATA
        bne +
        inw tp
        lda #<datptr
        sta vptr
        lda #0
        sta vptr+1
        lda #4
        sta vtype
        jsr savelocal
        jmp xeq
+       jsr arrrefq             ; LOCAL a()
        bne .nv
        lda #2
        sta vtype
        jsr savelocal
        lda #0
        tay
        sta (vptr),y
        iny
        sta (vptr),y
        bra .nx
.nv     jsr getvar
        bcc +
        jmp syntax
+       beq +
        jsr putvar
+       jsr savelocal
        lda #0                  ; set to 0 / ""
        sta acc
        sta acc+1
        sta acc+2
        sta acc+3
        sta accx
        sta slen
        lda vtype
        and #$80
        sta etype
        jsr storevar
.nx     jsr nxt
        cmp #','
        bne +
        inw tp
        jsr nxt
        bra local
+       jmp xeq

; UNWIND: restore LOCAL frames on stack top (JSR from statement level)
!zone unwind
unwind: pla
        sta tmpw2
        pla
        sta tmpw2+1
.l      tsx
        stx spz
        tsy
        sty spz+1
        ldy #1
        lda (spz),y
        cmp #TLOCAL             ; (the usual frame first)
        lbeq .loc
        cmp #TRETURN            ; RETURN parameter: copy formal -> actual
        bne .nret
        ldy #2
        lda (spz),y
        sta vptr
        iny
        lda (spz),y
        sta vptr+1
        iny
        lda (spz),y
        sta vtype
        lda tmpw2
        pha
        lda tmpw2+1
        pha
        jsr loadvar
        jsr tspz
        ldy #5
        lda (spz),y
        sta vptr
        iny
        lda (spz),y
        sta vptr+1
        iny
        lda (spz),y
        sta vtype
        lda #0
        sta farflag
        ldy #8                  ; far actual (array element in attic RAM)?
        lda (spz),y
        ldy #11
        ora (spz),y
        beq +
        ldx #0
        ldy #8
-       lda (spz),y
        sta farad,x
        iny
        inx
        cpx #4
        bne -
        lda #$ff
        sta farflag
        lda #<FARBUF
        sta vptr
        lda #>FARBUF
        sta vptr+1
        jsr pushval             ; (farld must not lose the value)
        jsr farld
        jsr popacc
+       jsr storevar
        pla
        sta tmpw2+1
        pla
        sta tmpw2
        tsx                     ; drop the 11-byte frame
        txa
        clc
        adc #11
        tax
        tsy
        bcc +
        iny
+       +setsp
        lbra .l
.nret   cmp #TDIM               ; DIM LOCAL block: just drop it
        bne .nloc
        ldy #2
        lda (spz),y
        clc
        adc spz
        tax
        iny
        lda (spz),y
        adc spz+1
        tay
        +setsp
        jmp .l
.nloc   cmp #TLOCAL
        lbne .x
.loc    iny
        lda (spz),y
        sta vptr
        iny
        lda (spz),y
        sta vptr+1
        iny
        lda (spz),y
        sta vtype
        bmi .s
        cmp #4                  ; integer / variant: the bytes back
        beq .qi
        cmp #5
        bne .gn
.qi     ldy #5
        ldz #0
        lda (spz),y
        sta (vptr),z
        iny
        inz
        lda (spz),y
        sta (vptr),z
        iny
        inz
        lda (spz),y
        sta (vptr),z
        iny
        inz
        lda (spz),y
        sta (vptr),z
        lda vtype
        cmp #5
        bne +
        iny
        inz
        lda (spz),y
        sta (vptr),z
+       ldz #0
        bra .dr
.gn     lda #0
        sta etype
        ldy #5
        ldx #0
-       lda (spz),y
        sta acc,x
        iny
        inx
        cpx #5
        bne -
        lda tmpw2
        pha
        lda tmpw2+1
        pha
        jsr storen
        pla
        sta tmpw2+1
        pla
        sta tmpw2
.dr     tsx
        txa
        clc
        adc #9
        tax
        tsy
        bcc +
        iny
+       +setsp
        lbra .l
.s      lda #$80
        sta etype
        ldy #5
        lda (spz),y
        sta slen
        ldx #0
-       cpx slen
        beq +
        iny
        lda (spz),y
        sta ACCS,x
        inx
        bra -
+       lda tmpw2
        pha
        lda tmpw2+1
        pha
        jsr stores
        pla
        sta tmpw2+1
        pla
        sta tmpw2
        lda slen
        clc
        adc #5
        sta tmp0
        tsx
        stx spz
        tsy
        sty spz+1
        lda spz
        clc
        adc tmp0
        tax
        lda spz+1
        adc #0
        tay
        +setsp
        jmp .l
.x      lda tmpw2+1
        pha
        lda tmpw2
        pha
        rts

; TSPZ: spz = stack top below our return address and 2 pushed bytes
tspz:   tsx
        stx spz
        tsy
        sty spz+1
        lda spz
        clc
        adc #4
        sta spz
        bcc +
        inc spz+1
+       rts

!zone endproc
endproc:
        jsr unwind
        jsr getsp
        cmp #TPROC
        beq +
        lda #13                 ; Not in a PROC
        jmp error
+       jsr frametp
        lda #3
        jsr drop
        jmp xeq

!zone fnret
; "=" : return from FN
fnret:  jsr expr
        ; park result in PARBUF slot 7 while locals are restored
        lda #>(PARBUF+$e00)
        sta ptr2+1
        lda #0
        sta ptr2
        ldy #0
        lda etype
        sta (ptr2),y
        bmi .s
        ldx #0
-       lda acc,x
        iny
        sta (ptr2),y
        inx
        cpx #5
        bne -
        bra .u
.s      lda slen
        iny
        sta (ptr2),y
        ldx #0
-       cpx slen
        beq .u
        lda ACCS,x
        iny
        sta (ptr2),y
        inx
        bra -
.u      jsr unwind
        jsr getsp
        cmp #TFN
        beq +
        lda #7                  ; Not in a FN
        jmp error
+       jsr frametp
        lda #3
        jsr drop
        lda #>(PARBUF+$e00)
        sta ptr2+1
        lda #0
        sta ptr2
        ldy #0
        lda (ptr2),y
        sta etype
        bmi .rs
        ldx #0
-       iny
        lda (ptr2),y
        sta acc,x
        inx
        cpx #5
        bne -
        rts                     ; back into the expression that called FN
.rs     iny
        lda (ptr2),y
        sta slen
        ldx #0
-       cpx slen
        beq +
        iny
        lda (ptr2),y
        sta ACCS,x
        inx
        bra -
+       rts

; ---- ERROR n,"text" ----
throw:  jsr expri
        lda acc
        pha
        jsr comma
        jsr exprs
        ldx slen
        lda #0
        sta ACCS,x
        ldx #0                  ; copy to STRBUF (errtxt must stay valid)
-       lda ACCS,x
        sta STRBUF,x
        beq +
        inx
        bra -
+       lda #<STRBUF
        sta errtxt
        lda #>STRBUF
        sta errtxt+1
        pla
        jmp exterr

; ---- ON COLLISION PROCname | OFF (K325T collision engine) ----
; The handler text "PROCname:RETURN" is built in COLTXT (bank 0); the
; interrupt makes it pending, EVCHECK runs it between statements like an
; EVERY/AFTER handler (one at a time).
!zone oncoll
oncoll: inw tp
        jsr nxt
        cmp #TOFF
        bne +
        inw tp
        jsr coloff
        jmp xeq
+       cmp #TPROC
        lbne syntax
        ldx #0
-       lda [tp],z              ; TPROC and the name
        sta COLTXT,x
        inx
        cpx #56
        lbcs syntax
        inw tp
        lda [tp],z
        jsr range1
        bcc -
        lda #':'
        sta COLTXT,x
        lda #TRETURN
        sta COLTXT+1,x
        lda #CR
        sta COLTXT+2,x
        lda #$ff
        sta col_on
        lda #$03                ; clear the latch, interrupt on
        jsr colhw
        jmp xeq

; ---- ON ERROR / ON expr GOTO|GOSUB ----
!zone on
on:     jsr ovjmp               ; (overlay 1; ends with XEQ, GOTO1 or REM)
        !byte 1
        !word o_on
TON = $ee

; ---- INPUT ----
!zone input
input:  jsr nxt
        cmp #'#'
        lbeq inputh
        lda #0
        sta tmp4                ; prompt printed?
.l      jsr termq
        bne +
        jmp xeq
+       cmp #','
        beq .sep
        cmp #';'
        beq .sep
        cmp #'"'
        bne .var
        jsr strlit
        jsr ptext
        lda #1
        sta tmp4
        jsr nxt
        cmp #','
        bne +
        lda #0                  ; "prompt", -> show '?'
        sta tmp4
+       bra .l
.sep    inw tp
        bra .l
.var    jsr getvar
        bcc +
        jmp syntax
+       beq +
        jsr putvar
+       lda tmp4
        bne +
        lda #'?'
        jsr outchr
+       lda vptr
        pha
        lda vptr+1
        pha
        lda vtype
        pha
        lda tp
        pha
        lda tp+1
        pha
        jsr osline
        pla
        jsr settph
        pla
        sta tp
        pla
        sta vtype
        pla
        sta vptr+1
        pla
        sta vptr
        jsr inval
        jsr storevar
        lda #0
        sta tmp4
        jmp .l
; INVAL: convert ACCS line to value for vtype
inval:  lda vtype
        bmi .s
        lda tp
        pha
        lda tp+1
        pha
        lda #<ACCS
        sta tp
        lda #>ACCS
        jsr settph
        jsr signednum
        pla
        jsr settph
        pla
        sta tp
        rts
.s      ldx #0
-       lda ACCS,x
        cmp #CR
        beq +
        inx
        bne -
+       stx slen
        lda #$80
        sta etype
        rts
signednum:                      ; parse a number at tp -> acc (0 if none)
        jsr fpval
        jmp setnumf

; ---- READ / DATA / RESTORE ----
!zone read
restore:                        ; (overlay 2; ends with XEQ)
        jsr ovjmp
        !byte 2
        !word o_restore
; DSRCH: datptr -> line; find first line from there with DATA, point after token
dsrch:  lda datptr
        sta ptr1
        lda datptr+1
        sta ptr1+1
.ln     ldy #0
        jsr lp1y
        bne +
        lda #0
        sta datptr
        sta datptr+1
        sec
        rts
+       ldy #3
-       jsr lp1y
        cmp #' '
        bne +
        iny
        bra -
+       cmp #TDATA
        beq .found
        ldy #0
        jsr lp1y
        clc
        adc ptr1
        sta ptr1
        bcc .ln
        inc ptr1+1
        bra .ln
.found  iny
        tya
        clc
        adc ptr1
        sta datptr
        lda ptr1+1
        adc #0
        sta datptr+1
        clc
        rts
read:   jsr nxt
        cmp #'#'
        lbeq inputh
        lda datptr
        ora datptr+1
        bne .r1
        lda page
        sta datptr
        lda page+1
        sta datptr+1
        jsr dsrch
        lbcs .ood
.r1     jsr getvar
        bcc +
        jmp syntax
+       beq +
        jsr putvar
+       lda tp                  ; switch to data pointer
        pha
        lda tp+1
        pha
        lda datptr
        sta tp
        lda datptr+1
        jsr settph
        jsr nxt
        cmp #CR                 ; end of this DATA line -> next
        bne .item
        inw tp
        lda tp
        sta datptr
        lda tp+1
        sta datptr+1
        jsr dsrch
        bcs .ood2
        lda datptr
        sta tp
        lda datptr+1
        jsr settph
        jsr nxt
.item   lda vtype
        bmi .str0
        jsr signednum
        bra .end
.str0   lda [tp],z
        cmp #'"'
        bne .raw
        jsr strlit
        bra .end
.raw    ldx #0
-       lda [tp],z
        cmp #','
        beq +
        cmp #CR
        beq +
        sta ACCS,x
        inx
        inw tp
        bra -
+       stx slen
        lda #$80
        sta etype
.end    jsr nxt
        cmp #','
        bne +
        inw tp
+       lda tp
        sta datptr
        lda tp+1
        sta datptr+1
        pla
        jsr settph
        pla
        sta tp
        jsr storevar
        jsr nxt
        cmp #','
        bne +
        inw tp
        jmp read
+       jmp xeq
.ood2   pla
        pla
.ood    lda #42                 ; Out of DATA
        jmp error
