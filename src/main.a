; B65 BASIC - commands and common module (port of BBC BASIC (Z80) v5 MAIN.Z80)
; Original (C) R.T. Russell 1981-2025, zlib licence. This is an altered
; version: re-implemented in 45GS02 assembly for the MEGA65.

CR = 13
LF = 10

; token values not in the generated table
TAND    = $80
TDIV    = $81
TEOR    = $82
TMOD    = $83
TOR     = $84
TSTEP   = $88
TSPC    = $89
TTAB    = $8a
TPTR    = $8f
TBGET   = $9a           ; BGET (as a statement: BGET#c,addr,n block read)
TPAGE   = $90
TTIME   = $91
TLOMEM  = $92
THIMEM  = $93
TABS    = $94
TASC    = $97
TCOUNT  = $9c
TERL    = $9e
TERR    = $9f
TEVAL   = $a0
TFALSE  = $a3
TGET    = $a5
TINKEY  = $a6
TINSTR  = $a7
TINT    = $a8
TLEN    = $a9
TNOT    = $ac
TPI     = $af
TPOS    = $b1
TRND    = $b3
TSGN    = $b4
TTRUE   = $b9
TUSR    = $ba
TVAL    = $bb
TVPOS   = $bc
TCHRS   = $bd
TGETS   = $be
TINKEYS = $bf
TLEFTS  = $c0
TMIDS   = $c1
TRIGHTS = $c2
TSTRS   = $c3
TSTRINGS= $c4
TDEF    = $dd
TEND    = $e0
TENDPROC= $e1
TINPUT  = $e8
TPRINT  = $f1
TREPORT = $f6
TRETURN = $f8
TRUN    = $f9
TSTOP   = $fa
TWIDTH  = $fe
TQUIT   = $06
TSWAP   = $08
TCMD    = $c0
NCMD    = $51       ; number of entries in CMDTAB ($C0..$10)

; ---------------- entry points: src/boot.a ($2014 / $2017) ----------------
cold_prg:
cold_test:
        sei
        cld
        see                     ; 8-bit stack while we set up
        ldx #$ff
        txs
        ldy #1
        tys
        ldx #2                  ; clear zero page (keep CPU port $00/$01)
        lda #0
-       sta $00,x
        inx
        bne -
        ldx #$4f                ; and the variables at $1FB0 (moved out of ZP)
-       sta $1fb0,x
        dex
        bpl -
        jsr hw_init
        lda #$ff                ; (BOOT has unpacked the overlays to bank 4)
        jsr ovmap
        jsr xcflush
        lda #3                  ; (TEST_INIT is in overlay 3)
        jsr ovmap
        jsr test_init
        ; 16-bit stack from HIMEM down
        lda #<HIMEM0
        sta himem
        lda #>HIMEM0
        sta himem+1
        jsr resetsp_jsr
        ; scratchpad
        ldx #0
        lda #0
-       sta STAVAR,x
        sta STAVAR+$100,x
        sta STAVAR+$200,x       ; NUMBUF + MISC variables
        inx
        bne -
        lda #<PLIM              ; no libraries
        sta libase
        lda #>PLIM
        sta libase+1
        lda #PBANK              ; program pointer: bank of the program text
        sta pp+2
        lda #0
        sta pp+3
        lda #0                  ; keyboard ring buffer
        sta kbhead
        sta kbtail
        sta escflag
        lda #80                 ; text screen state (MISC area)
        sta scrcols
        lda #1
        sta tcolour
        lda #<($90a)            ; @% = &90A
        sta STAVAR
        lda #>($90a)
        sta STAVAR+1
        lda #$80                ; seed
        sta seed+4
        lda #$37
        sta listo
        lda #<notice
        sta errtxt
        lda #>notice
        sta errtxt+1
        lda #80
        sta width
        lda #0
        sta vduq
        sta tracen
        sta tracen+1
        sta autono
        sta autono+1
        lda #<PMIN              ; program text in bank PBANK
        sta page
        lda #>PMIN
        sta page+1
        jsr cls
        jsr newit
        jsr tell
vermsg: !text "B65 BASIC "
!src "src/version.a"
        !text " (45GS02) for MEGA65",CR,LF
        !text "Derived from BBC BASIC (Z80) v5",CR,LF
notice: !text "(C) Copyright R.T.Russell 2025",CR,LF,0
        jsr hwdetect
        jsr hwbanner
        jsr sndinit
        jsr irqinit
        jsr crlf
        jmp clopp

; resetsp_jsr: set 16-bit SP to HIMEM-1 and return to caller
resetsp_jsr:
        pla
        sta tmpw
        pla
        sta tmpw+1
        jsr resetsp
        lda tmpw+1
        pha
        lda tmpw
        pha
        rts
; resetsp: set SP := HIMEM-1 (16 bit), discards everything. NOT callable (jmp only use)
resetsp:
        pla                     ; keep own return address
        sta tmpw2
        pla
        sta tmpw2+1
        cle
        lda himem
        sec
        sbc #1
        tax
        lda himem+1
        sbc #0
        tay
        +setsp
        lda tmpw2+1
        pha
        lda tmpw2
        pha
        rts

; ---------------- WARM / CLOOP ----------------
warm:
clopp:
        jsr resetsp_jsr
        lda #'>'
        jsr outchr
        lda listo
        and #$0f
        ora #$30
        sta listo
        lda #0
        sta asmq
        sta inevt
        sta evpend
        jsr coloff
        jsr objreset
        lda #0
        sta ev_mode
        sta ev_mode+1
        sta ev_mode+2
        sta ev_mode+3
        sta errtrp
        sta errtrp+1
        sta onersp
        sta onersp+1
        sta curlin
        sta curlin+1
        lda autono
        ora autono+1
        beq .noauto
        lda autono
        sta lnum
        ldx autono+1
        stx lnum+1
        jsr pbcd
        lda autono
        clc
        adc increm
        sta autono
        bcc +
        inc autono+1
+       lda #' '
        jsr outchr
.noauto jsr osline
        lda #0
        sta count
        lda #<ACCS
        sta tp
        lda #>ACCS
        jsr settph
        lda autono
        ora autono+1
        bne .notcmd             ; in AUTO: everything is a program line
        jsr nxt
        lda #<COMNDS
        sta ptr1
        lda #>COMNDS
        sta ptr1+1
        jsr lex0
        bne .notcmd
        sec
        sbc #$80
        asl
        tax
        inw tp
        jsr nxt
        jmp (cmdtab,x)
.notcmd lda #<ACCS
        sta tp
        lda #>ACCS
        jsr settph
        lda #0
        sta lnum
        sta lnum+1
        lda autono
        ora autono+1
        bne .gotln
        jsr linnum
        bra .ln2
.gotln  lda autono              ; AUTO line number was printed already (autono advanced)
        sec
        sbc increm
        sta lnum
        lda autono+1
        sbc #0
        sta lnum+1
.ln2    jsr tokline
        lda lnum
        ora lnum+1
        bne .store
        lda #<BUFFER            ; direct mode
        sta tp
        lda #>BUFFER
        jsr settph
        jmp xeq
.store  jsr storeln
        bne +
        lda autono              ; empty line: delete only (and stop AUTO)
        ora autono+1
        beq clopp2
        lda #0
        sta autono
        sta autono+1
        bra clopp2
+       jsr clean
clopp2: jmp clopp

; TOKLINE: tokenise the text at tp (after the line number) -> BUFFER,
; tmp4 = length (without CR); lnum kept
tokline:
        jsr nxt
        lda #<BUFFER
        sta ptr2
        lda #>BUFFER
        sta ptr2+1
        lda #1                  ; left mode
        sta lexmode
        lda lnum                ; LEXAN may parse line numbers (GOTO n)
        pha
        lda lnum+1
        pha
        jsr lexan2              ; tokenise ACCS(tp) -> BUFFER(ptr2)
        pla
        sta lnum+1
        pla
        sta lnum
        ldy #0
        lda #CR
        sta (ptr2),y
        iny
        lda #0
        sta (ptr2),y            ; zero next (end-of-immediate marker)
        lda ptr2                ; length of tokenised text (without CR)
        sec
        sbc #<BUFFER
        sta tmp4
        rts
; STORELN: replace/insert program line lnum with BUFFER (tmp4 bytes);
; Z set if the line was empty (only deleted)
storeln:
        jsr findl
        bne +
        jsr del                 ; delete existing line
+       lda tmp4
        beq +
        jsr insline
        lda #1
+       rts

; insert line: ptr1 = insertion point (from findl), lnum, BUFFER (tmp4 bytes + CR)
!zone insline
insline:
        lda tmp4
        clc
        adc #4
        sta tmp5                ; total length
        jsr gettop              ; ptr2 = TOP
        ; check room: TOP + len < libase (end of program space)
        lda ptr2
        clc
        adc tmp5
        sta ptr3
        lda ptr2+1
        adc #0
        sta ptr3+1
        lda ptr3
        cmp libase
        lda ptr3+1
        sbc libase+1
        bcc .room
        lda #0
        jmp error               ; No room
.room   ; move [ptr1, TOP) up by tmp5 bytes, from the top down
        lda ptr2
        sec
        sbc ptr1
        sta tmpw                ; count
        lda ptr2+1
        sbc ptr1+1
        sta tmpw+1
        ; src end = ptr2-1, dst end = ptr2-1+len
        lda ptr2
        sta ptr3
        lda ptr2+1
        sta ptr3+1
        ldy #0
.mv     lda tmpw
        ora tmpw+1
        beq .moved
        lda ptr3
        bne +
        dec ptr3+1
+       dec ptr3
        jsr lp3y
        phy
        ldy tmp5
        jsr sp3y
        ply
        lda tmpw
        bne +
        dec tmpw+1
+       dec tmpw
        bra .mv
.moved  ldy #0
        lda tmp5
        jsr sp1y
        iny
        lda lnum
        jsr sp1y
        iny
        lda lnum+1
        jsr sp1y
        ldx #0
.cp     lda BUFFER,x
        iny
        jsr sp1y
        inx
        cmp #CR
        bne .cp
        rts

; ---------------- immediate commands ----------------
cmdtab: !word auto, delete, list, load, new, old, renum, save

new:    jsr newit
        jmp clopp

old:    ldy #0                  ; OLD: undo NEW if possible
        lda page
        sta ptr1
        lda page+1
        sta ptr1+1
        ldy #1                  ; NEW only zeroed the first length byte; find the CR
-       iny
        beq .bad
        jsr lp1y
        cmp #CR
        bne -
        iny
        tya
        ldy #0
        jsr sp1y
        jsr clean
        jmp clopp
.bad    jmp bad

auto:   jsr pair
        lda lnum
        sta autono
        lda lnum+1
        sta autono+1
        lda lnum2
        sta increm
        jmp clopp

; DELETE a,b
delete: jsr dlpair
.d1     ldy #0
        jsr lp1y
        beq .dx
        iny
        jsr lp1y
        sta tmpw
        iny
        jsr lp1y
        sta tmpw+1
        lda lnum2
        cmp tmpw
        lda lnum2+1
        sbc tmpw+1
        bcc .dx                 ; line > high
        jsr del
        bra .d1
.dx     jsr clean
        jmp clopp

; RENUMBER [start[,step]] (overlay 0)
renum:  jsr ovjsr
        !byte 0
        !word o_renum
        rts

; encode lnum at (ptr1),y (4 bytes: TLINO + 3)
encodey:
        lda #TLINO
        jsr sp1y
        iny
        jsr enc3
        jsr sp1y
        iny
        lda lnum
        and #$3f
        ora #$40
        jsr sp1y
        iny
        lda lnum+1
        and #$3f
        ora #$40
        jsr sp1y
        rts
enc3:   lda lnum+1              ; Z80 ENCODE: ((D&C0)>>2 | (E&C0)) >> 2 ^ $54
        and #$c0
        lsr
        lsr
        sta tmp0
        lda lnum
        and #$c0
        ora tmp0
        lsr
        lsr
        eor #$54
        rts

; ---------------- LIST ----------------
; LIST (overlay 0)
list:   jsr ovjsr
        !byte 0
        !word o_list
        rts

spaces: tax
        beq +
-       lda #' '
        jsr outchr
        dex
        bne -
+       rts

; DLPAIR: parse "[a][,b]" -> ptr1 = first line >= a, lnum2 = b (default 65535)
!zone dlpair
dlpair: jsr linnum
        lda lnum
        sta lnum3
        lda lnum+1
        sta lnum3+1
        lda #$ff
        sta lnum2
        sta lnum2+1
        jsr nxt
        cmp #','
        bne .one
        inw tp
        jsr nxt
        jsr linnum
        lda lnum
        ora lnum+1
        beq .two
        lda lnum
        sta lnum2
        lda lnum+1
        sta lnum2+1
        bra .two
.one    lda lnum3                ; single number: a..a
        ora lnum3+1
        beq .two
        lda lnum3
        sta lnum2
        lda lnum3+1
        sta lnum2+1
.two    lda lnum3
        sta lnum
        lda lnum3+1
        sta lnum+1
        jsr findl
        rts

; PAIR: "[a][,b]" defaults 10,10 -> lnum, lnum2
pair:   jsr linnum
        lda lnum
        ora lnum+1
        bne +
        lda #10
        sta lnum
+       lda lnum
        sta lnum3
        lda lnum+1
        sta lnum3+1
        lda #10
        sta lnum2
        lda #0
        sta lnum2+1
        jsr nxt
        cmp #','
        bne +
        inw tp
        jsr nxt
        jsr linnum
        lda lnum
        ora lnum+1
        beq +
        lda lnum
        sta lnum2
        lda lnum+1
        sta lnum2+1
+       lda lnum3
        sta lnum
        lda lnum3+1
        sta lnum+1
        rts

; ---------------- ERROR ----------------
; A = error number. Finds message in ERRWDS.
!zone error
error:  sta errnum
        lda #<ERRWDS
        sta errtxt
        lda #>ERRWDS
        sta errtxt+1
        ldx errnum
        beq error1
        ldy #0
.e0     lda (errtxt),y
        inw errtxt
        cmp #0
        bne .e0
        dex
        bne .e0
        bra error1
; EXTERR: A = error number, errtxt already set
exterr: sta errnum
error1: lda curlin              ; ERL
        sta ptr1
        lda curlin+1
        sta ptr1+1
        jsr setlin              ; -> erl
        lda errnum
        beq error2              ; fatal
        lda errtrp
        ora errtrp+1
        beq error2
        lda onersp              ; ON ERROR LOCAL: restore SP
        ora onersp+1
        beq .gl
        ldx onersp
        ldy onersp+1
        cle
        +setsp
        bra .go
.gl     jsr resetsp_jsr
.go     lda errtrp
        sta tp
        lda errtrp+1
        jsr settph
        jmp xeq
error2: jsr resetsp_jsr
        lda #0
        sta autono
        sta autono+1
        sta tracen
        sta tracen+1
        sta vduq
        jsr crlf
        jsr report
        lda erl
        ldx erl+1
        jsr sayln
        jsr crlf
        jmp clopp

; REPORT text
report: lda errtxt
        sta ptr3
        lda errtxt+1
        sta ptr3+1
text:   ldy #0
-       lda (ptr3),y
        beq +
        phy
        cmp #LF
        bne .o
        jsr outchr
        bra .n
.o      jsr out
.n      ply
        iny
        bra -
+       rts

; TELL: print zero-terminated text following the JSR
tell:   pla
        sta ptr3
        pla
        sta ptr3+1
        inw ptr3
        jsr text
        tya                     ; ptr3 + y + 1 -> continue after the zero
        sec
        adc ptr3
        sta ptr3
        bcc +
        inc ptr3+1
+       jmp (ptr3)

; SAYLN: A/X = line number; prints " at line n" if non-zero
sayln:  sta lnum
        stx lnum+1
        ora lnum+1
        beq +
        jsr tell
        !text " at line ",0
        jmp pbcdl
+       rts

bad:    jsr tell
        !text "Bad program",CR,LF,0
        jsr newit
        jmp clopp

; SETLIN: ptr1 = address; erl := number of line containing it (0 if none)
!zone setlin
setlin: lda #0
        sta erl
        sta erl+1
        lda ptr1
        cmp page
        lda ptr1+1
        sbc page+1
        bcc .x
        lda page
        sta ptr2
        lda page+1
        sta ptr2+1
.s1     ldy #0
        jsr lp2y
        beq .x
        clc
        adc ptr2
        sta ptr3
        lda ptr2+1
        adc #0
        sta ptr3+1
        lda ptr1                ; ptr1 < ptr3 ?
        cmp ptr3
        lda ptr1+1
        sbc ptr3+1
        bcc .found
        lda ptr3
        sta ptr2
        lda ptr3+1
        sta ptr2+1
        bra .s1
.found  ldy #1
        jsr lp2y
        sta erl
        iny
        jsr lp2y
        sta erl+1
.x      rts

; ---------------- LEX ----------------
; LEX: search keyword table. ptr1 = table, tp = text.
; Out: Z set if found, A = token, tp -> last char of keyword (or '.').
;      Z clear: not found, A = (tp), tp unchanged.
!zone lex
lex:    lda #<KEYWDS
        sta ptr1
        lda #>KEYWDS
        sta ptr1+1
lex0:   ldy #0
.l0     tya                     ; normalise: ptr1 -> entry, y = 0
        clc
        adc ptr1
        sta ptr1
        bcc +
        inc ptr1+1
+       ldy #0
        lda (ptr1),y            ; token
        sta tmp0
        iny
        lda [tp],z
        cmp (ptr1),y
        beq .l2
        bcc .fail               ; table is sorted by first letter
.l1     iny                     ; skip rest of entry
        bne +
        inc ptr1+1
+       lda (ptr1),y
        cmp #$20
        bcc .l0
        cmp #$80
        bcc .l1
        bra .l0
.fail   lda [tp],z
        cmp #$ff                ; NZ (text never holds $ff here)
        rts
.l2     ; first char matched; y -> keyword char 1st. compare rest
        sty tmp1
        ldz #0                  ; z = text offset
.l3     iny
        lda (ptr1),y
        cmp #$20
        bcc .found
        cmp #$80
        bcs .found
        inz
        lda [tp],z
        cmp (ptr1),y
        bne .l7
        cmp #$20                ; matched space marker: delimiter check below
        bne .l3
.l7     lda [tp],z
        cmp #'.'
        beq .found
        jsr range1
        bcc .l4                 ; text char is alphanumeric -> no match
        lda (ptr1),y
        cmp #' '
        bne .l4
        dez
        bra .found
.l4     ldz #0
        ldy tmp1
        bra .l1
.found  tza                     ; advance tp by z (to last char / '.')
        ldz #0
        clc
        adc tp
        sta tp
        bcc +
        inc tp+1
+       lda tmp0
        ldy #0
        cmp tmp0                ; Z set
        rts

; RANGE: is (tp) valid in a variable name? carry set if not.
range:  lda [tp],z
range0: cmp #'$'
        bcc .rx
        cmp #'&'+1
        bcs +
        clc                     ; $ % &
        rts
+       cmp #'('
        bne range1
        clc
        rts
range1: cmp #'0'
        bcc .rx
        cmp #'9'+1
        bcc .rok
        cmp #'@'
        beq .rok
range2: cmp #'A'
        bcc .rx
        cmp #'Z'+1
        bcc .rok
        cmp #'_'
        bcc .rx
        cmp #'z'+1
        bcc .rok
.rx     sec
        rts
.rok    clc
        rts

; ---------------- LEXAN ----------------
; Tokenise from tp into (ptr2); lexmode: bit0 left, bit3 hex, bit4 lineno,
; bit5 in variable, bit6 in REM/DATA/*, bit7 in quotes.
!zone lexan
lexan1: ldy #0
        sta (ptr2),y
        inw ptr2
        inw tp
lexan2: lda ptr2
        sec
        sbc #<BUFFER
        cmp #252
        bcc +
        lda #19
        jmp error
+       lda [tp],z
        cmp #CR
        bne +
        rts
+       jsr range1
        bcc +
        lda #$28                ; reset bits 5,3
        trb lexmode
+       lda [tp],z
        cmp #' '
        beq lexan1
        cmp #','
        beq lexan1
        cmp #'G'
        bcc +
        pha
        lda #$08
        trb lexmode
        pla
+       cmp #'"'
        bne +
        pha
        lda lexmode
        eor #$80
        sta lexmode
        pla
+       ; line number expected?
        bit lexmode
        pha
        lda lexmode
        and #$10
        beq .n6
        lda #$10
        trb lexmode
        pla
        jsr linnum
        lda lnum
        ora lnum+1
        beq lexan2
        jsr encode
        bra lexan2
.n6     pla
        ldx lexmode
        bne +
        jsr lexnum              ; integer constant: encode (carry set)
        bcc +
        jmp lexan2
+       ldx lexmode
        cpx #1
        beq .left
        cpx #0
        lbne lexan1
        cmp #$80
        bcs .l8
        jsr lexx
        bra .l8
.left   lda #0
        sta lexmode
        lda [tp],z
        cmp #'*'
        beq .l9
        cmp #$80
        bcs +
        jsr lexx
+       cmp #TDATA
        beq .l9
        cmp #TOKLO
        bcc .l8
        cmp #TOKHI+1
        bcs .l8
        clc
        adc #$cf-TOKLO          ; left version
.l8     cmp #TREM
        bne .la
.l9     pha
        lda #$40
        tsb lexmode
        pla
.la     cmp #TFN
        beq .lb
        cmp #TPROC
        beq .lb
        jsr range2
        bcs .lc
.lb     pha
        lda #$20
        tsb lexmode
        pla
.lc     cmp #'&'
        bne .ld
        pha
        lda #$08
        tsb lexmode
        pla
.ld     ldx #5
-       cmp lexlst1,x
        beq .le
        dex
        bpl -
        bra .lf
.le     pha
        lda #$10
        tsb lexmode
        pla
.lf     ldx #4
-       cmp lexlst2,x
        beq .lg
        dex
        bpl -
        jmp lexan1
.lg     pha
        lda #$01
        tsb lexmode
        pla
        jmp lexan1

; LEXNUM: A = (tp) with lexmode 0. A decimal constant of up to 9 digits
; (not after a name character or '.', not followed by '.' or 'E') or a hex
; constant '&' + 1..8 digits is stored as TNUM, D1, D2, 6-bit chunks:
; D1 = $40 | hex<<5 | lowercase<<4 | chunks-1, D2 = $40 | digits typed,
; chunks $40 | 6 bits, least significant first (all bytes $40-$7F, like
; TLINO's, so text scanners pass over them). Carry set: encoded, tp and
; ptr2 advanced; carry clear: A kept, nothing done.
!zone lexnum
lexnum: sta fh_
        cmp #'&'
        beq +
        cmp #'0'
        bcc .no
        cmp #'9'+1
        bcs .no
+       lda ptr2                ; room for 9 bytes before the length check
        sec
        sbc #<BUFFER
        cmp #252-9
        bcs .no
        dew tp                  ; previous character: not part of a name/number
        lda [tp],z
        cmp #'+'                ; exponent digits (1E-5, 1E+5) stay text
        beq +
        cmp #'-'
        bne ++
+       dew tp
        lda [tp],z
        inw tp
        cmp #'E'
        bne +
        inw tp
        bra .no
+       lda [tp],z
++      inw tp
        cmp #'.'
        beq .no
        cmp #'&'
        beq .no
        cmp #'%'
        beq .no
        cmp #'$'
        beq .no
        jsr range1
        bcc .no
        lda fh_
        cmp #'&'
        beq .hex
        ldz #0                  ; count the digits
-       lda [tp],z
        cmp #'0'
        bcc +
        cmp #'9'+1
        bcs +
        inz
        bra -
+       cpz #10
        bcs .noz
        cmp #'.'
        beq .noz
        cmp #'E'
        beq .noz
        stz fg_                 ; digits
        ldz #0
        jsr number              ; acc (fast path: <= 9 digits), tp advanced
        lda #$40
        bra .emit
.noz    ldz #0
.no     lda fh_
        clc
        rts
.hex    lda #0
        sta fa_                 ; lowercase flag
        sta fg_                 ; uppercase seen
        ldz #1
-       lda [tp],z
        cmp #'a'
        bcc +
        cmp #'f'+1
        bcs .hx
        lda #$10
        sta fa_
        bra .hd
+       cmp #'0'
        bcc .hx
        cmp #'9'+1
        bcc .hd
        cmp #'A'
        bcc .hx
        cmp #'F'+1
        bcs .hx
        sta fg_
.hd     inz
        bra -
.hx     jsr range1              ; a name character right after: keep as text
        bcc .noz
        cpz #1
        beq .noz                ; no digits
        cpz #10
        bcs .noz                ; more than 8
        lda fa_                 ; mixed case: keep as text
        beq +
        lda fg_
        bne .noz
+       dez
        stz fg_
        ldz #0
        jsr hexnum
        lda #$60
        ora fa_
.emit   sta fa_                 ; D1 without the chunk count
        ldq acc                 ; chunks: 6 bits at a time from acc (fb_..fe_ copy)
        stq fb_
        ldz #0
        ldy #3
-       lda fb_
        and #$3f
        ora #$40
        sta (ptr2),y
        iny
        ldx #6
--      lsrq fb_
        dex
        bne --
        lda fb_
        ora fb_+1
        ora fb_+2
        ora fb_+3
        bne -
        tya                     ; chunks = y - 3
        sec
        sbc #4
        ora fa_
        ldy #1
        sta (ptr2),y            ; D1
        lda fg_
        ora #$40
        iny
        sta (ptr2),y            ; D2
        lda #TNUM
        ldy #0
        sta (ptr2),y
        lda (ptr2),y            ; (keep flags quiet) length = chunks + 3
        ldy #1
        lda (ptr2),y
        and #7
        clc
        adc #4
        clc
        adc ptr2
        sta ptr2
        bcc +
        inc ptr2+1
+       sec
        rts

lexlst1: !byte TGOTO, TGOSUB, TRESTORE, TTRACE
lexlst2: !byte TTHEN, TELSE, TREPEAT, TERROR, ':'

; ENCODE lnum at ptr2, set bit 4
encode: lda #$10                ; (BUFFER is in bank 0: no encodey here)
        tsb lexmode
        ldy #0
        lda #TLINO
        sta (ptr2),y
        iny
        jsr enc3
        sta (ptr2),y
        iny
        lda lnum
        and #$3f
        ora #$40
        sta (ptr2),y
        iny
        lda lnum+1
        and #$3f
        ora #$40
        sta (ptr2),y
        lda ptr2
        clc
        adc #4
        sta ptr2
        bcc +
        inc ptr2+1
+       rts

; DECODE: tp -> byte after TLINO; lnum = line number; tp += 3
decode0:
        ldy #0
        lda [tp],z
        asl
        asl
        eor #$54<<2 & $ff
        sta tmp0                ; bits: b7,b6 = lo bits 7,6 ; b5,b4 = hi bits 7,6
        iny
        +ldtpy
        and #$3f
        sta lnum
        lda tmp0
        and #$c0
        ora lnum
        sta lnum
        iny
        +ldtpy
        and #$3f
        sta lnum+1
        lda tmp0
        asl
        asl
        and #$c0
        ora lnum+1
        sta lnum+1
        lda tp
        clc
        adc #3
        sta tp
        bcc +
        inc tp+1
+       rts

; LINNUM: parse decimal line number at tp -> lnum
!zone linnum
linnum: jsr nxt
        lda #0
        sta lnum
        sta lnum+1
        lda [tp],z
        cmp #TNUM
        bne .l1
        jsr tnumget             ; pre-encoded constant (LIST 10,20 etc.)
        lda acc+2
        ora acc+3
        bne .big
        lda acc
        sta lnum
        lda acc+1
        sta lnum+1
        rts
.l1     lda [tp],z
        sec
        sbc #'0'
        bcc .x
        cmp #10
        bcs .x
        sta tmp0
        inw tp
        lda lnum                ; *10
        sta tmpw
        lda lnum+1
        sta tmpw+1
        asl lnum
        rol lnum+1
        bcs .big
        asl lnum
        rol lnum+1
        bcs .big
        lda lnum
        clc
        adc tmpw
        sta lnum
        lda lnum+1
        adc tmpw+1
        sta lnum+1
        bcs .big
        asl lnum
        rol lnum+1
        bcs .big
        lda lnum
        clc
        adc tmp0
        sta lnum
        bcc .l1
        inc lnum+1
        bne .l1
.big    lda #20
        jmp error
.x      rts

; ---------------- program store helpers ----------------
; FINDL: lnum = line number. ptr1 -> line (or next higher / end). Z set if found.
!zone findl
findl:  lda page
        sta ptr1
        lda page+1
        sta ptr1+1
.f1     ldy #0
        jsr lp1y
        beq .nf
        ldy #1
        jsr lp1y
        cmp lnum
        iny
        jsr lp1y
        sbc lnum+1
        bcs .chk                ; line >= lnum
        ldy #0
        jsr lp1y
        clc
        adc ptr1
        sta ptr1
        bcc .f1
        inc ptr1+1
        bra .f1
.chk    ldy #1
        jsr lp1y
        cmp lnum
        bne .nf
        iny
        jsr lp1y
        cmp lnum+1
        rts                     ; Z if equal
.nf     lda #1                  ; NZ
        rts

; DEL: delete line at ptr1
!zone del
del:    jsr gettop              ; ptr2 = TOP
        ldy #0
        jsr lp1y
        sta tmp0
        ; copy [ptr1+len, TOP) down to ptr1
        lda ptr1
        sta ptr3
        lda ptr1+1
        sta ptr3+1
        ldy tmp0
.d1     lda ptr3
        clc
        adc tmp0
        tax
        lda ptr3+1
        adc #0
        cpx ptr2
        bne +
        cmp ptr2+1
        beq .dx
+       ldy tmp0
        jsr lp3y
        ldy #0
        jsr sp3y
        inw ptr3
        bra .d1
.dx     rts

; GETTOP: ptr2 = TOP (address after the 0,FF,FF end marker)
!zone gettop
gettop: lda page
        sta ptr2
        lda page+1
        sta ptr2+1
.g1     ldy #0
        jsr lp2y
        beq .g2
        tay
        dey
        jsr lp2y
        cmp #CR
        beq +
        jmp bad
+       iny
        tya
        clc
        adc ptr2
        sta ptr2
        bcc .g1
        inc ptr2+1
        bra .g1
.g2     lda ptr2
        clc
        adc #3
        sta ptr2
        bcc +
        inc ptr2+1
+       rts

; XCFLUSH: empty the compiled-expression cache (overlay 4 in bank 4: the
; key table XKHI and the next free byte XNEXT = XCODE, see xc.a)
xcflush:
        lda #0                  ; (the formals in PFB: forgotten too)
        sta pfbkey+1
        lda #0                  ; the compiler's ARRSCAN results too
        sta ascnt
        ldx #3
-       lda fptr,x
        pha
        dex
        bpl -
        lda #<XKHI_F
        sta fptr
        lda #>XKHI_F
        sta fptr+1
        lda #^XKHI_F
        sta fptr+2
        lda #0
        sta fptr+3
        ldz #0
-       sta [fptr],z
        inz
        bne -
        lda #<XNEXT_F
        sta fptr
        lda #>XNEXT_F
        sta fptr+1
        lda #<XCODE
        sta [fptr],z
        inz
        lda #>XCODE
        sta [fptr],z
        ldz #0
        ldx #0
-       pla
        sta fptr,x
        inx
        cpx #4
        bne -
        rts

; CLEAN: write end marker &FFFF and CLEAR
clean:  jsr gettop
        ldy #$fe                ; TOP-2, TOP-1 := $FF
        lda ptr2
        sec
        sbc #2
        sta ptr3
        lda ptr2+1
        sbc #0
        sta ptr3+1
        ldy #0
        lda #$ff
        jsr sp3y
        iny
        jsr sp3y
        jmp clear

newit:  lda page
        sta ptr1
        lda page+1
        sta ptr1+1
        ldy #0                  ; only the length byte (as Z80 NEWIT: OLD can
        tya                     ; then restore the first line)
        jsr sp1y
; CLEAR: clear dynamic variables; TOP = end of program (bank PBANK),
; LOMEM = FREE = start of the heap (bank 0, after the interpreter)
clear:  jsr xcflush
        jsr gettop
        lda ptr2
        sta top
        lda ptr2+1
        sta top+1
        lda #<prog_start
        sta lomem
        sta free
        lda #>prog_start
        sta lomem+1
        sta free+1
        lda #0                  ; far arrays (attic RAM) start again
        sta arrtop
        lda #$e0
        sta arrtop+1
        ldx #DYNEND-DYNVAR-1
        lda #0
-       sta DYNVAR,x
        dex
        bpl -
        rts

; ---------------- program text access (bank PBANK) ----------------
; LPnY: A = program byte at (ptrn)+Y, flags from A; X, Y kept, Z stays 0
; SPnY: program byte at (ptrn)+Y := A
lp1y:   lda ptr1
        sta pp
        lda ptr1+1
        bra lppy
lp2y:   lda ptr2
        sta pp
        lda ptr2+1
        bra lppy
lp3y:   lda ptr3
        sta pp
        lda ptr3+1
lppy:   sta pp+1
        tya
        taz
        lda [pp],z
        php
        ldz #0
        plp
        rts
sp1y:   pha
        lda ptr1
        sta pp
        lda ptr1+1
        bra sppy
sp2y:   pha
        lda ptr2
        sta pp
        lda ptr2+1
        bra sppy
sp3y:   pha
        lda ptr3
        sta pp
        lda ptr3+1
sppy:   sta pp+1
        tya
        taz
        pla
        sta [pp],z
        ldz #0
        rts
; SETTPH: tp+1 := A, and the bank of tp from it (keeps A and flags)
settph: sta tp+1
        php
        pha
        cmp #>PMIN
        lda #0
        bcc +
        lda #PBANK
+       sta tp+2
        pla
        plp
        rts

; ---------------- output ----------------
crlf:   lda #CR
        jsr outchr
        lda #LF
outchr: bit capflg              ; capture into ACCS (REPORT$)
        bpl +
        phx
        ldx slen
        sta ACCS,x
        inc slen
        plx
        rts
+       jsr oswrch
        cmp #CR
        beq .carret
        bcc .np
        inc count
        pha
        lda count
        cmp width
        pla
        bcc .np
        jsr crlf
.np     rts
.carret pha
        lda #0
        sta count
        pla
        rts

; OUT: output character or expand token
!zone out
out:    cmp #$20
        bcc .tok
        cmp #$80
        bcs .tok
        jmp outchr
.tok    sta tmp0
        lda #<KEYWDS
        sta optr
        lda #>KEYWDS
        sta optr+1
        lda listflg             ; listing: $11-$1F are extension keywords
        beq .kw
        lda tmp0
        cmp #$11
        bcc .kw
        cmp #$20
        bcs .kw
        lda #<EXTWDS
        sta optr
        lda #>EXTWDS
        sta optr+1
.kw
        ldy #0
.s      lda (optr),y
        cmp tmp0
        beq .f
        iny
        bne +
        inc optr+1
+       tya                     ; end of table? -> plain character
        clc
        adc optr
        tax
        lda optr+1
        adc #0
        cmp #>(KEYWDS+KEYWDL)
        bne .s
        cpx #<(KEYWDS+KEYWDL)
        bne .s
        lda tmp0
        jmp outchr
.f      ldx #$a0                ; B=160 for $11..$1F (print spaces)
        lda tmp0
        cmp #$11
        bcc +
        cmp #$20
        bcs +
        lda listflg             ; (listing extension keywords: no marker space)
        beq .t1
+       ldx #$a1
.t1     iny
        bne +
        inc optr+1
+       lda (optr),y
        cmp #$20
        bcc .x
        cmp #$80
        bcs .x
        cpx #$a1
        bne +
        cmp #$20
        beq .x
+       phx
        phy
        jsr outchr
        ply
        plx
        bra .t1
.x      rts

; PBCD: print lnum as 5-wide decimal (leading spaces); PBCDL: no padding
!zone pbcd
pbcd:   lda #' '
        bra +
pbcdl:  lda #0
+       sta tmp2
        ldx #4
.d      ldy #0
.s      lda lnum
        sec
        sbc p10lo,x
        sta tmp0
        lda lnum+1
        sbc p10hi,x
        bcc .o
        sta lnum+1
        lda tmp0
        sta lnum
        iny
        bra .s
.o      tya
        bne .dig
        cpx #0
        beq .dig
        lda tmp2
        beq .nx
        jsr outchr
        bra .nx
.dig    ora #'0'
        jsr outchr
        lda #'0'
        sta tmp2
.nx     dex
        bpl .d
        rts
p10lo:  !byte <1, <10, <100, <1000, <10000
p10hi:  !byte >1, >10, >100, >1000, >10000

; NXT: skip spaces, A = (tp)
nxt:    lda [tp],z
        cmp #' '
        bne +
        inw tp
        bra nxt
+       rts
