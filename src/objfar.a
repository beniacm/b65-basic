; B65 BASIC - generated from src/obj.a by tools/mkobjfar.py: do not edit
!zone objstep          ; (generated by tools/mkobjfar.py)
objstep:
        php                     ; interrupts off: while the table is mapped at
        sei                     ; $E000, $FFFA-$FFFF are object bytes, not vectors
        tba
        pha
        lda #ZPB
        tab
        lda objcnt
        sta oL
        lda objcnt+1
        sta oL+1
        ora oL
        lbeq .out
        ldx #7                  ; the multiplier inputs of the interrupted
-       lda $d770,x             ; program (restored at the end)
        sta objmul,x
        dex
        bpl -
        lda #0
        sta oW
        sta $d772               ; multiplier high bytes: 0 for .SIN
        sta $d773
        sta $d776
        sta $d777
        lda #1
        jsr .hold
        ldx #3                  ; oP = objbase (32 bits)
-       lda objbase,x
        sta oP,x
        dex
        bpl -
.ent    ldz #16
        lda [oP],z
        sta oM
        and #$0f
        beq .nx
        cmp #4
        bne .n1
        ldz #19                 ; ---- fast (inline): x += the step's high byte
        lda [oP],z
        sta oT
        ldz #0
        clc
        adc [oP],z
        sta [oP],z
        inz
        lda [oP],z              ; bits 9..8 (+ carry, - 1 for a negative
        adc #0                  ; step); the flag bits are cleared
        bit oT
        bpl +
        dec
+       and #3
        sta [oP],z
        ldz #21                 ; y += the step's high byte
        lda [oP],z
        sta oT
        ldz #2
        clc
        adc [oP],z
        sta [oP],z
        inz
        lda [oP],z
        adc #0
        bit oT
        bpl +
        dec
+       and #3
        sta [oP],z
        ldz #17
        lda [oP],z
        and #$1f
        beq .nx
        jsr .lim
        bra .nx
.n1     cmp #1
        bne +
        jsr .cart
        bra .nx
+       jsr .one
.nx     lda oP                  ; next entry (32 bits)
        clc
        adc #32
        sta oP
        bcc +
        inc oP+1
        bne +
        inc oP+2
+       lda oL                  ; objects left
        bne +
        dec oL+1
+       dec oL
        lda oL
        ora oL+1
        lbne .ent
.done   lda #0
        jsr .hold
        ldx #7                  ; the program's multiplier and divider inputs
-       lda objmul,x            ; back (it may be between writing them and
        sta $d770,x             ; reading the result)
        dex
        bpl -
-       bit $d70f               ; and their results ready again
        bmi -
        bvs -
.out    pla
        tab
        plp
        ldz #0
        rts
.hold   bit hw_k325t            ; K325T: HOLD = A ($FFD71FC)
        bpl +
        pha
        lda #$fc
        sta oQ
        lda #$71
        sta oQ+1
        lda #$fd
        sta oQ+2
        lda #$0f
        sta oQ+3
        pla
        ldz #0
        sta [oQ],z
+       rts

; one object: oP -> its entry, oM = its mode byte
.one    and #$0f
        cmp #5
        beq .conv
        cmp #2
        lbeq .polar
        cmp #3
        lbeq .orbit
        rts
; ---- mode 5 (OBJMOVE without a speed change): v = speed * (cos, sin)
; heading once, then cartesian (+28: the turn as a rotation, if any) ----
.conv   jsr .vang
        ldz #18
        lda oVX
        sta [oP],z
        inz
        lda oVX+1
        sta [oP],z
        inz
        lda oVY
        sta [oP],z
        inz
        lda oVY+1
        sta [oP],z
        lda oM
        and #$f0
        ora #1
        sta oM
        ldz #16
        sta [oP],z
; ---- cartesian: v += a (or the harmonic pull), position += v ----
.cart   ldz #17
        lda [oP],z
        sta oA
        lda oM
        and #$10
        beq .acc
        jsr .harm
        bra .cv
.acc    bit oA                  ; +17 bit 6: there is an acceleration
        bvc .rq
        ldz #22                 ; vx += ax
        lda [oP],z
        ldz #18
        clc
        adc [oP],z
        sta [oP],z
        ldz #23
        lda [oP],z
        ldz #19
        adc [oP],z
        sta [oP],z
        ldz #24                 ; vy += ay
        lda [oP],z
        ldz #20
        clc
        adc [oP],z
        sta [oP],z
        ldz #25
        lda [oP],z
        ldz #21
        adc [oP],z
        sta [oP],z
.rq     ldz #28                 ; +28: a turn of 1/2^k radian per frame
        lda [oP],z              ; (bit 7: negative, bits 2..0: k)
        beq .cv
        jsr .rot
.cv     ldz #18
        lda [oP],z
        sta oVX
        inz
        lda [oP],z
        sta oVX+1
        inz
        lda [oP],z
        sta oVY
        inz
        lda [oP],z
        sta oVY+1
        jsr .pos
        lda oA
        and #$1f                ; no limits, no lifetime: done
        lbne .lim
        rts
; .ROT: A = turn code: VX -= VY >> k, then VY += VX >> k (the new VX;
; negative turn: += / -=): Minsky's rotation, shifts only
.rot    sta oT+3
        and #7
        sta oT+2
        ldz #20                 ; t = VY >> k
        jsr .shk
        ldz #18
        jsr .sadd               ; VX -= t (+= for a negative turn)
        lda oT+3
        eor #$80
        sta oT+3
        ldz #18                 ; t = VX >> k
        jsr .shk
        ldz #20
.sadd   bit oT+3                ; field +Y -= t (bit 7 of oT+3 set: += t)
        bmi +
        lda [oP],z
        sec
        sbc oT
        sta [oP],z
        inz
        lda [oP],z
        sbc oT+1
        sta [oP],z
        rts
+       lda [oP],z
        clc
        adc oT
        sta [oP],z
        inz
        lda [oP],z
        adc oT+1
        sta [oP],z
        rts
.shk    lda [oP],z              ; oT = field +Y >> k, rounded
        sta oT
        inz
        lda [oP],z
        sta oT+1
        ldx oT+2                ; (rounded: >> (k-1), + 1, >> 1)
        dex
        beq +
-       asr oT+1
        ror oT
        dex
        bne -
+       inw oT
        asr oT+1
        ror oT
        rts
; ---- polar: speed += dspeed, heading += turn, v from the sine table ----
.polar  ldz #22                 ; speed += dspeed
        lda [oP],z
        ldz #18
        clc
        adc [oP],z
        sta [oP],z
        ldz #23
        lda [oP],z
        ldz #19
        adc [oP],z
        sta [oP],z
        ldz #24                 ; heading += turn
        lda [oP],z
        ldz #20
        clc
        adc [oP],z
        sta [oP],z
        ldz #25
        lda [oP],z
        ldz #21
        adc [oP],z
        sta [oP],z
        jsr .vang               ; oVX/oVY = speed * (cos, sin) heading
        jsr .pos
        jmp .lim
; .VANG: oVX = r * cos(a), oVY = r * sin(a); r = +18 (8.8), a = +20
.vang   ldz #20
        lda [oP],z
        sta oT
        inz
        lda [oP],z
        sta oT+1
        clc                     ; cos(a) = sin(a + $4000)
        adc #$40
        sta oT+3
        lda oT
        sta oT+2
        jsr .sin                ; oT+2/3 angle -> A/X = r * sin (8.8)
        sta oVX
        stx oVX+1
        lda oT
        sta oT+2
        lda oT+1
        sta oT+3
        jsr .sin
        sta oVY
        stx oVY+1
        rts
; .SIN: A/X = r * sin(angle oT+2/3), r = +18 (signed 8.8); table: 1024
; magnitudes for the quarter (index = angle bits 13..4), quadrant = bits 15..14
.sin    lda oT+2                ; index = angle >> 4 AND 1023
        sta oQ
        lda oT+3
        and #$3f
        lsr
        ror oQ
        lsr
        ror oQ
        lsr
        ror oQ
        lsr
        ror oQ                  ; oQ = index low, A = index bits 9..8
        bit oT+3                ; quadrants 1 and 3: mirrored index
        bvc +
        eor #3
        tax
        lda oQ
        eor #$ff
        sta oQ
        txa
+       asl oQ                  ; * 2 bytes
        rol
        clc
        adc #>SINTAB
        sta oQ+1
        lda #^SINTAB
        sta oQ+2
        lda #0
        sta oQ+3
        ldz #0                  ; (far; the multiplier's high bytes are
        lda [oQ],z              ; 0 for the whole step)
        sta $d774
        inz
        lda [oQ],z
        sta $d775
        lda oT+3                ; sign: quadrants 2 and 3, and r's
        and #$80
        sta oT+2
        ldz #18
        lda [oP],z
        sta $d770
        inz
        lda [oP],z
        bpl +
        pha
        lda oT+2
        eor #$80
        sta oT+2
        lda #0                  ; |r|
        sec
        sbc $d770
        sta $d770
        pla
        eor #$ff
        adc #0
+       sta $d771
-       bit $d70f               ; (multiplier busy)
        bvs -
        lda $d77a               ; product >> 16: 8.8
        ldx $d77b
        bit oT+2
        bpl +
        eor #$ff                ; negate A/X
        clc
        adc #1
        pha
        txa
        eor #$ff
        adc #0
        tax
        pla
+       rts
; ---- orbit: angle += omega, position = parent + r (cos, sin) ----
.orbit  ldz #24
        lda [oP],z
        ldz #20
        clc
        adc [oP],z
        sta [oP],z
        ldz #25
        lda [oP],z
        ldz #21
        adc [oP],z
        sta [oP],z
        jsr .vang               ; oVX/oVY: the offset (8.8)
        jsr .anch               ; oQ -> the parent's entry (far)
        ldz #30                 ; x = parent's x (10.8) + offset
        lda [oQ],z
        clc
        adc oVX
        ldz #30
        sta [oP],z
        ldz #0
        lda [oQ],z
        adc oVX+1
        ldz #0
        sta [oP],z
        lda #0
        bit oVX+1
        bpl +
        lda #$ff
+       sta oT
        ldz #1
        lda [oQ],z
        adc oT
        and #3
        sta oT
        ldz #1
        lda [oP],z
        and #$fc
        ora oT
        sta [oP],z
        ldz #31                 ; y = parent's y + offset
        lda [oQ],z
        clc
        adc oVY
        ldz #31
        sta [oP],z
        ldz #2
        lda [oQ],z
        adc oVY+1
        ldz #2
        sta [oP],z
        lda #0
        bit oVY+1
        bpl +
        lda #$ff
+       sta oT
        ldz #3
        lda [oQ],z
        adc oT
        and #3
        sta oT
        ldz #3
        lda [oP],z
        and #$fc
        ora oT
        sta [oP],z
        ldz #0
        jmp .lim
; .ANCH: oQ = objbase + (+28) * 32 (far)
.anch   ldz #28
        lda [oP],z
        sta oQ
        inz
        lda [oP],z
        and #3
        ldx #5
-       asl oQ
        rol
        dex
        bne -
        sta oQ+1
        lda #0
        rol
        sta oQ+2
        lda oQ
        clc
        adc objbase
        sta oQ
        lda oQ+1
        adc objbase+1
        sta oQ+1
        lda oQ+2
        adc objbase+2
        sta oQ+2
        lda objbase+3
        sta oQ+3
        rts
; ---- harmonic: v += -k * (position - anchor) (k = +22, 8.8) ----
.harm   jsr .anch
        ldx #0                  ; X axis (fields +30, +0, +1), then Y
        jsr .h1
        ldx #1
.h1     lda .hf,x               ; fraction offset
        taz
        lda [oP],z
        sec
        sbc [oQ],z
        sta $d770
        lda .hl,x
        taz
        lda [oP],z
        sbc [oQ],z
        sta $d771
        inz
        lda [oP],z
        sbc [oQ],z
        and #3                  ; 10 integer bits: d mod 1024 px, signed
        cmp #2
        bcc +
        ora #$fc
+       ldz #0
        sta oT                  ; sign of d (bits 23..16)
        bit oT
        bpl +
        lda #0                  ; |d|
        sec
        sbc $d770
        sta $d770
        lda #0
        sbc $d771
        sta $d771
        lda #0
        sbc oT
        sta $d772
        bra ++
+       sta $d772
++      lda #0
        sta $d773
        sta $d776
        sta $d777
        ldz #22                 ; k
        lda [oP],z
        sta $d774
        inz
        lda [oP],z
        sta $d775
-       bit $d70f
        bvs -
        lda $d779               ; a = (k * |d|) >> 8 (8.8)
        sta oT+2
        lda $d77a
        sta oT+3
        bit oT                  ; v -= a for d > 0, v += a for d < 0
        bmi +
        lda #0
        sec
        sbc oT+2
        sta oT+2
        lda #0
        sbc oT+3
        sta oT+3
+       lda #0                  ; (.SIN expects it 0)
        sta $d772
        lda .hv,x               ; velocity field
        taz
        lda [oP],z
        clc
        adc oT+2
        sta [oP],z
        inz
        lda [oP],z
        adc oT+3
        sta [oP],z
        rts
.hf     !byte 30, 31
.hl     !byte 0, 2
.hv     !byte 18, 20
; ---- .POS: position += (oVX, oVY); 10 integer bits, flags kept ----
.pos    lda oVX+1               ; signs of the steps: $00 / $ff
        asl
        lda #0
        sbc #0
        eor #$ff
        sta oT+2
        lda oVY+1
        asl
        lda #0
        sbc #0
        eor #$ff
        sta oT+3
        ldz #30
        lda [oP],z
        clc
        adc oVX
        sta [oP],z
        ldz #0
        lda [oP],z
        adc oVX+1
        sta [oP],z
        inz
        lda [oP],z              ; bits 9..8 += sign + carry, flags kept
        sta oT
        adc oT+2
        eor oT
        and #3
        eor oT
        sta [oP],z
        ldz #31
        lda [oP],z
        clc
        adc oVY
        sta [oP],z
        ldz #2
        lda [oP],z
        adc oVY+1
        sta [oP],z
        inz
        lda [oP],z
        sta oT
        adc oT+3
        eor oT
        and #3
        eor oT
        sta [oP],z
        rts
; .LIM: +17 bits 3..0 = 0 (only a lifetime) or the object inside its
; limit set: straight to the lifetime; else the full limits routine
.lim    ldz #17
        lda [oP],z
        and #$0f
        lbeq .life
        lda oM                  ; X = set * 9
        lsr
        lsr
        lsr
        lsr
        lsr
        and #3
        sta oT
        asl
        asl
        asl
        adc oT
        tax
        ldz #0                  ; x0 <= x <= x1 (x 0..1023)
        lda [oP],z
        sta oT
        inz
        lda [oP],z
        and #3
        sta oT+1
        lda oT
        cmp objlim,x
        lda oT+1
        sbc objlim+1,x
        bvc +
        eor #$80
+       bmi .bnd
        lda objlim+4,x
        cmp oT
        lda objlim+5,x
        sbc oT+1
        bvc +
        eor #$80
+       bmi .bnd
        inz                     ; y0 <= y <= y1 (y signed)
        lda [oP],z
        sta oT
        inz
        lda [oP],z
        and #3
        cmp #2
        bcc +
        ora #$fc
+       sta oT+1
        lda oT
        cmp objlim+2,x
        lda oT+1
        sbc objlim+3,x
        bvc +
        eor #$80
+       bmi .bnd
        lda objlim+6,x
        cmp oT
        lda objlim+7,x
        sbc oT+1
        bvc +
        eor #$80
+       bmi .bnd
        jmp .life
; ---- limits (+17 action, mode bits 6..5 set), then the lifetime ----
.bnd    ldz #17
        lda [oP],z
        and #$0f
        lbeq .life
        lda oM                  ; X = set * 9
        lsr
        lsr
        lsr
        lsr
        lsr
        and #3
        sta oT
        asl
        asl
        asl
        adc oT
        tax
        ldz #0                  ; x (0..1023) -> oT/oT+1
        lda [oP],z
        sta oT
        inz
        lda [oP],z
        and #3
        sta oT+1
        ldz #17
        lda [oP],z
        and #3
        beq .by
        sta oT+2                ; X action
        lda oT                  ; x < x0?
        cmp objlim,x
        lda oT+1
        sbc objlim+1,x
        bvc +
        eor #$80
+       bpl +
        lda #0                  ; low side
        jsr .act
        lbcs .killed
        bra .by
+       lda objlim+4,x          ; x1 < x?
        cmp oT
        lda objlim+5,x
        sbc oT+1
        bvc +
        eor #$80
+       bpl .by
        lda #1                  ; high side
        jsr .act
        bcs .killed
.by     ldz #2                  ; y (signed 10 bits)
        lda [oP],z
        sta oT
        inz
        lda [oP],z
        and #3
        cmp #2
        bcc +
        ora #$fc
+       sta oT+1
        ldz #17
        lda [oP],z
        lsr
        lsr
        and #3
        beq .life
        sta oT+2
        lda oT
        cmp objlim+2,x
        lda oT+1
        sbc objlim+3,x
        bvc +
        eor #$80
+       bpl +
        lda #2
        jsr .act
        bcs .killed
        bra .life
+       lda objlim+6,x
        cmp oT
        lda objlim+7,x
        sbc oT+1
        bvc +
        eor #$80
+       bpl .life
        lda #3
        jsr .act
        bcs .killed
.life   ldz #17                 ; lifetime (only with +17 bit 4): count
        lda [oP],z              ; down, kill at 0
        and #$10
        beq .lx
        ldz #26
        lda [oP],z
        inz
        ora [oP],z
        beq .lx
        dez
        lda [oP],z
        bne +
        inz
        lda [oP],z
        dec
        sta [oP],z
        dez
+       lda [oP],z
        dec
        sta [oP],z
        inz
        ora [oP],z
        bne .lx
        jmp .kill
.killed
.lx     rts
; .ACT: A = side (0 x low, 1 x high, 2 y low, 3 y high), oT+2 = action,
; oT/oT+1 = the coordinate, X = limit set offset. Carry set: killed.
.act    sta oT+3
        lda oT+2
        cmp #3
        bne +
        jsr .kill
        sec
        rts
+       cmp #1
        lbne .bounce
        ; wrap: coordinate += / -= (c1 - c0 + 1)
        lda oT+3
        and #2                  ; X: limits +0/+4, Y: +2/+6
        sta oT+2
        txa
        clc
        adc oT+2
        tay                     ; (objlim index of c0)
        lda objlim+4,y          ; size = c1 - c0 + 1
        sec
        sbc objlim,y
        sta oVX
        lda objlim+5,y
        sbc objlim+1,y
        sta oVX+1
        inw oVX
        lda oT+3
        lsr                     ; low side: add, high side: subtract
        bcs +
        lda oT
        clc
        adc oVX
        sta oT
        lda oT+1
        adc oVX+1
        sta oT+1
        bra .wr
+       lda oT
        sec
        sbc oVX
        sta oT
        lda oT+1
        sbc oVX+1
        sta oT+1
.wr     lda oT+3                ; write the coordinate back (10 bits)
        and #2
        taz
        lda oT
        sta [oP],z
        inz
        lda oT+1
        and #3
        sta oT
        lda [oP],z
        and #$fc
        ora oT
        sta [oP],z
        clc
        rts
.bounce cmp #2
        beq +
        clc                     ; (0: none)
        rts
+       lda oT+3                ; the coordinate := the limit
        and #2
        sta oT+2
        lda oT+3
        lsr
        lda #0
        bcc +
        lda #4                  ; high side: c1
+       clc
        adc oT+2
        sta oVX
        txa
        clc
        adc oVX
        tay
        lda objlim,y
        sta oT
        lda objlim+1,y
        sta oT+1
        jsr .wr
        lda oM                  ; polar: reflect the heading
        and #$0f
        cmp #2
        beq .bpol
        lda oT+3                ; cartesian: v := -v (or -v/2)
        and #2
        clc
        adc #18
        taz
        lda [oP],z
        sta oVX
        inz
        lda [oP],z
        sta oVX+1
        ldz #17
        lda [oP],z
        and #$20
        beq +
        lda oVX+1
        asl
        ror oVX+1
        ror oVX
+       lda oT+3
        and #2
        clc
        adc #18
        taz
        lda #0
        sec
        sbc oVX
        sta [oP],z
        inz
        lda #0
        sbc oVX+1
        sta [oP],z
        clc
        rts
.bpol   ldz #20                 ; x side: heading := $8000 - heading,
        lda oT+3                ; y side: heading := -heading
        and #2
        bne +
        lda #0
        sec
        sbc [oP],z
        sta [oP],z
        inz
        lda #$80
        sbc [oP],z
        sta [oP],z
        clc
        rts
+       lda #0
        sec
        sbc [oP],z
        sta [oP],z
        inz
        lda #0
        sbc [oP],z
        sta [oP],z
        clc
        rts
; .KILL: draw mask 0, motion off, event (bit oN; ON OBJEVENT pending)
.kill   lda #0
        ldz #4
        sta [oP],z
        ldz #16
        sta [oP],z
        lda oP+1                ; byte = (oP - objbase) / 256
        sec
        sbc objbase+1
        tax
        lda oP                  ; bit = (oP / 32) AND 7
        lsr
        lsr
        lsr
        lsr
        lsr
        tay
        lda bitmask8,y
        ora objevb,x
        sta objevb,x
        bit objevon
        bpl +
        lda #$20
        tsb evpend
+       rts
} ; (OBJFAR: the far-pointer integrator instead)
!ifdef OBJFAR {
!src "src/objfar.a"
        !align 255, 0
objzpg  !fill 256, 0
}
