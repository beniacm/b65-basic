; B65 BASIC - code overlays
; Altered version of BBC BASIC (Z80) v5 by R.T. Russell (zlib licence) - see LICENSE
;
; Rarely used modules (inline assembler, ...) are assembled to run at
; $E000-$FFF9 and copied at start-up to chip RAM bank 4 ($40000 + n*$2000).
; They are mapped into CPU block 7 ($E000-$FFFF) with the 45GS02 MAP
; instruction when needed. The core (bank 0, $2000-) is always visible.

OVBASE  = $040000

; OVINIT: copy the overlay images to bank 4 (called once at start-up)
!zone ovinit
ovinit: lda lzhtabp
        sta ptr1
        lda lzhtabp+1
        sta ptr1+1
        jsr lzhinit
        ldx #0
.l      cpx #NOVL*4
        beq .x
        lda ovltab,x            ; source (bank 0)
        sta ptr1
        lda ovltab+1,x
        sta ptr1+1
        lda ovltab+2,x          ; length
        sta tmpw
        lda ovltab+3,x
        sta tmpw+1
        txa                     ; destination = OVBASE + n*$2000
        asl
        asl
        asl                     ; (x = n*4) -> n*32 = high byte offset of n*$2000
        clc
        adc #>OVBASE
        sta fptr+1
        lda #<OVBASE
        sta fptr
        lda #^OVBASE
        sta fptr+2
        lda #0
        sta fptr+3
        phx
        jsr lzhdec              ; the image is LZH-packed (tools/packovl.py)
        plx
        ; vectors at offset $1FFA (NMI, RESET, IRQ) -> core handlers
        txa
        asl
        asl
        asl
        clc
        adc #$1f                ; (OVBASE is 64K aligned)
        sta fptr+1
        lda #^OVBASE
        sta fptr+2
        lda #$fa
        sta fptr
        ldy #0
        ldz #0
-       lda ovvec,y
        sta [fptr],z
        iny
        inz
        cpy #6
        bne -
        ldz #0
        inx
        inx
        inx
        inx
        bra .l
.x      lda #$ff
        sta curovl
        rts
ovvec:  !word irq_rti, cold_prg, irqhandler

; ---- LZH unpacker (tools/lzh.py): LZ77 with canonical-Huffman literals ----
; LZHINIT: ptr1 -> the shared code-length table (256 nibbles): builds
; LZCNT (codes per length) and LZSYM (symbols by length, then value).
LZSYM   = STRBUF            ; (start-up only)
LZCNT   = NUMBUF
lzhtabp: !word 0            ; set by tools/packovl.py
lzhinit:
        ldx #15
        lda #0
-       sta LZCNT,x
        dex
        bpl -
        ldx #0
        lda #1
        sta tmp3                ; length
.ln     lda #0
        sta tmp4                ; symbol
.s      lda tmp4
        lsr
        tay
        lda (ptr1),y
        bcs +
        lsr
        lsr
        lsr
        lsr
+       and #$0f
        cmp tmp3
        bne .nx
        lda tmp4
        sta LZSYM,x
        inx
        ldy tmp3
        lda LZCNT,y
        inc
        sta LZCNT,y
.nx     inc tmp4
        bne .s
        inc tmp3
        lda tmp3
        cmp #16
        bne .ln
        rts
; LZHDEC: unpack the stream at ptr1 to fptr (32-bit)
lzhdec: lda #0
        sta tmp1                ; bits left in tmp0
        ldy #0
        ldz #0
.t      jsr lzbit
        bcs .m
        jsr lzhuff
        sta [fptr],z
        inw fptr
        bra .t
.m      jsr lzgam               ; length - 1
        lda tmpw
        sta tmp2
        jsr lzbit
        bcs .lg
        ldx #8
        jsr lzbits
        inw tmpw                ; distance 1..256
        bra .cp
.lg     ldx #16
        jsr lzbits
        lda tmpw
        ora tmpw+1
        bne .cp
        rts                     ; distance 0: end
.cp     sec
        lda fptr
        sbc tmpw
        sta ap
        lda fptr+1
        sbc tmpw+1
        sta ap+1
        lda fptr+2
        sta ap+2
        lda #0
        sta ap+3
-       lda [ap],z
        sta [fptr],z
        inw ap
        inw fptr
        lda tmp2
        beq .t
        dec tmp2
        bra -
lzbit:  dec tmp1                ; carry = next bit
        bpl +
        lda (ptr1),y
        sta tmp0
        inw ptr1
        lda #7
        sta tmp1
+       asl tmp0
        rts
lzbits: lda #0                  ; tmpw = X bits
        sta tmpw
        sta tmpw+1
-       jsr lzbit
        rol tmpw
        rol tmpw+1
        dex
        bne -
        rts
lzgam:  ldx #0                  ; tmpw = gamma value
-       jsr lzbit
        bcs +
        inx
        bra -
+       lda #1
        sta tmpw
        lda #0
        sta tmpw+1
        cpx #0
        beq +
-       jsr lzbit
        rol tmpw
        rol tmpw+1
        dex
        bne -
+       rts
; LZHUFF: A = next literal (as puff.c: code, first, index per length)
lzhuff: lda #0
        sta tmpw2               ; code
        sta tmpw2+1
        sta ptr2                ; first
        sta ptr2+1
        sta ptr3                ; index
        sta ptr3+1
        ldx #1
.hl     jsr lzbit
        lda tmpw2
        adc #0                  ; code |= bit (bit 0 is clear)
        sta tmpw2
        lda ptr2                ; tmpw = first + count
        clc
        adc LZCNT,x
        sta tmpw
        lda ptr2+1
        adc #0
        sta tmpw+1
        lda tmpw2               ; code < first + count: found
        cmp tmpw
        lda tmpw2+1
        sbc tmpw+1
        lbcs .hn
        lda ptr3                ; symbol index = index + code - first
        clc
        adc tmpw2
        sec
        sbc ptr2
        tay
        lda LZSYM,y
        ldy #0
        rts
.hn     lda ptr3                ; index += count
        clc
        adc LZCNT,x
        sta ptr3
        lda ptr3+1
        adc #0
        sta ptr3+1
        lda tmpw                ; first = (first + count) << 1
        asl
        sta ptr2
        lda tmpw+1
        rol
        sta ptr2+1
        asl tmpw2               ; code <<= 1
        rol tmpw2+1
        inx
        bra .hl

; OVMAP: A = overlay number ($FF = none): map it at $E000
ovmap:  sta curovl
        cmp #$ff
        beq .none
        asl                     ; offset>>8 = $320 + n*$20
        asl
        asl
        asl
        asl
        clc
        adc #$20
        tay
        lda #$83
        adc #0
        taz
        lda #0
        ldx #0
        map
        eom
        ldz #0
        rts
.none   lda #0
        tax
        tay
        taz
        map
        eom
        rts

; OVJMP: inline !byte n : !word addr  (does not return)
ovjmp:  pla
        sta rtmp
        pla
        sta rtmp+1
        ldy #1
        lda (rtmp),y
        jsr ovmap
        ldy #2
        lda (rtmp),y
        sta rtmp2
        iny
        lda (rtmp),y
        sta rtmp2+1
        jmp (rtmp2)

; OVJSR: inline !byte n : !word addr ; restores the previous overlay
ovjsr:  pla
        sta rtmp
        pla
        sta rtmp+1
        lda rtmp                ; return past the 3 inline bytes
        clc
        adc #3
        tax
        lda rtmp+1
        adc #0
        pha
        phx
        lda curovl
        pha
        ldy #1
        lda (rtmp),y
        jsr ovmap
        ldy #2
        lda (rtmp),y
        sta rtmp2
        iny
        lda (rtmp),y
        sta rtmp2+1
        jsr .go
        pla                     ; previous overlay
        jmp ovmap
.go     jmp (rtmp2)
