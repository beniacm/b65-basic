; B65 BASIC - code overlays
; Altered version of BBC BASIC (Z80) v5 by R.T. Russell (zlib licence) - see LICENSE
;
; Rarely used modules (inline assembler, ...) are assembled to run at
; $E000-$FFF9 and copied at start-up to chip RAM bank 4 ($40000 + n*$2000).
; They are mapped into CPU block 7 ($E000-$FFFF) with the 45GS02 MAP
; instruction when needed. The core (bank 0, $2000-) is always visible.

OVBASE  = $040000

; OVMAP: A = overlay number ($FF = none): map it at $E000
ovmap:  sta curovl
        cmp #$ff
        beq .none
        asl                     ; offset>>8 = $320 + n*$20
        asl
        asl
        asl
        asl
        clc
        adc #$20
        tay
        lda #$83
        adc #0
        taz
        lda #0
        ldx #0
        map
        eom
        ldz #0
        rts
.none   lda #0
        tax
        tay
        taz
        map
        eom
        rts

; OVJMP: inline !byte n : !word addr  (does not return)
ovjmp:  pla
        sta rtmp
        pla
        sta rtmp+1
        ldy #1
        lda (rtmp),y
        jsr ovmap
        ldy #2
        lda (rtmp),y
        sta rtmp2
        iny
        lda (rtmp),y
        sta rtmp2+1
        jmp (rtmp2)

; OVJSR: inline !byte n : !word addr ; restores the previous overlay
ovjsr:  pla
        sta rtmp
        pla
        sta rtmp+1
        lda rtmp                ; return past the 3 inline bytes
        clc
        adc #3
        tax
        lda rtmp+1
        adc #0
        pha
        phx
        lda curovl
        pha
        ldy #1
        lda (rtmp),y
        jsr ovmap
        ldy #2
        lda (rtmp),y
        sta rtmp2
        iny
        lda (rtmp),y
        sta rtmp2+1
        jsr .go
        pla                     ; previous overlay
        jmp ovmap
.go     jmp (rtmp2)
