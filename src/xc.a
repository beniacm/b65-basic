; B65 BASIC - overlay 4: compiled numeric expressions
;
; EXPR (eval.a) maps this overlay (bank 4 $48000, CPU $E000) for program
; text and calls XCRUN. A numeric expression made of constants (TNUM and
; decimal/float text), numeric variables (@%, A%..Z%, name%, name),
; parentheses, unary - and +, and the binary operators is compiled once into
; a small RPN code, cached by its text address, and run from here: the value
; stack is in this window (absolute indexed), the top in acc/accx. Integer
; + - AND OR EOR and comparisons run inline; everything else (and any float
; or integer overflow) goes through the interpreter's BINOP, so the results
; and errors are the interpreter's. Strings, arrays, functions, indirection
; and anything else are never compiled (the interpreter evaluates them).
; The cache is flushed by CLEAR (RUN, program edits, LOAD, NEW, ...).

; window layout (CPU addresses while mapped): the code, XNEXT, then from
; the next page the slot tables, the value stack, the compile buffer and the
; code cache up to $FFEF
XNEXT   = ovl_xc_end    ; 2: next free byte in the code cache
XKLO    = (ovl_xc_end + 2 + 255) & $ff00 ; 256-entry direct-mapped table: key (text address)
XKHI    = XKLO + $100   ;   key high byte; 0 = empty slot
XCLO    = XKLO + $200   ;   code address; high 0 = not compilable
XCHI    = XKLO + $300
XMOD    = XKLO + $400   ;   kind of the slot (0 expression, 1 LET, 2 IF,
                        ;   3 GOTO/GOSUB line, $40 | retmask PROC/FN DEF)
XS0     = XKLO + $500   ; value stack: 4 mantissa bytes + exponent (32 each)
XS1     = XKLO + $520
XS2     = XKLO + $540
XS3     = XKLO + $560
XS4     = XKLO + $580
XCODE   = XKLO + $5a0   ; code cache ... $FFEF
; the compiler (overlay 2, xtra.a) and its workspace in bank 0: PARBUF
; slot 5's RETURN half (only used while a PROC binds a 6th RETURN formal)
XB      = $1b00         ; compile buffer (160)
xbp     = $1ba0
xdep    = $1ba1
xprec   = $1ba2
xfk     = $1ba3
xmode   = $1ba4         ; (also read by the run-time side)
xstore  = $1ba5         ; 12
xstlen  = $1bb1
xarr    = $1bb2         ; 10: array operands: field, handle, size, base (4)
xarrop  = $1bbc
xfirst  = $1bbd
xctp0   = $1bbe         ; 2
xend    = $1bc0         ; 2
xsps    = $1bc2         ; 2
xcsy    = $1bc4
xccop   = $1bc5
xcae    = $1bc6         ; 2
xcnst   = $1bc8         ; $FF: CARR may fold a constant index (reads)
xdyop   = $1bc9         ; '?' / '!' after a variable item (dyadic), else 0
XCEND   = $fff0
; bank-4 addresses for the resident XCFLUSH
XKHI_F  = XKHI - $e000 + $48000
XNEXT_F = XNEXT - $e000 + $48000

ovl_xc_img:
!pseudopc $e000 {
        jmp xcrun               ; $E000: expression
        jmp xclet               ; $E003: assignment statement
        jmp xcif                ; $E006: single-line IF ... THEN ... [ELSE ...]
        jmp xcline              ; $E009: GOTO/GOSUB line -> line address
        jmp xcdef               ; $E00C: PROC/FN call site -> DEF (cached)
        jmp xcdefput            ; $E00F: remember it
        jmp xcform              ; $E012: DEF (defkey) -> its numeric formals in PFB
        jmp xcformput           ; $E015: remember PFB for defkey

; XCFORM: kind 5, keyed by the DEF text after the name: a block in the
; code cache: count, text after the formals, (vptr, vtype) per formal.
; Carry clear: copied to PFB.
!zone xcform
xcform: lda #5
        jsr xfindd
        bcs .no
        lda XCLO,x
        sta .src+1
        lda XCHI,x
        sta .src+2
        ldx #0
.src    lda $ffff,x
        sta PFB,x
        inx
        cpx #21
        bne .src
        clc
        rts
.no     sec
        rts
xcformput:
        lda XNEXT               ; room for 21 bytes?
        clc
        adc #21
        lda XNEXT+1
        adc #0
        cmp #>XCEND
        bcc +
        jsr xflush
+       lda XNEXT
        sta .dst+1
        lda XNEXT+1
        sta .dst+2
        ldx #0
-       lda PFB,x
.dst    sta $ffff,x
        inx
        cpx #21
        bne -
        lda #5
        jsr xfindd              ; (the slot to use)
        lda defkey
        sta XKLO,x
        lda defkey+1
        sta XKHI,x
        lda #5
        sta XMOD,x
        lda XNEXT
        sta XCLO,x
        lda XNEXT+1
        sta XCHI,x
        lda XNEXT
        clc
        adc #21
        sta XNEXT
        bcc +
        inc XNEXT+1
+       rts

; XCDEF: tp -> the name after TPROC/TFN. Carry clear: ptr1 = DEF text after
; the name, tp after the name, retmask (slot kind $40 | retmask).
!zone xcdef
xcdef:  lda #$40
        jsr xfindt
        bcs .no
        lda XMOD,x
        and #$3f
        sta retmask
        lda XCLO,x
        sta ptr1
        lda XCHI,x
        sta ptr1+1
-       inw tp                  ; tp after the name (and its suffix)
        lda [tp],z
        jsr range1
        bcc -
        cmp #'$'
        beq +
        cmp #'%'
        beq +
        cmp #'&'
        bne ++
+       inw tp
++      clc
        rts
.no     sec
        rts
; XCDEFPUT: defkey = the name's text address, ptr1, tp, retmask as found
xcdefput:
        lda #$40
        jsr xfindd              ; (the slot to use)
        lda defkey
        sta XKLO,x
        lda defkey+1
        sta XKHI,x
        lda retmask
        ora #$40
        sta XMOD,x
        lda ptr1
        sta XCLO,x
        lda ptr1+1
        sta XCHI,x
        rts

; XCLINE: tp -> the argument of GOTO/GOSUB. Carry clear: ptr1 = the line,
; tp after the argument (a TLINO line number, cached: kind 3). Carry set:
; interpret it (computed target, or no such line: the interpreter reports).
!zone xcline
xcline: lda #3
        jsr xfindt
        bcs .m
        lda XCHI,x
        beq .no
        sta ptr1+1
        lda XCLO,x
        sta ptr1
        lda tp                  ; after TLINO and its 3 bytes
        clc
        adc #4
        sta tp
        bcc +
        inc tp+1
+       clc
        rts
.no     sec
        rts
.m      stx xslot
        lda tp
        sta xtp0
        lda tp+1
        sta xtp0+1
        lda #3
        sta XMOD,x
        lda [tp],z
        cmp #TLINO
        beq +
        lda tp                  ; computed: never
        sta XKLO,x
        lda tp+1
        sta XKHI,x
        lda #0
        sta XCHI,x
        sec
        rts
+       inw tp
        jsr decode0             ; lnum, tp after the number
        jsr findl
        bne .nf
        ldx xslot
        lda xtp0
        sta XKLO,x
        lda xtp0+1
        sta XKHI,x
        lda ptr1
        sta XCLO,x
        lda ptr1+1
        sta XCHI,x
        clc
        rts
.nf     ldx xslot               ; no such line: the interpreter reports it
        lda #0
        sta XKHI,x
        lda xtp0
        sta tp
        lda xtp0+1
        sta tp+1
        sec
        rts

; ---------------- slots ----------------
!zone xfind
; XFINDT (key tp) / XFINDD (key defkey), A = kind: two-way: the slot at
; key lo EOR hi and the one at that EOR $80. Carry clear: X = the slot
; with this key and kind (kind $40: PROC/FN DEF, $40 | retmask). Carry
; set: X = the slot to use (an empty one of the two, else alternately).
xfindt: ldx tp
        stx xkey
        ldx tp+1
        stx xkey+1
        bra +
xfindd: ldx defkey
        stx xkey
        ldx defkey+1
        stx xkey+1
+       sta xkind
        lda xkey
        eor xkey+1
        tax
        jsr .cmp
        bcc .r
        txa
        eor #$80
        tax
        jsr .cmp
        bcc .r
        txa                     ; miss: an empty slot? the first one first
        eor #$80
        tax
        lda XKHI,x
        beq .u
        txa
        eor #$80
        tax
        lda XKHI,x
        beq .u
        lda xrot                ; both used: replace alternately
        eor #$80
        sta xrot
        beq .u
        txa
        eor #$80
        tax
.u      sec
.r      rts
.cmp    lda XKHI,x
        cmp xkey+1
        lbne .no
        lda XKLO,x
        cmp xkey
        lbne .no
        lda XMOD,x
        cmp xkind
        beq .yes
        bit xkind               ; kind $40: any retmask
        bvs +
        sec
        rts
+       and #$c0
        cmp #$40
        lbne .no
.yes    clc
        rts
.no     sec
        rts

; ---------------- run ----------------
; XCRUN: tp -> expression (program text). Carry clear: acc/accx = value,
; tp after it. Carry set: interpret it.
!zone xcrun
; XCLET: tp -> an assignment (LET without the keyword): ?a=e !a=e v=e.
; Carry clear: done, tp after it. Carry set: interpret it.
; XCIF: tp -> the condition after IF. Carry clear: A = 0 true (tp after
; THEN), 1 false with ELSE (tp after ELSE), 2 false (tp at the CR).
xcif:   lda #2
        bra +
xclet:  lda #1
        bra +
xcrun:  lda #0
+       sta xmode
        lda tp                  ; first slot inline (the usual hit)
        eor tp+1
        tax
        lda XKLO,x
        cmp tp
        bne .two
        lda XKHI,x
        cmp tp+1
        bne .two
        lda XMOD,x
        cmp xmode
        beq .hit
.two    lda xmode
        jsr xfindt
        bcs .mis2
.hit    stx xslot
        lda XCHI,x
        beq .no
        tay
        lda XCLO,x
        jmp xexec
.no     sec
        rts
.mis2   stx xslot
.miss   jsr xccomp          ; (resident: maps the compiler in and back)
        bcs +
        lda xmode
        bne .new
        lda xbp                 ; a lone 0..255 or integer variable: the
        cmp #5                  ; interpreter is quicker
        beq .never
        cmp #6
        bne .new
        lda XB+2
        cmp #<l_vi
        bne .new
        bra .never
+       cmp #2                  ; temporary (variable not there yet): try again
        beq .no
.never
        ldx xslot               ; never: remember that
        lda xmode
        sta XMOD,x
        lda tp
        sta XKLO,x
        lda tp+1
        sta XKHI,x
        lda #0
        sta XCHI,x
        sec
        rts
.new    lda XNEXT               ; room in the cache?
        clc
        adc xbp
        lda XNEXT+1
        adc #0
        cmp #>XCEND
        bcc +
        jsr xflush
+       lda XNEXT
        sta .dst+1
        lda XNEXT+1
        sta .dst+2
        ldx #0
-       lda XB,x
.dst    sta $ffff,x
        inx
        cpx xbp
        bne -
        ldx xslot
        lda xmode
        sta XMOD,x
        lda tp
        sta XKLO,x
        lda tp+1
        sta XKHI,x
        lda XNEXT
        sta XCLO,x
        ldy XNEXT+1
        tya
        sta XCHI,x
        lda XNEXT
        clc
        adc xbp
        sta XNEXT
        bcc +
        inc XNEXT+1
+       lda XCLO,x
        jmp xexec

xflush:
        lda #0
        tax
-       sta XKHI,x
        inx
        bne -
        lda #<XCODE
        sta XNEXT
        lda #>XCODE
        sta XNEXT+1
        rts

; XEXEC: A/Y = code. X = value stack index, acc/accx = top of stack;
; Q operations clobber X and Y: handlers keep them in xsx/xsy around them.
xexec:  sta xnext+1
        sty xnext+2
        sta xrd+1
        sty xrd+2
        ldx #0
        ldy #2
xnext:  lda $ffff,y
        iny
        sta .j+1
.j      jmp xhand
xrd:    lda $ffff,y             ; operand byte
        iny
        rts

!macro spill {
        inx
        lda acc
        sta XS0,x
        lda acc+1
        sta XS1,x
        lda acc+2
        sta XS2,x
        lda acc+3
        sta XS3,x
        lda accx
        sta XS4,x
}
!macro pop {
        lda XS0,x
        sta arg
        lda XS1,x
        sta arg+1
        lda XS2,x
        sta arg+2
        lda XS3,x
        sta arg+3
        lda XS4,x
        sta argx
        dex
}

xspill: +spill
        rts
xpopr:  +pop
        rts

; ---- handlers: one page, the opcode is the low byte of the address ----
; stores (the last op of a statement): value in acc/accx
x_st1:  lda #1                  ; ?addr=value
        bra +
x_st4:  lda #4                  ; !addr=value
+       sta xcop
        jsr xpopr                  ; address -> arg
        stx xsx
        sty xsy
        lda argx
        beq +
        lda xstore              ; not an integer address: the interpreter
        jmp xbail
+       jsr xint
        lda arg+2
        ora arg+3
        bne .far
        lda arg                 ; bank 0: 16-bit (I/O visible)
        sta .n1+1
        sta .n4+1
        lda arg+1
        sta .n1+2
        sta .n4+2
        lda xcop
        cmp #1
        bne +
        lda acc
.n1     sta $ffff
        jmp xnext
+       phx
        ldx #3
-       lda acc,x
.n4     sta $ffff,x
        dex
        bpl -
        plx
        jmp xnext
.far    ldq arg                 ; 28-bit flat address
        stq fptr
        ldz #0
        lda acc
        sta [fptr],z
        lda xcop
        cmp #1
        beq +
        inz
        lda acc+1
        sta [fptr],z
        inz
        lda acc+2
        sta [fptr],z
        inz
        lda acc+3
        sta [fptr],z
        ldz #0
+       ldx xsx
        ldy xsy
        jmp xnext
x_svi:  jsr xint                ; integer variable (address in fptr, Z index)
        jsr xrd
        sta fptr
        jsr xrd
        sta fptr+1
        ldz #0
        lda acc
        sta (fptr),z
        inz
        lda acc+1
        sta (fptr),z
        inz
        lda acc+2
        sta (fptr),z
        inz
        lda acc+3
        sta (fptr),z
        ldz #0
        jmp xnext
x_svf:  jsr xrd                 ; variant variable: 5 bytes as they are
        sta .wf+1
        jsr xrd
        sta .wf+2
        phx
        ldx #4
-       lda acc,x
.wf     sta $ffff,x
        dex
        bpl -
        plx
        jmp xnext
; XINT: acc to an integer as STOREN does (SFIX; it reports Number too big)
xint:   lda accx
        beq +
        stx xsx
        sty xsy
        jsr sfix
        ldz #0
        ldx xsx
        ldy xsy
+       rts
; XBAIL: give the statement to the interpreter for good (nothing stored yet)
xbail:  ldx xslot
        lda #0
        sta XCHI,x
        sec
        rts
        !align 255, 0
xhand:
h_end:  ldy #0                  ; text address after it: code bytes 0, 1
        jsr xrd
        sta tp
        jsr xrd
        sta tp+1
        lda #0
        sta etype
        clc
        rts
h_k8:   jsr xspill                  ; integer 0..255
y_k8:   jsr xrd
        sta acc
        lda #0
        sta acc+1
        sta acc+2
        sta acc+3
        sta accx
        jmp xnext
h_k40:  jmp x_k40
h_vi:   jmp x_vi
h_vf:   jmp x_vf
l_k8:   jmp y_k8                ; first value: nothing to spill
l_k40:  jmp y_k40
l_vi:   jmp y_vi
l_vf:   jmp y_vf
h_add:  jmp x_add
h_sub:  jmp x_sub
h_and:  jmp x_and
h_or:   jmp x_or
h_eor:  jmp x_eor
h_eq:   jmp x_eq
h_ne:   jmp x_ne
h_lt:   jmp x_lt
h_gt:   jmp x_gt
h_le:   jmp x_le
h_ge:   jmp x_ge
h_gen:  jmp x_gen
h_ai:   jmp x_ai
h_aic:  jmp x_aic               ; constant index: element address in the code
l_aic:  jmp y_aic
h_af:   jmp x_af
h_sai:  jmp x_sai
h_saf:  jmp x_saf
h_if:   jmp x_if
h_mul:  jmp x_mul
h_st1:  jmp x_st1
h_st4:  jmp x_st4
h_svi:  jmp x_svi
h_svf:  jmp x_svf
h_neg:  jmp x_neg
h_ld1:  jmp x_ld1               ; ?addr / !addr (acc)
h_ld4:  jmp x_ld4
h_dld1: jmp x_dld1              ; base?offset / base!offset (bank 0)
h_dld4: jmp x_dld4
h_coll: jmp x_coll              ; COLLIDE(acc)
xhend:
!if xhend - xhand > 256 { !error "xc handlers exceed a page" }

!zone xld
; indirection reads (as GETVAR: a 16-bit address is bank 0 with I/O
; visible, a larger one is a 28-bit flat address); a float address: bail
x_dld1: lda #1                  ; base?offset: 16-bit sum, bank 0
        bra +
x_dld4: lda #4
+       sta xcop
        lda accx
        ora XS4,x
        bne .bl
        lda acc
        clc
        adc XS0,x
        sta acc
        lda acc+1
        adc XS1,x
        sta acc+1
        dex
        bra .nr
x_ld1:  lda #1
        bra +
x_ld4:  lda #4
+       sta xcop
        lda accx
        bne .bl
        lda acc+2
        ora acc+3
        lbne .far
.nr     lda acc
        sta .n1+1
        lda acc+1
        sta .n1+2
        phx
        ldx xcop
        dex
-
.n1     lda $ffff,x
        sta acc,x
        dex
        bpl -
        plx
        lda #0
        sta accx
        ldz xcop
        cpz #4
        beq .z
        sta acc+1
        sta acc+2
        sta acc+3
.z      ldz #0
        jmp xnext
.bl     jmp xbail
.far    stx xsx
        sty xsy
        ldq acc
        stq fptr
        ldx xsx
        ldy xsy
        ldz #0
        lda [fptr],z
        sta acc
        lda #0
        sta accx
        sta acc+1
        sta acc+2
        sta acc+3
        lda xcop
        cmp #1
        beq .z
        inz
        lda [fptr],z
        sta acc+1
        inz
        lda [fptr],z
        sta acc+2
        inz
        lda [fptr],z
        sta acc+3
        bra .z
; COLLIDE(n) as F_COLLIDE: partner of object n (low byte), -1 none
x_coll: lda accx
        bne .bl
        lda #$ff
        bit hw_k325t
        bpl +
        jsr colptr
        lda #$c1
        sta fptr
        lda acc
        sta [fptr],z
        lda #$c2
        sta fptr
        lda [fptr],z
+       sta acc
        ldz #0
        stz acc+1
        stz acc+2
        stz acc+3
        cmp #$ff
        bne .z
        sta acc+1
        sta acc+2
        sta acc+3
        bra .z
!zone xk40
x_k40:  jsr xspill                  ; 5 bytes (integer: exponent 0)
y_k40:
        jsr xrd
        sta acc
        jsr xrd
        sta acc+1
        jsr xrd
        sta acc+2
        jsr xrd
        sta acc+3
        jsr xrd
        sta accx
        jmp xnext
x_vi:   jsr xspill                  ; integer variable (4 bytes at a bank-0 address)
y_vi:
        jsr xrd
        sta fptr
        jsr xrd
        sta fptr+1
        ldz #0
        lda (fptr),z
        sta acc
        inz
        lda (fptr),z
        sta acc+1
        inz
        lda (fptr),z
        sta acc+2
        inz
        lda (fptr),z
        sta acc+3
        ldz #0
        stz accx
        jmp xnext
x_vf:   jsr xspill                  ; variant variable (5 bytes)
y_vf:
        jsr xrd
        sta .vf+1
        jsr xrd
        sta .vf+2
        phy
        ldy #4
.vf     lda $ffff,y
        sta acc,y
        dey
        bpl .vf
        ply
        jmp xnext

; generic: BINOP with the operator from the code (also for floats and
; integer overflow, which BINOP turns into floating point)
x_gen:  jsr xrd
        sta xcop
        jsr xpopr
xgo:    stx xsx
        sty xsy
        lda #0
        sta tmp5
        sta etype
        ldx xcop
        jsr binop
        ldz #0
        ldx xsx
        ldy xsy
        jmp xnext
!macro intop .op {
        jsr xpopr
        lda #.op
        sta xcop
        lda accx
        ora argx
        lbne xgo
}
x_add:  +intop OP_ADD
        stx xsx
        sty xsy
        lda arg+3
        eor acc+3
        bmi .ad                 ; different signs never overflow
        ldq arg
        clc
        adcq acc
        pha
        tza
        eor arg+3
        bmi xovf
        pla
        lbra x_lst
.ad     ldq arg
        clc
        adcq acc
        lbra x_lst
xovf    pla                     ; overflow: BINOP (floating point)
        ldz #0
        ldx xsx
        ldy xsy
        bra xgo
x_sub:  +intop OP_SUB
        stx xsx
        sty xsy
        lda arg+3
        eor acc+3
        bpl .sb                 ; same signs never overflow
        ldq arg
        sec
        sbcq acc
        pha
        tza
        eor arg+3
        bmi xovf
        pla
        lbra x_lst
.sb     ldq arg
        sec
        sbcq acc
        lbra x_lst
x_and:  +intop OP_AND
        stx xsx
        sty xsy
        ldq arg
        andq acc
        bra x_lst
x_or:   +intop OP_OR
        stx xsx
        sty xsy
        ldq arg
        orq acc
        bra x_lst
x_eor:  +intop OP_EOR
        stx xsx
        sty xsy
        ldq arg
        eorq acc
x_lst:  stq acc
        ldz #0
        ldx xsx
        ldy xsy
        jmp xnext
; IF: acc (as an integer, as EXPRI) zero -> the false address and its
; kind, else the then-address and 0; the END after it is not reached
x_if:   lda accx
        beq +
        stx xsx
        sty xsy
        jsr sfix
        ldz #0
        ldy xsy
+       lda acc
        ora acc+1
        ora acc+2
        ora acc+3
        beq .fl
        jsr xrd
        sta tp
        jsr xrd
        sta tp+1
        lda #0
        clc
        rts
.fl     iny
        iny
        jsr xrd
        sta tp
        jsr xrd
        sta tp+1
        jsr xrd
        clc
        rts

; integer *: hardware multiplier on the magnitudes; a product of 2^31 or
; more goes to BINOP (floating point, as the interpreter)
!macro negm .v {
        sec
        lda #0
        sbc .v
        sta .v
        lda #0
        sbc .v+1
        sta .v+1
        lda #0
        sbc .v+2
        sta .v+2
        lda #0
        sbc .v+3
        sta .v+3
}
x_mul:  +intop OP_MUL
        stx xsx
        sty xsy
        ldq acc
        stq xsav                ; (for BINOP)
        ldz #0
        lda arg+3
        eor acc+3
        sta xsgn
        bit arg+3
        bpl +
        +negm arg
+       bit acc+3
        bpl +
        +negm acc
+       ldq arg
        stq $d770
        ldq acc
        stq $d774
-       bit $d70f               ; multiplier busy
        bvs -
        ldz #0
        lda $d77c
        ora $d77d
        ora $d77e
        ora $d77f
        bne .big
        lda $d77b
        bmi .big
        ldq $d778
        stq acc
        ldz #0
        bit xsgn
        bpl +
        +negm acc
+       ldx xsx
        ldy xsy
        jmp xnext
.big    ldq xsav                ; BINOP with the original operands
        stq acc
        ldz #0
        ldx xsx
        inx                     ; (the left operand is still on the stack)
        lda XS0,x
        sta arg
        lda XS1,x
        sta arg+1
        lda XS2,x
        sta arg+2
        lda XS3,x
        sta arg+3
        ldx xsx
        ldy xsy
        jmp xgo

; ---- array elements: operands field (2), handle (2), size (2), base (4) ----
; XAEL: index xix (16-bit; the caller has checked that it is an integer
; below 65536), Y -> the 10 operand bytes, read through fptr. Checks that
; the name still refers to this array and the index is below the size,
; then fptr = element address (32-bit), Y past the operands. Bails (the
; interpreter then reports any error) otherwise.
xael:   jsr xchk
        ldy #4
        jmp xael2
; XCHK: fptr -> the operands, X/Y saved, name check unless the field is 0
xchk:   stx xsx
        sty xsy
        tya                     ; fptr -> operands (16-bit, in the window)
        clc
        adc xnext+1
        sta fptr
        lda xnext+2
        adc #0
        sta fptr+1
        ldy #1
        lda (fptr),y            ; field address 0: no check (see ARRSCAN)
        dey
        ora (fptr),y
        beq .nc
        lda (fptr),y            ; field address (and + 1)
        sta .f+1
        clc
        adc #1
        sta .g+1
        iny
        lda (fptr),y
        sta .f+2
        adc #0
        sta .g+2
        iny
.f      lda $ffff               ; field = handle?
        cmp (fptr),y
        lbne .bl2
        iny
.g      lda $ffff
        cmp (fptr),y
        lbne .bl2
.nc     rts
.bl2    pla                     ; (from XCHK: one more return address)
        pla
        jmp .bl
xael2:  lda xix                 ; index < size (Y = 4)
        cmp (fptr),y
        iny
        lda xix+1
        sbc (fptr),y
        lbcs .bl
        lda #0                  ; offset = index * 4 (+ index: * 5)
        sta xae+2
        lda xix+1
        sta xae+1
        lda xix
        asl
        rol xae+1
        rol xae+2
        asl
        rol xae+1
        rol xae+2
        ldx xel
        cpx #4
        beq +
        clc
        adc xix
        tax
        lda xae+1
        adc xix+1
        sta xae+1
        bcc ++
        inc xae+2
++      txa
+       ldy #6                  ; + base
        clc
        adc (fptr),y
        tax
        iny
        lda (fptr),y
        adc xae+1
        sta xae+1
        iny
        lda (fptr),y
        adc xae+2
        sta xae+2
        iny
        lda (fptr),y
        adc #0
        sta fptr+3
        stx fptr
        lda xae+1
        sta fptr+1
        lda xae+2
        sta fptr+2
        lda xsy                 ; Y past the operands
        clc
        adc #10
        tay
        ldx xsx
        ldz #0
        rts
.bl     ldx xsx                 ; (stack pointer: XBAIL resets it)
        pla
        pla
        jmp xbail
; index in acc/accx -> xix; bails unless an integer 0..65535
xidx:   lda accx
        ora acc+2
        ora acc+3
        bne +
        lda acc
        sta xix
        lda acc+1
        sta xix+1
        rts
+       pla
        pla
        jmp xbail
x_aic:  jsr xspill              ; a%(constant): operands as h_ai, base = element
y_aic:  lda #4
        sta xel
        jsr xchk
        ldy #6
        lda (fptr),y
        tax
        iny
        lda (fptr),y
        sta xae
        iny
        lda (fptr),y
        sta xae+1
        iny
        lda (fptr),y
        sta fptr+3
        stx fptr
        lda xae
        sta fptr+1
        lda xae+1
        sta fptr+2
        ldz #0
        lda [fptr],z
        sta acc
        inz
        lda [fptr],z
        sta acc+1
        inz
        lda [fptr],z
        sta acc+2
        inz
        lda [fptr],z
        sta acc+3
        ldz #0
        stz accx
        lda xsy
        clc
        adc #10
        tay
        ldx xsx
        jmp xnext
x_ai:   lda #4
        sta xel
        lda accx                ; index: an integer 0..65535
        ora acc+2
        ora acc+3
        lbne xsbl
        lda acc
        sta xix
        lda acc+1
        sta xix+1
        jsr xael
        lda [fptr],z
        sta acc
        inz
        lda [fptr],z
        sta acc+1
        inz
        lda [fptr],z
        sta acc+2
        inz
        lda [fptr],z
        sta acc+3
        ldz #0
        lda #0
        sta accx
        jmp xnext
x_af:   lda #5
        sta xel
        jsr xidx
        jsr xael
        sty xsy
        ldy #0
-       lda [fptr],z
        sta acc,y
        inz
        iny
        cpy #5
        bne -
        ldz #0
        ldy xsy
        jmp xnext
x_sai:  lda #4                  ; a%(i)=value: index below the value
        bra +
x_saf:  lda #5
+       sta xel
        cmp #4
        bne +
        jsr xint                ; (as STOREN: SFIX)
+       lda XS4,x               ; the index: an integer 0..65535?
        ora XS2,x
        ora XS3,x
        bne xsbl
        lda XS0,x
        sta xix
        lda XS1,x
        sta xix+1
        dex
        jsr xael
        lda acc
        sta [fptr],z
        inz
        lda acc+1
        sta [fptr],z
        inz
        lda acc+2
        sta [fptr],z
        inz
        lda acc+3
        sta [fptr],z
        lda xel
        cmp #5
        bne +
        inz
        lda accx
        sta [fptr],z
+       ldz #0
        jmp xnext
xsbl    jmp xbail

x_neg:  lda accx                ; as ITEM's unary minus
        beq +
        lda acc+3
        eor #$80
        sta acc+3
        jmp xnext
+       stx xsx
        sty xsy
        lda acc+3               ; -(-2^31) needs floating point
        cmp #$80
        bne .ng
        lda acc
        ora acc+1
        ora acc+2
        bne .ng
        jsr sfloat
        lda acc+3
        eor #$80
        sta acc+3
        bra +
.ng     jsr ineg
+       ldx xsx
        ldy xsy
        jmp xnext
; comparisons: integers inline (TRUE -1 / FALSE 0), otherwise BINOP
!macro cmpop .op {
        +intop .op
        jsr xcmp
}
x_eq:   +cmpop OP_EQ
        lbeq xtrue
        lbra xfalse
x_ne:   +cmpop OP_NE
        lbne xtrue
        lbra xfalse
x_lt:   +cmpop OP_LT
        lbmi xtrue
        lbra xfalse
x_gt:   +cmpop OP_GT
        beq xfalse
        bpl xtrue
        bra xfalse
x_le:   +cmpop OP_LE
        bmi xtrue
        beq xtrue
        bra xfalse
x_ge:   +cmpop OP_GE
        bpl xtrue
xfalse: lda #0
        bra +
xtrue:  lda #$ff
+       sta acc
        sta acc+1
        sta acc+2
        sta acc+3
        jmp xnext
; XCMP: A = -1 / 0 / 1 (flags from it) for arg <, =, > acc (signed)
xcmp:   lda arg+3
        eor #$80
        sta arg+3
        lda acc+3
        eor #$80
        sta acc+3
        lda arg+3
        cmp acc+3
        bne .d
        lda arg+2
        cmp acc+2
        bne .d
        lda arg+1
        cmp acc+1
        bne .d
        lda arg
        cmp acc
        bne .d
        lda #0
        rts
.d      bcc +
        lda #1
        rts
+       lda #$ff
        rts

; workspace (in the window)
xslot   !byte 0
xkey    !word 0
xkind   !byte 0
xrot    !byte 0
xsx     !byte 0
xsy     !byte 0
xcop     !byte 0
xel     !byte 0
xix     !fill 5, 0
xae     !fill 3, 0
xsgn    !byte 0
xsav    !byte 0, 0, 0, 0
xtp0    !word 0
ovl_xc_end:
}
; (tools/packovl.py checks that XCODE <= $F800)
