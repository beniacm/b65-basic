; B65 BASIC - overlay 2: whole-array arithmetic and other v5 extras
; Altered version of BBC BASIC (Z80) v5 by R.T. Russell (zlib licence) - see LICENSE

; workspace (bank 0, absolute): $1DD4..$1DEF
xb1     = $1dd4         ; 2 first source block
xb2     = $1dd6         ; 2 second source block (0 = scalar)
xop     = $1dd8         ; operator
xcnt    = $1dd9         ; 2 element count
xp0     = $1ddb         ; 2 destination element pointer
xp1     = $1ddd         ; 2 source 1 element pointer
xp2     = $1ddf         ; 2 source 2 element pointer
xsc     = $1de1         ; 5 scalar value
xi      = $1de6         ; 2
xj      = $1de8         ; 2
xn      = $1dea         ; 2 dot: rows, inner, cols
xk      = $1dec         ; 2
xm      = $1dee         ; 2
XP      = $1fc8         ; 5 x 4: element addresses (32-bit: arrays may be far)
X0      = 0             ;   destination
X1      = 4             ;   source 1
X2      = 8             ;   source 2
XB1     = 12            ;   dot: first element of b
XB2     = 16            ;   dot: first element of c

ovl_xtra_img:
!pseudopc $e000 {
; ---- a() = b() OP c() | b() OP scalar | scalar OP b() | -b() | b() . c() ----
; numeric arrays: + - * /; string arrays: + (concatenation)
XSS     = $1a00         ; string scalar (length, text): PARBUF slot 5, free here
xt1     = $1fe0         ; element type of b()
xt2     = $1fe1         ; element type of c()
xtsc    = $1fe2         ; type of the scalar
xflag   = $1fe3         ; bit 7: the scalar is the LEFT operand
; entry: ablk/avt = destination, ptr2 = first source block (vtype = its
; type), tp at the operator after it
!zone arrarith
arrarith:
        lda vtype
        sta xt1
        lda ptr2
        sta xb1
        lda ptr2+1
        sta xb1+1
        lda #0
        sta xflag
        jsr nxt
        inw tp
        cmp #'.'
        bne +
        lda avt                 ; matrix product: numeric only
        ora xt1
        bpl ++
        lda #6
        jmp error
++      jmp dotprod
+       jsr .opc
        stx xop
        lda #0
        sta xb2
        sta xb2+1
        jsr nxt
        jsr arrref              ; second operand: array or scalar
        bne .sc
        lda vtype
        sta xt2
        lda ptr2
        sta xb2
        lda ptr2+1
        sta xb2+1
        lbra .go
.sc     jsr expr
        jsr .savesc
        lbra .go
; .OPC: A = operator character -> X = OP_xx (Mistake if none)
.opc    ldx #OP_ADD
        cmp #'+'
        beq +
        ldx #OP_SUB
        cmp #'-'
        beq +
        ldx #OP_MUL
        cmp #'*'
        beq +
        ldx #OP_FDIV
        cmp #'/'
        beq +
        jmp mistake
+       rts
; .SAVESC: keep the scalar value (acc or ACCS)
.savesc lda etype
        sta xtsc
        bmi +
        ldx #4
-       lda acc,x
        sta xsc,x
        dex
        bpl -
        rts
+       ldx slen
        stx XSS
-       dex
        cpx #$ff
        beq +
        lda ACCS,x
        sta XSS+1,x
        bra -
+       rts
; .LDSC: scalar -> acc or ACCS
.ldsc   lda xtsc
        sta etype
        bmi +
        ldx #4
-       lda xsc,x
        sta acc,x
        dex
        bpl -
        rts
+       ldx XSS
        stx slen
-       dex
        cpx #$ff
        beq +
        lda XSS+1,x
        sta ACCS,x
        bra -
+       rts
; ARRPRE (from arrlet, "a() = ..." without an array first): handles
; "a() = -b()" and "a() = item OP b()" (the scalar is one item: a number,
; variable, string, function or bracketed expression). Back to the core at
; arrle1 (ordinary expression) or arrle1x (value of a fill already in acc).
arrpre: jsr .hasarr
        bcs +
        jmp arrle1
+       jsr nxt
        cmp #'-'
        bne .it
        lda tp
        pha
        lda tp+1
        pha
        inw tp
        jsr nxt
        jsr arrref
        bne .nm
        pla                     ; -b(): 0 - b()
        pla
        lda #0
        ldx #4
-       sta acc,x
        dex
        bpl -
        sta etype
        ldx #OP_SUB
        stx xop
        jsr .savesc
        lda #$80
        sta xflag
        lda #0
        sta xb2
        sta xb2+1
        jmp .have
.nm     pla
        jsr settph
        pla
        sta tp
.it     jsr item
        jsr nxt
        cmp #'+'
        beq .op2
        cmp #'-'
        beq .op2
        cmp #'*'
        beq .op2
        cmp #'/'
        beq .op2
        jsr termq               ; just a value after all: fill with it
        bne +
        jmp arrle1x
+       jmp mistake
.op2    jsr .opc
        inw tp
        bra arrsc
; .HASARR: carry set if "()" follows in this statement (outside strings)
.hasarr ldz #0
-       lda [tp],z
        cmp #CR
        beq .no
        cmp #':'
        beq .no
        cmp #TELSE
        beq .no
        cmp #'"'
        bne +
--      inz
        beq .no
        lda [tp],z
        cmp #CR
        beq .no
        cmp #'"'
        bne --
        bra .nx
+       cmp #'('
        bne .nx
        inz
        beq .no
        lda [tp],z
        cmp #')'
        bne -
        ldz #0
        sec
        rts
.nx     inz
        bne -
.no     ldz #0
        clc
        rts
; ARRSC: X = op, scalar in acc/ACCS, tp at the array: scalar OP b()
arrsc:  stx xop
        jsr .savesc
        lda #$80
        sta xflag
        lda #0
        sta xb2
        sta xb2+1
        jsr nxt
        jsr arrref
        beq .have
        jmp syntax
.have   lda vtype
        sta xt1
        lda ptr2
        sta xb1
        lda ptr2+1
        sta xb1+1
.go     ; types: string destination -> '+' with string operands only
        lda avt
        bpl .num
        lda xop
        cmp #OP_ADD
        bne .tm
        lda xt1
        bpl .tm
        lda xb2
        ora xb2+1
        beq +
        lda xt2
        bpl .tm
        bra .sz
+       lda xtsc
        bpl .tm
        bra .sz
.num    lda xt1
        bmi .tm
        lda xb2
        ora xb2+1
        beq +
        lda xt2
        bmi .tm
        bra .sz
+       lda xtsc
        bpl .sz
.tm     lda #6                  ; Type mismatch
        jmp error
.sz     ; sizes: destination, source 1 (, source 2) must have the same count
        lda ablk
        sta ptr2
        lda ablk+1
        sta ptr2+1
        jsr arrsize
        lda #X0
        jsr .xput
        lda tmpw
        sta xcnt
        lda tmpw+1
        sta xcnt+1
        lda xb1
        sta ptr2
        lda xb1+1
        sta ptr2+1
        jsr arrsize
        jsr .same
        lda #X1
        jsr .xput
        lda xb2
        ora xb2+1
        beq .loop
        lda xb2
        sta ptr2
        lda xb2+1
        sta ptr2+1
        jsr arrsize
        jsr .same
        lda #X2
        jsr .xput
.loop   lda xcnt
        ora xcnt+1
        bne +
        jmp xeq
+       bit xflag               ; left operand: scalar or b[i]
        bpl +
        jsr .ldsc
        bra ++
+       jsr .ld1
++      jsr movleft             ; -> arg / STRBUF (tmp5 = type)
        bit xflag               ; right operand: b[i], c[i] or scalar
        bpl +
        jsr .ld1
        bra .bin
+       lda xb2
        ora xb2+1
        beq +
        lda #X2
        ldy xt2
        jsr .xsett
        jsr loadvar
        bra .bin
+       jsr .ldsc
.bin    lda avt
        bpl +
        jsr sconcat             ; STRBUF + ACCS -> ACCS
        lda #$80
        sta etype
        bra ++
+       lda #0
        sta tmp5
        ldx xop
        jsr binop
++      lda #X0
        jsr .xset
        jsr storevar
        jsr .step
        jmp .loop
.ld1    lda #X1                 ; b[i] -> acc / ACCS
        ldy xt1
        jsr .xsett
        jmp loadvar
.step   lda #X0                 ; advance all pointers by their element sizes
        ldy avt
        jsr .xaddt
        lda #X1
        ldy xt1
        jsr .xaddt
        lda #X2
        ldy xt2
        jsr .xaddt
        lda xcnt
        bne +
        dec xcnt+1
+       dec xcnt
        rts
.same   lda tmpw
        cmp xcnt
        bne .bad
        lda tmpw+1
        cmp xcnt+1
        bne .bad
        rts
.bad    lda #15                 ; Bad subscript (sizes differ)
        jmp error
; .XPUT: XP[A] = ap   .XSET: ap = XP[A], element (type avt) -> variable
; .XADD: XP[A] += element size
.xput   tax
        ldy #0
-       lda ap,y
        sta XP,x
        inx
        iny
        cpy #4
        bne -
        rts
.xset   ldy avt
.xsett  sty vtype               ; (Y = element type)
        tax
        ldy #0
-       lda XP,x
        sta ap,y
        inx
        iny
        cpy #4
        bne -
        jmp setel
.xadd   ldy avt
.xaddt  tax
        tya
        bpl +
        lda #4
+       clc
        adc XP,x
        sta XP,x
        bcc +
        inc XP+1,x
        bne +
        inc XP+2,x
+       rts
xput = .xput
xset = .xset
xadd = .xadd

; ---- matrix product: a() = b() . c() ----
; b is n x k (1-D: 1 x k), c is k x m (1-D: k x 1); a must have n*m elements
!zone dotprod
dotprod:
        jsr nxt
        jsr arrref
        beq +
        jmp syntax
+       lda ptr2
        sta xb2
        lda ptr2+1
        sta xb2+1
        ; b dimensions
        lda xb1
        sta ptr2
        lda xb1+1
        sta ptr2+1
        jsr .dims               ; -> xi = rows, xj = cols
        lda xi
        sta xn
        lda xi+1
        sta xn+1
        lda xj
        sta xk
        lda xj+1
        sta xk+1
        lda xb2
        sta ptr2
        lda xb2+1
        sta ptr2+1
        jsr .dims
        jsr blkap               ; c 1-D: a column vector (k x 1)
        lda [ap],z
        cmp #1
        bne +
        lda xj
        sta xi
        lda xj+1
        sta xi+1
        lda #1
        sta xj
        lda #0
        sta xj+1
+       lda xi                  ; inner sizes must agree
        cmp xk
        lbne .bad
        lda xi+1
        cmp xk+1
        lbne .bad
        lda xj
        sta xm
        lda xj+1
        sta xm+1
        ; element pointers of b and c
        lda xb1
        sta ptr2
        lda xb1+1
        sta ptr2+1
        jsr arrsize
        lda #XB1                ; first element of b
        jsr xput
        lda xb2
        sta ptr2
        lda xb2+1
        sta ptr2+1
        jsr arrsize
        lda #XB2
        jsr xput
        lda ablk
        sta ptr2
        lda ablk+1
        sta ptr2+1
        jsr arrsize             ; destination count must be n*m
        lda #X0
        jsr xput
        ; for r = 0..n-1, for q = 0..m-1: a[r,q] = sum_j b[r,j]*c[j,q]
        lda #0
        sta xi
        sta xi+1
.r      lda xi
        cmp xn
        lda xi+1
        sbc xn+1
        bcc +
        jmp xeq
+       lda #0
        sta xj
        sta xj+1
.q      lda xj
        cmp xm
        lda xj+1
        sbc xm+1
        bcs .nr
        jsr .cell
        inc xj
        bne .q
        inc xj+1
        bra .q
.nr     inc xi
        bne .r
        inc xi+1
        bra .r
.bad    lda #15
        jmp error
; one result cell: sum over t of b[xi,t] * c[t,xj]
.cell   lda #0
        sta acc
        sta acc+1
        sta acc+2
        sta acc+3
        sta accx
        sta etype
        lda #0
        sta xp2                 ; t
        sta xp2+1
.t      lda xp2
        cmp xk
        lda xp2+1
        sbc xk+1
        bcs .st
        jsr pushval             ; running sum
        ; b[xi, t] at xb1 + (xi*k + t)*5
        lda xi
        ldx xi+1
        ldy #0
        jsr .mulk               ; tmpw = xi*k
        lda tmpw
        clc
        adc xp2
        sta tmpw
        lda tmpw+1
        adc xp2+1
        sta tmpw+1
        lda #XB1
        jsr .elem
        jsr loadn
        jsr movleft
        ; c[t, xj] at xb2 + (t*m + xj)*5
        lda xp2
        ldx xp2+1
        ldy #1
        jsr .mulk               ; tmpw = t*m
        lda tmpw
        clc
        adc xj
        sta tmpw
        lda tmpw+1
        adc xj+1
        sta tmpw+1
        lda #XB2
        jsr .elem
        jsr loadn
        lda #0
        sta tmp5
        ldx #OP_MUL
        jsr binop               ; product in acc
        jsr movleft             ; -> arg
        jsr popacc              ; running sum -> acc
        lda #0
        sta tmp5
        ldx #OP_ADD
        jsr binop
        inc xp2
        bne .t
        inc xp2+1
        lbra .t
.st     lda #X0                 ; store, next destination element
        jsr xset
        jsr storevar
        lda #X0
        jmp xadd
; .mulk: A/X * (Y=0: k, Y=1: m) -> tmpw (hardware multiplier)
.mulk   sta $d770
        stx $d771
        lda #0
        sta $d772
        sta $d773
        sta $d776
        sta $d777
        cpy #0
        bne +
        lda xk
        sta $d774
        lda xk+1
        sta $d775
        bra ++
+       lda xm
        sta $d774
        lda xm+1
        sta $d775
++
-       bit $d70f
        bvs -
        lda $d778
        sta tmpw
        lda $d779
        sta tmpw+1
        rts
; .elem: A = XP index of the first element; tmpw = index -> variable (size avt)
.elem   tax
        ldy #0
-       lda XP,x
        sta ap,y
        inx
        iny
        cpy #4
        bne -
        lda avt
        sta vtype
        bpl +
        lda #4
+       sta $d774
        lda #0
        sta $d775
        sta $d776
        sta $d777
        sta $d772
        sta $d773
        lda tmpw
        sta $d770
        lda tmpw+1
        sta $d771
-       bit $d70f
        bvs -
        lda $d778
        clc
        adc ap
        sta ap
        lda $d779
        adc ap+1
        sta ap+1
        lda $d77a
        adc ap+2
        sta ap+2
        jmp setel
; .dims: ptr2 = block -> xi = rows, xj = cols (1-D: 1 x size)
.dims   jsr blkap
        lda [ap],z
        cmp #2
        beq .two
        cmp #1
        beq +
        jmp .bad
+       lda #1
        sta xi
        lda #0
        sta xi+1
        ldz #1
        lda [ap],z
        sta xj
        inz
        lda [ap],z
        sta xj+1
        ldz #0
        rts
.two    ldz #1
        lda [ap],z
        sta xi
        inz
        lda [ap],z
        sta xi+1
        inz
        lda [ap],z
        sta xj
        inz
        lda [ap],z
        sta xj+1
        ldz #0
        rts
ovl_xtra_end:
}
