; B65 BASIC - overlay 2: whole-array arithmetic and other v5 extras
; Altered version of BBC BASIC (Z80) v5 by R.T. Russell (zlib licence) - see LICENSE

; workspace (bank 0, absolute): $1DD4..$1DEF
xb1     = $1dd4         ; 2 first source block
xb2     = $1dd6         ; 2 second source block (0 = scalar)
xop     = $1dd8         ; operator
xcnt    = $1dd9         ; 2 element count
xp0     = $1ddb         ; 2 destination element pointer
xp1     = $1ddd         ; 2 source 1 element pointer
xp2     = $1ddf         ; 2 source 2 element pointer
xsc     = $1de1         ; 5 scalar value
xi      = $1de6         ; 2
xj      = $1de8         ; 2
xn      = $1dea         ; 2 dot: rows, inner, cols
xk      = $1dec         ; 2
xm      = $1dee         ; 2
XP      = $1fc8         ; 5 x 4: element addresses (32-bit: arrays may be far)
X0      = 0             ;   destination
X1      = 4             ;   source 1
X2      = 8             ;   source 2
XB1     = 12            ;   dot: first element of b
XB2     = 16            ;   dot: first element of c

ovl_xtra_img:
!pseudopc $e000 {
; ---- a() = b() OP c() | b() OP scalar | scalar OP b() | -b() | b() . c() ----
; numeric arrays: + - * /; string arrays: + (concatenation)
XSS     = $1a00         ; string scalar (length, text): PARBUF slot 5, free here
xt1     = $1fe0         ; element type of b()
xt2     = $1fe1         ; element type of c()
xtsc    = $1fe2         ; type of the scalar
xflag   = $1fe3         ; bit 7: the scalar is the LEFT operand
xfstep  = $1fe9         ; FASTI: 4 if c() steps, 0 for a scalar
; entry: ablk/avt = destination, ptr2 = first source block (vtype = its
; type), tp at the operator after it
!zone arrarith
arrarith:
        lda vtype
        sta xt1
        lda ptr2
        sta xb1
        lda ptr2+1
        sta xb1+1
        lda #0
        sta xflag
        jsr nxt
        inw tp
        cmp #'.'
        bne +
        lda avt                 ; matrix product: numeric only
        ora xt1
        bpl ++
        lda #6
        jmp error
++      jmp dotprod
+       jsr .opc
        stx xop
        lda #0
        sta xb2
        sta xb2+1
        jsr nxt
        jsr arrref              ; second operand: array or scalar
        bne .sc
        lda vtype
        sta xt2
        lda ptr2
        sta xb2
        lda ptr2+1
        sta xb2+1
        lbra .go
.sc     jsr expr
        jsr .savesc
        lbra .go
; .OPC: A = operator character -> X = OP_xx (Mistake if none)
.opc    ldx #OP_ADD
        cmp #'+'
        beq +
        ldx #OP_SUB
        cmp #'-'
        beq +
        ldx #OP_MUL
        cmp #'*'
        beq +
        ldx #OP_FDIV
        cmp #'/'
        beq +
        ldx #OP_AND
        cmp #TAND
        beq +
        jmp mistake
+       rts
; .SAVESC: keep the scalar value (acc or ACCS)
.savesc lda etype
        sta xtsc
        bmi +
        ldx #4
-       lda acc,x
        sta xsc,x
        dex
        bpl -
        rts
+       ldx slen
        stx XSS
-       dex
        cpx #$ff
        beq +
        lda ACCS,x
        sta XSS+1,x
        bra -
+       rts
; .LDSC: scalar -> acc or ACCS
.ldsc   lda xtsc
        sta etype
        bmi +
        ldx #4
-       lda xsc,x
        sta acc,x
        dex
        bpl -
        rts
+       ldx XSS
        stx slen
-       dex
        cpx #$ff
        beq +
        lda XSS+1,x
        sta ACCS,x
        bra -
+       rts
; ARRPRE (from arrlet, "a() = ..." without an array first): handles
; "a() = -b()" and "a() = item OP b()" (the scalar is one item: a number,
; variable, string, function or bracketed expression). Back to the core at
; arrle1 (ordinary expression) or arrle1x (value of a fill already in acc).
arrpre: jsr .hasarr
        bcs +
        jmp arrle1
+       jsr nxt
        cmp #'-'
        bne .it
        lda tp
        pha
        lda tp+1
        pha
        inw tp
        jsr nxt
        jsr arrref
        bne .nm
        pla                     ; -b(): 0 - b()
        pla
        lda #0
        ldx #4
-       sta acc,x
        dex
        bpl -
        sta etype
        ldx #OP_SUB
        stx xop
        jsr .savesc
        lda #$80
        sta xflag
        lda #0
        sta xb2
        sta xb2+1
        jmp .have
.nm     pla
        jsr settph
        pla
        sta tp
.it     jsr item
        jsr nxt
        cmp #'+'
        beq .op2
        cmp #'-'
        beq .op2
        cmp #'*'
        beq .op2
        cmp #'/'
        beq .op2
        jsr termq               ; just a value after all: fill with it
        bne +
        jmp arrle1x
+       jmp mistake
.op2    jsr .opc
        inw tp
        bra arrsc
; .HASARR: carry set if "()" follows in this statement (outside strings)
.hasarr ldz #0
-       lda [tp],z
        cmp #CR
        beq .no
        cmp #':'
        beq .no
        cmp #TELSE
        beq .no
        cmp #'"'
        bne +
--      inz
        beq .no
        lda [tp],z
        cmp #CR
        beq .no
        cmp #'"'
        bne --
        bra .nx
+       cmp #'('
        bne .nx
        inz
        beq .no
        lda [tp],z
        cmp #')'
        bne -
        ldz #0
        sec
        rts
.nx     inz
        bne -
.no     ldz #0
        clc
        rts
; ARRSC: X = op, scalar in acc/ACCS, tp at the array: scalar OP b()
arrsc:  stx xop
        jsr .savesc
        lda #$80
        sta xflag
        lda #0
        sta xb2
        sta xb2+1
        jsr nxt
        jsr arrref
        beq .have
        jmp syntax
.have   lda vtype
        sta xt1
        lda ptr2
        sta xb1
        lda ptr2+1
        sta xb1+1
.go     ; types: string destination -> '+' with string operands only
        lda avt
        bpl .num
        lda xop
        cmp #OP_ADD
        bne .tm
        lda xt1
        bpl .tm
        lda xb2
        ora xb2+1
        beq +
        lda xt2
        bpl .tm
        bra .sz
+       lda xtsc
        bpl .tm
        bra .sz
.num    lda xt1
        bmi .tm
        lda xb2
        ora xb2+1
        beq +
        lda xt2
        bmi .tm
        bra .sz
+       lda xtsc
        bpl .sz
.tm     lda #6                  ; Type mismatch
        jmp error
.sz     ; sizes: destination, source 1 (, source 2) must have the same count
        lda ablk
        sta ptr2
        lda ablk+1
        sta ptr2+1
        jsr arrsize
        lda #X0
        jsr .xput
        lda tmpw
        sta xcnt
        lda tmpw+1
        sta xcnt+1
        lda xb1
        sta ptr2
        lda xb1+1
        sta ptr2+1
        jsr arrsize
        jsr .same
        lda #X1
        jsr .xput
        lda xb2
        ora xb2+1
        beq .loop0
        lda xb2
        sta ptr2
        lda xb2+1
        sta ptr2+1
        jsr arrsize
        jsr .same
        lda #X2
        jsr .xput
.loop0  jsr fasti               ; integer + - (* scalar): a tight loop first
.loop   lda xcnt
        ora xcnt+1
        bne +
        jmp xeq
+       bit xflag               ; left operand: scalar or b[i]
        bpl +
        jsr .ldsc
        bra ++
+       jsr .ld1
++      jsr movleft             ; -> arg / STRBUF (tmp5 = type)
        bit xflag               ; right operand: b[i], c[i] or scalar
        bpl +
        jsr .ld1
        bra .bin
+       lda xb2
        ora xb2+1
        beq +
        lda #X2
        ldy xt2
        jsr .xsett
        jsr loadvar
        bra .bin
+       jsr .ldsc
.bin    lda avt
        bpl +
        jsr sconcat             ; STRBUF + ACCS -> ACCS
        lda #$80
        sta etype
        bra ++
+       lda #0
        sta tmp5
        ldx xop
        jsr binop
++      lda #X0
        jsr .xset
        jsr storevar
        jsr .step
        jmp .loop
.ld1    lda #X1                 ; b[i] -> acc / ACCS
        ldy xt1
        jsr .xsett
        jmp loadvar
.step   lda #X0                 ; advance all pointers by their element sizes
        ldy avt
        jsr .xaddt
        lda #X1
        ldy xt1
        jsr .xaddt
        lda #X2
        ldy xt2
        jsr .xaddt
        lda xcnt
        bne +
        dec xcnt+1
+       dec xcnt
        rts
.same   lda tmpw
        cmp xcnt
        bne .bad
        lda tmpw+1
        cmp xcnt+1
        bne .bad
        rts
.bad    lda #15                 ; Bad subscript (sizes differ)
        jmp error
; .XPUT: XP[A] = ap   .XSET: ap = XP[A], element (type avt) -> variable
; .XADD: XP[A] += element size
.xput   tax
        ldy #0
-       lda ap,y
        sta XP,x
        inx
        iny
        cpy #4
        bne -
        rts
.xset   ldy avt
.xsett  sty vtype               ; (Y = element type)
        tax
        ldy #0
-       lda XP,x
        sta ap,y
        inx
        iny
        cpy #4
        bne -
        jmp setel
.xadd   ldy avt
.xaddt  tax
        tya
        bpl +
        lda #4
+       clc
        adc XP,x
        sta XP,x
        bcc +
        inc XP+1,x
        bne +
        inc XP+2,x
+       rts
xput = .xput
xset = .xset
xadd = .xadd

; ---- matrix product: a() = b() . c() ----
; b is n x k (1-D: 1 x k), c is k x m (1-D: k x 1); a must have n*m elements
!zone dotprod
dotprod:
        jsr nxt
        jsr arrref
        beq +
        jmp syntax
+       lda ptr2
        sta xb2
        lda ptr2+1
        sta xb2+1
        ; b dimensions
        lda xb1
        sta ptr2
        lda xb1+1
        sta ptr2+1
        jsr .dims               ; -> xi = rows, xj = cols
        lda xi
        sta xn
        lda xi+1
        sta xn+1
        lda xj
        sta xk
        lda xj+1
        sta xk+1
        lda xb2
        sta ptr2
        lda xb2+1
        sta ptr2+1
        jsr .dims
        jsr blkap               ; c 1-D: a column vector (k x 1)
        lda [ap],z
        cmp #1
        bne +
        lda xj
        sta xi
        lda xj+1
        sta xi+1
        lda #1
        sta xj
        lda #0
        sta xj+1
+       lda xi                  ; inner sizes must agree
        cmp xk
        lbne .bad
        lda xi+1
        cmp xk+1
        lbne .bad
        lda xj
        sta xm
        lda xj+1
        sta xm+1
        ; element pointers of b and c
        lda xb1
        sta ptr2
        lda xb1+1
        sta ptr2+1
        jsr arrsize
        lda #XB1                ; first element of b
        jsr xput
        lda xb2
        sta ptr2
        lda xb2+1
        sta ptr2+1
        jsr arrsize
        lda #XB2
        jsr xput
        lda ablk
        sta ptr2
        lda ablk+1
        sta ptr2+1
        jsr arrsize             ; destination count must be n*m
        lda #X0
        jsr xput
        ; for r = 0..n-1, for q = 0..m-1: a[r,q] = sum_j b[r,j]*c[j,q]
        lda #0
        sta xi
        sta xi+1
.r      lda xi
        cmp xn
        lda xi+1
        sbc xn+1
        bcc +
        jmp xeq
+       lda #0
        sta xj
        sta xj+1
.q      lda xj
        cmp xm
        lda xj+1
        sbc xm+1
        bcs .nr
        jsr .cell
        inc xj
        bne .q
        inc xj+1
        bra .q
.nr     inc xi
        bne .r
        inc xi+1
        bra .r
.bad    lda #15
        jmp error
; one result cell: sum over t of b[xi,t] * c[t,xj]
.cell   lda #0
        sta acc
        sta acc+1
        sta acc+2
        sta acc+3
        sta accx
        sta etype
        lda #0
        sta xp2                 ; t
        sta xp2+1
.t      lda xp2
        cmp xk
        lda xp2+1
        sbc xk+1
        bcs .st
        jsr pushval             ; running sum
        ; b[xi, t] at xb1 + (xi*k + t)*5
        lda xi
        ldx xi+1
        ldy #0
        jsr .mulk               ; tmpw = xi*k
        lda tmpw
        clc
        adc xp2
        sta tmpw
        lda tmpw+1
        adc xp2+1
        sta tmpw+1
        lda #XB1
        jsr .elem
        jsr loadn
        jsr movleft
        ; c[t, xj] at xb2 + (t*m + xj)*5
        lda xp2
        ldx xp2+1
        ldy #1
        jsr .mulk               ; tmpw = t*m
        lda tmpw
        clc
        adc xj
        sta tmpw
        lda tmpw+1
        adc xj+1
        sta tmpw+1
        lda #XB2
        jsr .elem
        jsr loadn
        lda #0
        sta tmp5
        ldx #OP_MUL
        jsr binop               ; product in acc
        jsr movleft             ; -> arg
        jsr popacc              ; running sum -> acc
        lda #0
        sta tmp5
        ldx #OP_ADD
        jsr binop
        inc xp2
        bne .t
        inc xp2+1
        lbra .t
.st     lda #X0                 ; store, next destination element
        jsr xset
        jsr storevar
        lda #X0
        jmp xadd
; .mulk: A/X * (Y=0: k, Y=1: m) -> tmpw (hardware multiplier)
.mulk   sta $d770
        stx $d771
        lda #0
        sta $d772
        sta $d773
        sta $d776
        sta $d777
        cpy #0
        bne +
        lda xk
        sta $d774
        lda xk+1
        sta $d775
        bra ++
+       lda xm
        sta $d774
        lda xm+1
        sta $d775
++
-       bit $d70f
        bvs -
        lda $d778
        sta tmpw
        lda $d779
        sta tmpw+1
        rts
; .elem: A = XP index of the first element; tmpw = index -> variable (size avt)
.elem   tax
        ldy #0
-       lda XP,x
        sta ap,y
        inx
        iny
        cpy #4
        bne -
        lda avt
        sta vtype
        bpl +
        lda #4
+       sta $d774
        lda #0
        sta $d775
        sta $d776
        sta $d777
        sta $d772
        sta $d773
        lda tmpw
        sta $d770
        lda tmpw+1
        sta $d771
-       bit $d70f
        bvs -
        lda $d778
        clc
        adc ap
        sta ap
        lda $d779
        adc ap+1
        sta ap+1
        lda $d77a
        adc ap+2
        sta ap+2
        jmp setel
; .dims: ptr2 = block -> xi = rows, xj = cols (1-D: 1 x size)
.dims   jsr blkap
        lda [ap],z
        cmp #2
        beq .two
        cmp #1
        beq +
        jmp .bad
+       lda #1
        sta xi
        lda #0
        sta xi+1
        ldz #1
        lda [ap],z
        sta xj
        inz
        lda [ap],z
        sta xj+1
        ldz #0
        rts
.two    ldz #1
        lda [ap],z
        sta xi
        inz
        lda [ap],z
        sta xi+1
        inz
        lda [ap],z
        sta xj
        inz
        lda [ap],z
        sta xj+1
        ldz #0
        rts

; ==== the expression/statement compiler for overlay 4 (moved here for room) ====
; ---------------- compile ----------------
; XCOMP: compile the expression at tp into XB (xbp bytes), xend = the text
; address after it; tp is left unchanged. Carry set: A = 1 never compilable,
; 2 not now (a variable that does not exist yet).
!zone xcomp
xcomp:  lda tp
        sta xctp0
        lda tp+1
        sta xctp0+1
        lda #2                  ; (bytes 0, 1: the text address after it)
        sta xbp
        lda #0
        sta xdep
        sta xcnst
        sta xdyop
        tsx
        stx xsps
        tsy
        sty xsps+1
        lda xmode
        cmp #1
        bne +
        jsr ctarget             ; statement: the target first
+       lda #1
        jsr cexp
        lda xmode
        cmp #2
        bne +
        jsr cthen               ; IF: THEN and the ELSE/end of line targets
        bra ++
+       lda xmode
        beq +
        ldx #0                  ; statement: the store (xstore, xstlen bytes)
-       phx
        lda xstore,x
        jsr xemit
        plx
        inx
        cpx xstlen
        bne -
+
++      lda #<h_end
        jsr xemit
        lda tp
        sta xend
        sta XB
        lda tp+1
        sta xend+1
        sta XB+1
        lda xctp0
        sta tp
        lda xctp0+1
        sta tp+1
        clc
        rts
xfail2: lda #2
        bra +
xfail:  lda #1
+       sta xfk
        ldx xsps
        ldy xsps+1
        +setsp
        lda xctp0
        sta tp
        lda xctp0+1
        sta tp+1
        ldz #0
        lda xfk
        sec
        rts

xemit:  ldx xbp
        sta XB,x
        inx
        stx xbp
        cpx #160
        bcs xfail               ; too long for the buffer
        rts
; XEMITV: A = opcode, X = its no-spill variant (used for the first value)
xemitv: ldy xfirst
        bne xemit
        txa
        bra xemit
xemitl: ldy xfirst              ; variables: h_vi/h_vf -> l_vi/l_vf
        bne xemit
        cmp #<h_vi
        bne +
        lda #<l_vi
        bra xemit
+       lda #<l_vf
        bra xemit
xpush:  inc xdep                ; one more value on the stack
        lda xdep
        cmp #30
        bcs xfail
        rts

; CEXP: A = minimum precedence (as EXPRP)
cexp:   pha
        jsr citem
.l      lda [tp],z
        cmp #' '
        bne +
        jsr nxt
+       jsr getopa              ; A = prec (Z: none), X = op, Y = length
        beq .done
        sta xprec
        pla
        pha
        cmp xprec
        beq .ok
        bcs .done
.ok     phx                     ; op
        tya                     ; consume the operator
        clc
        adc tp
        sta tp
        bcc +
        inc tp+1
+       lda xprec
        inc
        jsr cexp
        plx
        stx xccop
        lda xophand,x
        bne +
        lda #<h_gen             ; through BINOP: h_gen, op
        jsr xemit
        lda xccop
+       jsr xemit
        dec xdep
        bra .l
.done   pla
        rts

xophand:                        ; by OP_ number (0: generic)
        !byte <h_or, <h_eor, <h_and, <h_eq, <h_ne, <h_lt, <h_gt, <h_le, <h_ge
        !byte <h_shl, <h_asr, <h_lsr, <h_add, <h_sub, <h_mul, 0, 0, 0, 0

; CTHEN: after an IF condition: THEN (not followed by the end of the line,
; ';' or a line number), then ELSE or the CR of this line (strings, line
; numbers, REM and DATA skipped as IF's own scan does). Emits h_if,
; then-address, false-address, kind (1 ELSE, 2 CR).
cthen:  lda [tp],z
        cmp #' '
        bne +
        jsr nxt
+       cmp #TTHEN
        lbne xfail              ; IF cond statement (no THEN): interpreter
        inw tp
        jsr nxt
        cmp #CR
        lbeq xfail              ; multi-line IF
        cmp #';'
        lbeq xfail
        cmp #TLINO
        lbeq xfail              ; THEN line
        lda #<h_if
        jsr xemit
        lda tp
        jsr xemit
        lda tp+1
        jsr xemit
        ldz #0
.f      lda [tp],z
        cmp #CR
        beq .cr
        cmp #TELSE
        beq .el
        inz
        lbeq xfail
        cmp #'"'
        beq .q
        cmp #TLINO
        beq .ln
        cmp #TREM
        beq .rem
        cmp #TDATA
        bne .f
.rem    lda [tp],z
        cmp #CR
        beq .cr
        inz
        lbeq xfail
        bra .rem
.q      lda [tp],z
        cmp #CR
        beq .cr
        inz
        lbeq xfail
        cmp #'"'
        bne .q
        bra .f
.ln     inz
        inz
        inz
        bra .f
.el     inz                     ; after ELSE
        lda #1
        bra +
.cr     lda #2
+       sta xfk
        tza
        ldz #0
        clc
        adc tp
        pha
        lda tp+1
        adc #0
        sta xcsy
        pla
        jsr xemit
        lda xcsy
        jsr xemit
        lda xfk
        jmp xemit

; CTARGET: ?item= / !item= (address on the stack), A%= / name%= / name=
; (the store op in xstore: opcode, and for variables the address)
ctarget:
        lda [tp],z
        cmp #'?'
        beq .ind
        cmp #'!'
        bne .var
        lda #<h_st4
        bra +
.ind    lda #<h_st1
+       sta xstore
        lda #1
        sta xstlen
        inw tp
        jsr citem               ; the address
        bra .eq
.var    cmp #'@'
        lbcc xfail
        cmp #$80
        lbcs xfail
        jsr getname
        lbcs xfail
        jsr isarray
        bne +
        jsr carr                ; a%(i)= / a(i)=: index on the stack
        ldx #<h_sai             ; h_ai/h_af -> h_sai/h_saf
        lda xarrop
        cmp #<h_ai
        beq ++
        ldx #<h_saf
++      stx xstore
        ldx #9
-       lda xarr,x
        sta xstore+1,x
        dex
        bpl -
        lda #11
        sta xstlen
        bra .eq
+       lda [tp],z
        cmp #'?'                ; a%?n=, a%!n=: not here
        lbeq xfail
        cmp #'!'
        lbeq xfail
        jsr locate
        lbcs xfail
        lbne xfail2             ; a new variable: the interpreter creates it
        lda vtype
        ldx #<h_svi
        cmp #4
        beq +
        ldx #<h_svf
        cmp #5
        lbne xfail
+       stx xstore
        lda vptr
        sta xstore+1
        lda vptr+1
        sta xstore+2
        lda #3
        sta xstlen
.eq     lda [tp],z
        cmp #' '
        bne +
        jsr nxt
+       cmp #'='
        lbne xfail              ; compound assignments: the interpreter
        ldz #1
        lda [tp],z
        ldz #0
        cmp #'='
        lbeq xfail
        inw tp
        rts

; ARRSCAN: carry set if "name()" (NBUF, nlen bytes ending in '(', then ')')
; occurs in the program or an installed library: then a PROC array
; parameter or LOCAL array may rebind the name and the run-time check stays
!zone asc {
arrscanc:                       ; (cached per pointer field until XCFLUSH)
        ldx #0
        ldy ascnt
        beq .new
-       lda astab,x
        cmp vptr
        bne +
        lda astab+1,x
        cmp vptr+1
        bne +
        lda astab+2,x           ; the carry as found
        lsr
        rts
+       inx
        inx
        inx
        dey
        bne -
.new    jsr arrscan
        php
        lda ascnt               ; remember it (8 entries)
        cmp #8
        lbcs .f
        inc ascnt
        sta xcae                ; x3
        asl
        adc xcae
        tax
        lda vptr
        sta astab,x
        lda vptr+1
        sta astab+1,x
        lda #0
        plp
        rol
        sta astab+2,x
        lsr                     ; (carry back)
        rts
.f      plp
        rts
}
arrscan:
        lda page
        sta fptr
        lda page+1
        sta fptr+1
        lda top
        sta xcae
        lda top+1
        sta xcae+1
        jsr .rng
        bcs .r
        lda libase+1
        cmp #>PLIM
        bcc +
        clc                     ; no library
        rts
+
        sta fptr+1
        lda libase
        sta fptr
        lda #<PLIM
        sta xcae
        lda #>PLIM
        sta xcae+1
.rng    lda #PBANK
        sta fptr+2
        lda #0
        sta fptr+3
.lp     ldz #0
        ldx #0
-       lda [fptr],z
        cmp NBUF,x
        bne .nx
        inz
        inx
        cpx nlen
        bne -
        lda [fptr],z
        cmp #')'
        beq .fd
.nx     inw fptr
        lda fptr
        cmp xcae
        lda fptr+1
        sbc xcae+1
        bcc .lp
        ldz #0
        clc
.r      rts
.fd     ldz #0
        sec
        rts

; CARR: after "name(" (getname): an existing one-dimensional integer or
; float array in attic RAM (global DIM). Compiles the index (tp after ')')
; and sets xarrop (h_ai/h_af) and xarr: pointer field address, its value
; (the handle, checked at run time), size, element base (32-bit).
carr:   jsr locate
        lbcs xfail
        lbne xfail2
        lda vtype
        ldx #<h_ai
        cmp #4
        beq +
        ldx #<h_af
        cmp #5
        lbne xfail
+       stx xarrop
        lda vptr
        sta xarr
        lda vptr+1
        sta xarr+1
        ldy #0
        lda (vptr),y
        sta xarr+2
        sta ptr2
        iny
        lda (vptr),y
        sta xarr+3
        sta ptr2+1
        cmp #ARRH0              ; attic blocks only (not LOCAL arrays)
        lbcc xfail
        jsr blkap
        lda [ap],z              ; dimensions
        cmp #1
        lbne xfail
        inz
        lda [ap],z
        sta xarr+4
        inz
        lda [ap],z
        sta xarr+5
        ldz #0
        lda ap
        clc
        adc #3
        sta xarr+6
        lda ap+1
        adc #0
        sta xarr+7
        lda ap+2
        adc #0
        sta xarr+8
        lda ap+3
        adc #0
        sta xarr+9
        jsr arrscanc            ; never "name()" anywhere: no name check at
        bcs +                   ; run time (field address 0)
        lda #0
        sta xarr
        sta xarr+1
+       bit xcnst               ; citem, integer array, "name(TNUM)": the
        lbpl .vix                ; element address is known now
        lda xarrop
        cmp #<h_ai
        lbne .vix
        lda [tp],z
        cmp #TNUM
        lbne .vix
        ldz #1
        lda [tp],z
        and #7
        clc
        adc #4
        taz
        lda [tp],z
        ldz #0
        cmp #')'
        lbne .vix
        lda tp
        pha
        lda tp+1
        pha
        jsr tnumget
        pla
        tax
        pla
        ldy acc+2               ; within the size?
        bne .nk
        ldy acc+3
        bne .nk
        ldy acc
        cpy xarr+4
        ldy acc+1
        pha
        tya
        sbc xarr+5
        pla
        bcs .nk
        lda acc                 ; base + index * 4
        sta xcae
        lda acc+1
        asl xcae
        rol
        asl xcae
        rol
        sta xcae+1
        lda #0
        rol
        tax
        lda xarr+6
        clc
        adc xcae
        sta xarr+6
        lda xarr+7
        adc xcae+1
        sta xarr+7
        txa
        adc xarr+8
        sta xarr+8
        bcc +
        inc xarr+9
+       inw tp                  ; past ')'
        lda xdep
        sta xfirst
        jsr xpush
        lda #<h_aic
        sta xarrop
        rts
.nk     stx tp+1                ; (out of range: as a variable index)
        sta tp
.vix    lda xarrop
        pha
        ldx #9
-       lda xarr,x
        pha
        dex
        bpl -
        lda #1                  ; the index (keeps the stack depth right)
        jsr cexp
        ldx #0
-       pla
        sta xarr,x
        inx
        cpx #10
        bne -
        pla
        sta xarrop
        lda [tp],z
        cmp #' '
        bne +
        jsr nxt
+       cmp #')'
        lbne xfail
        inw tp
        rts

citem:  lda [tp],z
        cmp #' '
        bne +
        jsr nxt
+       cmp #TNUM
        bne .n0
        jsr tnumget
        bra .kon
.n0     cmp #'.'                ; decimal text (floats, long numbers): CON now
        beq +
        cmp #'0'
        bcc .n1
        cmp #'9'+1
        bcs .n1
+       jsr con
.kon    lda xdep
        sta xfirst
        jsr xpush
        lda accx
        ora acc+1
        ora acc+2
        ora acc+3
        bne +
        lda #<h_k8
        ldx #<l_k8
        jsr xemitv
        lda acc
        jmp xemit
+       lda #<h_k40
        ldx #<l_k40
        jsr xemitv
        ldx #0
-       phx
        lda acc,x
        jsr xemit
        plx
        inx
        cpx #5
        bne -
        rts
.n1     cmp #'('
        bne .n2
        inw tp
        lda #1
        jsr cexp
        lda [tp],z
        cmp #' '
        bne +
        jsr nxt
+       cmp #')'
        lbne xfail
        inw tp
        rts
.n2     cmp #'-'
        bne .n3
        inw tp
        jsr citem
        lda #<h_neg
        jmp xemit
.n3     cmp #'+'
        bne .n5
        inw tp
        jmp citem
.n5     cmp #TCOLLIDE           ; COLLIDE(n)
        bne .n6
        inw tp
        lda #1
        jsr cexp
        lda [tp],z
        cmp #' '
        bne +
        jsr nxt
+       cmp #')'
        lbne xfail
        inw tp
        lda #<h_coll
        jmp xemit
.n6     ldx #<h_ld1             ; ?item / !item (address: an integer)
        cmp #'?'
        beq +
        ldx #<h_ld4
        cmp #'!'
        bne .n4
+       phx
        inw tp
        jsr citem
        pla
        jmp xemit
.n4     cmp #'@'                ; static integer @%, A%..Z%
        lbcc xfail
        cmp #'Z'+1
        bcs .dyn
        tax
        ldz #1
        lda [tp],z
        cmp #'%'
        bne .dynz
        inz
        lda [tp],z
        cmp #'('
        beq .dynz
        cmp #'?'
        beq +
        cmp #'!'
        bne ++
+       sta xdyop
++
+       ldz #0
        txa
        sec
        sbc #'@'
        asl
        asl
        clc
        adc #<STAVAR
        pha
        lda #>STAVAR
        adc #0
        pha
        lda tp
        clc
        adc #2
        sta tp
        bcc +
        inc tp+1
+       lda #<h_vi
        bra .emv
.dynz   ldz #0
.dyn    cmp #$80                ; tokens (functions): not compiled
        lbcs xfail
        jsr getname             ; an existing numeric variable
        lbcs xfail
        jsr isarray
        bne +
        lda #$ff
        sta xcnst
        jsr carr                ; a%(i) / a(i): one dimension, attic
        lda #0
        sta xcnst
        lda xarrop
        ldx #<l_aic
        cmp #<h_aic
        beq .ac
        jsr xemit
        bra .ao
.ac     jsr xemitv
.ao
        ldx #0
-       phx
        lda xarr,x
        jsr xemit
        plx
        inx
        cpx #10
        bne -
        rts
+
        lda [tp],z
        cmp #'?'
        beq +
        cmp #'!'
        bne ++
+       sta xdyop               ; name?n / name!n: after the load
++      jsr locate
        lbcs xfail
        lbne xfail2             ; not created yet
        lda vptr
        pha
        lda vptr+1
        pha
        lda vtype
        ldx #<h_vi
        cmp #4
        beq +
        ldx #<h_vf
        cmp #5
        lbne xfail              ; strings, byte variables
+       txa
.emv    pha
        lda xdep
        sta xfirst
        jsr xpush
        pla
        jsr xemitl
        pla
        sta xcsy
        pla
        jsr xemit
        lda xcsy
        jsr xemit
        lda xdyop               ; dyadic indirection: base?offset (bank 0,
        lbeq .r                  ; 16-bit sum, as GETVPOST)
        ldx #<h_dld1
        cmp #'?'
        beq +
        ldx #<h_dld4
+       phx
        lda #0
        sta xdyop
        inw tp
        jsr citem               ; the offset
        pla
        dec xdep
        jmp xemit
.rd     rts


; FASTI: integer arrays only: a() = b() + - c(), b() + - n (n an integer).
; Runs over the elements in XP / xcnt; returns with xcnt = 0 when done, or
; earlier (an overflow: the generic loop computes that element and goes on,
; with floating point and its error). Nothing to do: returns at once.
!zone fasti
fasti:  lda avt
        cmp #4
        bne .no
        lda xt1
        cmp #4
        bne .no
        bit xflag               ; scalar on the left: generic
        bmi .no
        lda xb2
        ora xb2+1
        beq .sc
        lda xt2
        cmp #4
        bne .no
        lda #4                  ; c[i]: fr steps with the others
        ldx #X2
        bra .ps
.sc     lda xtsc                ; an integer scalar: fr -> xsc (bank 0)
        bne .no
        lda xsc+4
        bne .no
        lda #<xsc
        sta XP+X2
        lda #>xsc
        sta XP+X2+1
        lda #0
        sta XP+X2+2
        sta XP+X2+3
        ldx #X2
.ps     sta xfstep
        ldy #0
-       lda XP,x
        sta fr,y
        lda XP+X0,y
        sta fptr,y
        lda XP+X1,y
        sta fq,y
        inx
        iny
        cpy #4
        bne -
        lda xop
        cmp #OP_ADD
        beq .add
        cmp #OP_SUB
        lbeq .sub
        cmp #OP_AND
        beq .and
.no     rts
.done   ldz #0                  ; back: element pointers for the generic loop
        ldy #3
-       lda fptr,y
        sta XP+X0,y
        lda fq,y
        sta XP+X1,y
        lda fr,y
        sta XP+X2,y
        dey
        bpl -
        rts
.add    lda #$18                ; clc / adc [fr],z
        ldx #$72
        bra .as
.and    lda #$b8                ; clv / and [fr],z
        ldx #$32
        bra .as
.sub    lda #$38                ; sec / sbc [fr],z
        ldx #$f2
.as     sta .cs
        stx .o1
        stx .o2
        stx .o3
        stx .o4
        lda xfstep              ; a scalar: 64 copies in XSS, fr -> XSS
        bne .ch
        ldx #0
-       txa
        and #3
        tay
        lda xsc,y
        sta XSS,x
        inx
        bne -
        lda #<XSS
        sta fr
        lda #>XSS
        sta fr+1
.ch     ldz #0                  ; 64 elements per Z sweep
.el     lda xcnt
        ora xcnt+1
        beq .zf
        lda [fq],z
.cs     clc
.o1 = * + 1
        adc [fr],z
        sta arg
        inz
        lda [fq],z
.o2 = * + 1
        adc [fr],z
        sta arg+1
        inz
        lda [fq],z
.o3 = * + 1
        adc [fr],z
        sta arg+2
        inz
        lda [fq],z
.o4 = * + 1
        adc [fr],z
        bvs .zo
        sta [fptr],z
        dez
        lda arg+2
        sta [fptr],z
        dez
        lda arg+1
        sta [fptr],z
        dez
        lda arg
        sta [fptr],z
        inz
        inz
        inz
        inz
        lda xcnt
        bne +
        dec xcnt+1
+       dec xcnt
        cpz #0
        bne .el
        ldx #fptr               ; 256 bytes on
        jsr .i256
        ldx #fq
        jsr .i256
        lda xfstep
        beq .ch
        ldx #fr
        jsr .i256
        bra .ch
.zo     dez                     ; overflow: back to the element start
        dez
        dez
.zf     ldx #fptr               ; pointers += Z for the generic loop
        jsr .iz
        ldx #fq
        jsr .iz
        ldx #fr
        lda xfstep
        beq +
        jsr .iz
+       jmp .done
.iz     tza
        clc
        adc 0,x
        sta 0,x
        bcc +
        inc 1,x
        bne +
        inc 2,x
+       rts
.i256   inc 1,x
        bne +
        inc 2,x
+       rts
; SUM(a()) / SUMLEN(a$()) / DIM(a()[,n]) functions
!zone arrfn2
o_sum:  lda [tp],z
        cmp #TLEN
        beq .sumlen
        jsr .open
        lda vtype
        bmi .sums
        lda #0                  ; numeric sum
        sta acc
        sta acc+1
        sta acc+2
        sta acc+3
        sta accx
        sta etype
-       lda acnt
        ora acnt+1
        beq .done
        jsr pushval
        jsr aelset
        jsr loadn
        jsr movleft
        jsr popacc
        lda #0
        sta tmp5
        ldx #OP_ADD
        jsr binop
        jsr .adv
        bra -
.done   rts
.sums   lda #0                  ; string concatenation
        sta slen
        lda #$80
        sta etype
-       lda acnt
        ora acnt+1
        beq .done
        jsr movleft
        jsr aelset
        jsr loads
        jsr sconcat
        jsr .adv
        bra -
.sumlen inw tp
        jsr .open
        lda #0
        sta acc
        sta acc+1
        sta acc+2
        sta acc+3
        sta accx
        sta etype
-       lda acnt
        ora acnt+1
        beq .done
        jsr aelset              ; (string descriptor: byte 2 = length)
        ldy #2
        lda (vptr),y
        clc
        adc acc
        sta acc
        bcc +
        inc acc+1
+       jsr .adv
        bra -
.open   jsr nxt                 ; "(name())"
        cmp #'('
        beq +
        jmp syntax
+       inw tp
        jsr arrref
        beq +
        jmp syntax
+       jsr braket
        lda vtype
        sta avt
        jsr arrsize
        jsr apael
        lda tmpw
        sta acnt
        lda tmpw+1
        sta acnt+1
        rts
.adv    jsr aelinc
        lda acnt
        bne +
        dec acnt+1
+       dec acnt
        rts

; DIM(a()) = number of dimensions, DIM(a(),n) = upper bound of dimension n
o_dimfn:
        jsr nxt
        cmp #'('
        beq +
        jmp syntax
+       inw tp
        jsr arrref
        beq +
        jmp syntax
+       lda ptr2
        ora ptr2+1
        bne +
        lda #14
        jmp error
+       jsr nxt
        cmp #','
        beq .n
        jsr braket
        jsr blkap
        lda [ap],z
        ldx #0
        jmp setw
.n      inw tp
        lda ptr2
        pha
        lda ptr2+1
        pha
        jsr expri
        jsr braket
        pla
        sta ptr2+1
        pla
        sta ptr2
        jsr blkap
        lda acc                 ; 1-based dimension
        beq .bad
        cmp [ap],z
        beq +
        bcs .bad
+       asl
        taz
        dez
        lda [ap],z
        sec
        sbc #1
        tax
        inz
        lda [ap],z
        sbc #0
        ldz #0
        tay
        txa
        phy
        plx
        jmp setw
.bad    lda #15
        jmp error

; ^var : address of a variable
; ---- RESTORE (from the resident stub) ----
!zone restore
o_restore:
        jsr nxt
        cmp #TERROR
        bne +
        inw tp
        lda #<errtrp
        jsr resframe
        lda #9
        jsr drop
        jmp xeq
+       cmp #TDATA
        bne +
        inw tp
        lda #<datptr
        jsr resframe
        lda #9
        jsr drop
        jmp xeq
+       cmp #TLOCAL
        bne +
        inw tp
        jsr unwind
        jmp xeq
+       cmp #'+'
        bne +
        inw tp                  ; RESTORE +n: n lines after the current one
        jsr expri
        lda curlin
        sta ptr1
        lda curlin+1
        sta ptr1+1
        jsr setlin
        lda erl
        sta lnum
        lda erl+1
        sta lnum+1
        jsr findl
-       lda acc
        ora acc+1
        beq ++
        ldy #0
        jsr lp1y
        beq ++
        clc
        adc ptr1
        sta ptr1
        bcc +++
        inc ptr1+1
+++     lda acc
        bne ++++
        dec acc+1
++++    dec acc
        bra -
++      lda ptr1
        sta datptr
        lda ptr1+1
        sta datptr+1
        jsr dsrch
        jmp xeq
+       jsr termq
        beq .r0
        jsr itemi
        lda acc
        sta lnum
        lda acc+1
        sta lnum+1
        jsr findl
        lda ptr1
        sta datptr
        lda ptr1+1
        sta datptr+1
        jsr dsrch
        jmp xeq
.r0     lda #0
        sta datptr
        sta datptr+1
        jmp xeq
; ---- whole-array assignment (from the resident ARRLET stub) ----
; whole-array assignment: name() = ...   (tp at name; returns NZ if not an array ref)
!zone arrlet
o_arrlet:
        lda vptr
        sta avp
        lda vptr+1
        sta avp+1
        lda vtype
        sta avt
        lda ptr2
        sta ablk
        lda ptr2+1
        sta ablk+1
        jsr nxt
        ldx #$ff
        cmp #'='
        beq .eq
        ldx #OP_ADD
        cmp #'+'
        beq .cmp
        ldx #OP_SUB
        cmp #'-'
        beq .cmp
        ldx #OP_MUL
        cmp #'*'
        beq .cmp
        ldx #OP_FDIV
        cmp #'/'
        beq .cmp
        jmp mistake
.cmp    inw tp
        lda [tp],z
        cmp #'='
        beq .eq
        jmp mistake
.eq     inw tp
        stx aop
        jsr nxt
        jsr arrref              ; a() = b()  (copy)
        lbne .expr
        lda vtype
        sta avt2
        lda aop
        cmp #$ff
        lbne .expr2
        jsr nxt                 ; a() = b() OP ... : whole-array arithmetic
        cmp #'+'
        beq .ar
        cmp #'-'
        beq .ar
        cmp #'*'
        beq .ar
        cmp #'/'
        beq .ar
        cmp #TAND               ; (B65: a() = b() AND c() / n)
        beq .ar
        cmp #'.'
        bne .cpy
.ar     jmp arrarith
.cpy
        lda ablk
        ora ablk+1
        bne +
        ; destination not DIMmed: share? BASIC V copies into an existing array only
        lda #14
        jmp error
+       jsr arrsize             ; source
        jsr apaelq
        lda tmpw
        pha
        lda tmpw+1
        pha
        lda ablk
        sta ptr2
        lda ablk+1
        sta ptr2+1
        jsr arrsize             ; destination
        pla
        cmp tmpw+1
        bne .badsz
        pla
        cmp tmpw
        bne .badsz2
        jsr apael
        lda tmpw
        sta acnt
        lda tmpw+1
        sta acnt+1
-       lda acnt                ; element by element (strings are copied)
        ora acnt+1
        lbeq .done
        jsr aelqset
        jsr loadvar
        jsr aelset
        jsr storevar
        jsr aelinc
        jsr aelqinc
        lda acnt
        bne +
        dec acnt+1
+       dec acnt
        bra -
.badsz2 pla
.badsz  lda #15                 ; Bad subscript (size mismatch)
        jmp error
.expr2  jmp syntax
.expr   ; a() = expr[,expr...]  or a() op= expr
        lda ablk
        sta ptr2
        lda ablk+1
        sta ptr2+1
        jsr arrsize
        jsr apael
        lda tmpw
        sta acnt
        lda tmpw+1
        sta acnt+1
        lda #0
        sta alist
        lda aop                 ; "a() = n OP b()" / "a() = -b()": overlay 2
        cmp #$ff
        bne .e1
        jmp arrpre              ; (comes back at arrle1 or arrle1x)
arrle1:
.e1     jsr expr
arrle1x:
        lda etype
        eor avt
        and #$80
        beq +
        lda #6
        jmp error
+       jsr pushval             ; keep value
        jsr nxt
        cmp #','
        bne .fill
        ; initialisation list: store this value in the next element only
        inw tp
        lda #1
        sta alist
        jsr popacc
        jsr .store1
        lda acnt
        ora acnt+1
        beq .e1                 ; (extra values are ignored)
        bra .e1
.fill   jsr popacc
        lda alist
        bne .last
-       lda acnt                ; fill (or op=) every element
        ora acnt+1
        beq .done
        jsr pushval
        jsr .store1
        jsr popacc
        bra -
.last   jsr .store1             ; last element of an init list
.done   jmp xeq
; store acc/ACCS (with op) into the element at aelp, advance
.store1 lda acnt
        ora acnt+1
        bne +
        rts
+       jsr aelset
        lda aop
        cmp #$ff
        beq .st
        jsr pushval             ; element = element OP rhs
        jsr loadvar
        jsr movleft
        jsr popacc
        ldx aop
        jsr binop
        jsr aelset
.st     jsr storevar
        jsr aelinc              ; next element
        lda acnt
        bne +
        dec acnt+1
+       dec acnt
        rts
!src "src/hitpix.a"
ovl_xtra_end:
!if ovl_xtra_end > HB { !error "overlay 2 runs into HITPIX's buffers" }
}
