; SETSP: X/Y -> 16-bit SP atomically (an IRQ between TXS and TYS would push
; to a wrong address)
; LDTPY: A = byte at tp+Y (flags from it); Z stays 0
!macro ldtpy {
        tya
        taz
        lda [tp],z
        php
        ldz #0
        plp
}
; Program text lives in bank PBANK; 16-bit program addresses below PMIN
; are bank-0 buffers (ACCS, BUFFER, EVBUF).
PBANK   = 1
PMIN    = $0800
PLIM    = $f800         ; end of program space in bank 1 (colour RAM above)
; LPY p: A = program byte at (p)+Y (flags from it); X, Y kept; Z stays 0
!macro lpy .p {
        lda .p
        sta pp
        lda .p+1
        sta pp+1
        tya
        taz
        lda [pp],z
        php
        ldz #0
        plp
}
; SPY p: program byte at (p)+Y := A; X, Y kept
!macro spy .p {
        pha
        lda .p
        sta pp
        lda .p+1
        sta pp+1
        tya
        taz
        pla
        sta [pp],z
        ldz #0
}
!macro setsp {
        sei
        txs
        tys
        bit irqon
        bpl .ss
        cli
.ss
}
; B65 BASIC - zero page and fixed memory map
; Derived from BBC BASIC (Z80) v5 by R.T. Russell (zlib licence) - see LICENSE

; ---------------- fixed areas (bank 0) ----------------
ACCS    = $0200         ; string accumulator (256 bytes, like Z80 ACCS)
BUFFER  = $0300         ; tokenised line buffer (256 bytes)
STAVAR  = $0400         ; @%,A%..Z% (27*4 bytes)
DYNVAR  = $0470         ; list heads, 2 bytes * 58 ('A'..'z')
FNPTR   = DYNVAR+116    ; FN list head
PROPTR  = FNPTR+2       ; PROC list head
DYNEND  = PROPTR+2
STRBUF  = $0500         ; scratch string buffer (comparisons etc)
NUMBUF  = $0600         ; number formatting buffer
SCREEN  = $0800         ; 80x25 text screen
SCRW    = 80
SCRH    = 25
HIMEM0  = $CF00         ; default HIMEM (stack grows down from here)

; test-script / transcript (accessed with 32-bit pointers). Xemu puts the
; script at TSTMAGIC (bank 1, the program bank): test_init copies it to
; TSTCOPY in attic RAM first. The Xemu transcript is in bank 4 (28 KB).
TSTMAGIC = $00010000    ; "B65TEST:" magic, script follows
TSTCOPY  = $08020000    ; attic copy of the script (Xemu)
TRANSCR  = $00048000    ; transcript of all output (Xemu testing only)
TRANSEND = $f0          ; ... up to $4F000

; ---------------- zero page ----------------
acc     = $04   ; 4 bytes: integer / mantissa
accx    = $08   ; exponent (0 = integer)
arg     = $09   ; 4 bytes second operand
argx    = $0d
etype   = $0e   ; expression type: 0 numeric, $80 string
slen    = $0f   ; length of string in ACCS
vptr    = $10   ; variable pointer
vtype   = $12   ; variable type (0 byte-ind,1 byte,4 int,5 float,$80 $-ind,$81 string)
ptr1    = $13
ptr2    = $15
ptr3    = $17
tmp0    = $19
tmp1    = $1a
tmp2    = $1b
tmp3    = $1c
tmp4    = $1d
tmp5    = $1e
tmp6    = $1f
spz     = $20   ; copy of SP for stack-frame access
page    = $22
top     = $24
lomem   = $26
free    = $28
himem   = $2a
curlin  = $2c
errtrp  = $2e
onersp  = $30
errnum  = $32
erl     = $33
errtxt  = $35
count   = $37
width   = $38
listo   = $39
crow    = $3a
ccol    = $3b
scrp    = $02   ; pointer to start of cursor row
ap      = $3c   ; 32-bit array block / element address
datptr  = $f8   ; 2 bytes (+2 spare: saved as 4 by LOCAL DATA)
tsp     = $40   ; 32-bit test script pointer
twp     = $44   ; 32-bit transcript pointer
tp      = $48   ; text pointer (Z80: IY), 32-bit: always used as [tp],z
pp      = $4c   ; 32-bit program pointer (walking program lines)
testmode= $1fb0
lexmode = $1fb1  ; LEXAN mode bits (Z80: C)
autono  = $1fb2
increm  = $1fb4
tracen  = $1fb6
seed    = $50   ; 5 bytes
fptr    = $55   ; 32-bit general far pointer
lnum    = $59   ; 2 bytes line number
indent  = $5b
listflg = $5c
vduq    = $5d   ; VDU queue: bytes still expected
vducmd  = $5e
vdup    = $5f   ; 2 param bytes $5f,$60
prflag  = $61   ; PRINT flags
hexflg  = $62
nlen    = $63   ; name length
nfirst  = $64   ; first char of name
tmpw    = $65   ; 2 bytes
tmpw2   = $67
fnlev   = $69
saveacc = $6a   ; 5 bytes save area
cnt     = $6f
lnum2   = $70
optr    = $72
rtmp    = $74
rndn    = $76    ; 4 bytes
capflg  = $7a
lnum3   = $7b    ; 2 bytes
fpopc   = $7d
NBUF    = $80   ; up to 40 bytes variable name buffer ($80-$a7)

; floating point package workspace
fext    = $a8   ; 2
afl     = $aa
fsg     = $ab   ; result sign (bit 7)
fxs     = $ac
ftgt    = $ad
fsp     = $ae   ; FP stack index
fpsoft  = $af   ; 0 = math unit, else software multiply/divide
fp64    = $b0   ; 8 bytes: 64-bit product / scratch
fnum    = $b8   ; 8 bytes: 64-bit dividend scratch
fq      = $c0   ; 4 bytes quotient
fr      = $c4   ; 4 bytes remainder
fa_     = $c8   ; misc bytes for STR/CON/POWR10
fb_     = $c9
fc_     = $ca
fd_     = $cb
fe_     = $cc
ff_     = $cd
fg_     = $ce
fh_     = $cf
FSTK    = $07b0 ; FP value stack (16 x 5 bytes)
fsav    = $d0   ; 5 bytes saved FA
pcnt    = $d5   ; POWR10 counter
prem    = $d6   ; POWR10 remaining
pcar    = $d7   ; POWR10 saved carry
dB      = $d8   ; STR: B register (decimal exponent)
dC      = $d9   ; STR: C as used for counters
dD      = $da
dE      = $db
fmtd    = $dc   ; digits (IX+1)
fmtf    = $dd   ; format (IX+2)
optr2   = $de   ; output pointer (2)
dsp     = $e0   ; STR digit stack index
zA      = $e1
zF      = $e2   ; emulated Z80 flags: bit0 C, bit6 Z, bit7 S
sR      = $e4   ; SQR root (4)
sM      = $e8   ; SQR remainder (4)
sD      = $ec   ; SQR radicand (4)
sA      = $f0
sC      = $f1
epos    = $f2
ipcnt   = $f3
ipbits  = $f4   ; 4 bytes
DSTK    = $0780 ; STR digit stack (pairs A,F), 24 entries
rtmp2   = $fc   ; 2
elseln  = MISC+107       ; current line starts with ELSE (IF scanning)
casel   = $fe
retmask = $ff
; misc RAM variables (absolute addressing) after NUMBUF
MISC    = $0640
avp     = MISC+0        ; 2 whole-array: pointer field
ablk    = MISC+2        ; 2 array block
avt     = MISC+4        ; element type
aop     = MISC+5        ; op
aelp    = $1fbc         ; 4 element address (32-bit: arrays may be far)
aelq    = $1fc0         ; 4 second element address
arrtop  = $1fc4         ; 2 next free far-array handle ($E000.. = attic $8600000..)
avt2    = $1fc6         ; element type of the second array (aelq)
acnt    = MISC+8        ; 2 elements left
alist   = MISC+10       ; init list flag
llen    = MISC+11       ; line editor: length
lcur    = MISC+12       ; line editor: cursor
curovl  = MISC+14       ; mapped overlay ($ff none)
asmopt  = MISC+15       ; assembler OPT
asmq    = MISC+80       ; assembler: suppress undefined-label errors
doserr  = MISC+13       ; last Hyppo DOS error code (?&64D)
scrcols = MISC+122      ; text columns (80 / 40)
tcolour = MISC+123      ; text colour (text mode)
gchar   = MISC+113      ; character for the graphics text renderer
FONTADDR = $04f800      ; 2K charset in chip RAM (bank 4, above the overlays)
HISTADDR = $04f700      ; line editor history (256 bytes)
dimloc  = $1df3       ; DIM of a LOCAL array: allocate on the stack
dimvt   = $1df4       ; DIM: element type of the array being created
libase  = $1fb8       ; 2 lowest installed library in the program bank (PLIM: none)
libcur  = $1fba       ; 2 library being scanned (high byte 0: the program)
rfar    = $1fc7       ; RETURN parameter capture: far flag
rfad    = $1fdc       ; 4 its far address
fndef   = $1fe4       ; setfname: 0 if the default extension .BBC was added
