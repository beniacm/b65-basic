; Test boot stub for Xemu: used as "-extonboard" image.
; Hyppo copies the image from $40000 to $07FF and runs $080D in hypervisor
; context. We copy the interpreter (file offset $100) to $2001, the test
; script (file offset $8000) to $10000, clear the transcript buffer at
; $18000 and leave the hypervisor into the interpreter's test entry ($2017).
!cpu m65
!to "build/boot.bin", cbm
* = $0801
        !fill $080d - *, 0
        sei
        ldz #0
        ; copy $B000 bytes $40100 -> $02001
        lda #$00 : sta $f0 : lda #$01 : sta $f1 : lda #$04 : sta $f2 : lda #0 : sta $f3
        lda #$01 : sta $f4 : lda #$20 : sta $f5 : lda #$00 : sta $f6 : sta $f7
        ldx #$b0
        jsr copy
        ; copy $3F00 bytes $4C000 -> $10000
        lda #$00 : sta $f0 : lda #$c0 : sta $f1 : lda #$04 : sta $f2
        lda #$00 : sta $f4 : sta $f5 : lda #$01 : sta $f6
        ldx #$3f
        jsr copy
        ; clear $18000-$1FFFF
        lda #$00 : sta $f4 : lda #$80 : sta $f5 : lda #$01 : sta $f6
        ldx #$80
        lda #0
--      ldz #0
-       sta [$f4],z
        inz
        bne -
        inc $f5
        dex
        bne --
        ; leave hypervisor into $2017
        lda #$17 : sta $d648
        lda #$20 : sta $d649
        lda #$24 : sta $d647    ; P: I set, E set (8-bit stack)
        lda #$ff : sta $d645
        lda #$01 : sta $d646
        lda #0
        sta $d640 : sta $d641 : sta $d642 : sta $d643 : sta $d644
        sta $d64a : sta $d64b : sta $d64c : sta $d64d : sta $d64e : sta $d64f
        sta $d030
        lda #$2f : sta $d650
        lda #$35 : sta $d651
        lda #3 : sta $d652
        sta $d67f
-       jmp -
copy:   ; X pages from [$f0] to [$f4]
--      ldz #0
-       lda [$f0],z
        sta [$f4],z
        inz
        bne -
        inc $f1
        bne +
        inc $f2
+       inc $f5
        bne +
        inc $f6
+       dex
        bne --
        rts
