MEGA65 (model $03), 384K chip RAM, 8MB attic RAM

>10 F%=OPENOUT "B65DATA"
>20 PRINT#F%,42,3.25,"hello",-7
>30 BPUT#F%,65:BPUT#F%,"line";:BPUT#F%,"x"
>40 PRINT "ptr ";PTR#F%;" ext ";EXT#F%
>50 CLOSE#F%
>60 F%=OPENIN "B65DATA"
>70 INPUT#F%,A%,B,C$,D
>80 PRINT A%,B,C$,D
>90 PRINT BGET#F%;" ";GET$#F%;" eof ";EOF#F%
>100 PTR#F%=0:READ#F%,X:PRINT X;" ";PTR#F%;" ";EXT#F%
>110 CLOSE#F%
>120 F%=OPENUP "B65DATA":PTR#F%=EXT#F%:BPUT#F%,"more":PTR#F%=0:BPUT#F%,7:PRINT EXT#F%:CLOSE#F%
>130 F%=OPENIN "B65DATA":PRINT BGET#F%;" ";:PTR#F%=27:PRINT GET$#F%;"|";GET$#F%:CLOSE#F%
>140 F%=OPENIN "B65NONE":PRINT "none ";F%
>150 F%=OPENIN "B65DATA":ON ERROR PRINT REPORT$:CLOSE#F%:END
>160 BPUT#F%,1
>RUN
ptr 28 ext 28
        42      3.25hello             -7
        65 linex eof -1
        42 5 28
        33
         7 |more
none 0
Access denied
>NEW
>10 F%=OPENOUT "B65BIGD"
>20 A$=STRING$(250,"x")
>30 FOR I%=1 TO 2400:PRINT#F%,A$:NEXT
>40 PRINT EXT#F%
>50 CLOSE#F%
>60 F%=OPENIN "B65BIGD":N%=0:S%=0
>70 REPEAT A$=GET$#F%:N%+=1:S%+=LEN A$:UNTIL EOF#F%
>80 PRINT N%,S%,PTR#F%:CLOSE#F%
>RUN
    602400
      2400    600000    602400
>
