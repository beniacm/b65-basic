MEGA65 (model $03), 384K chip RAM, 8MB attic RAM

>NEW
>10 DEF FNlibsq(X)=X*X
>20 DEF PROClibhi(A$):PRINT "hello ";A$:ENDPROC
>30 DEF FNlib2:=42
>SAVE "B65LIB1"
>NEW
>10 DEF PROClib3:PRINT "lib3 ";FNlib2:ENDPROC
>SAVE "B65LIB2"
>NEW
>PRINT ~HIMEM
      CF00
>INSTALL "B65LIB1"
>PRINT ~HIMEM
      CF00
>10 FOR I%=1 TO 2
>20 INSTALL "B65LIB2"
>30 PRINT FNlibsq(7):PROClibhi("world"):PROClib3
>40 NEXT
>50 PRINT ~HIMEM
>60 PROCmain
>70 END
>80 DEF PROCmain:LOCAL a,b:a=3:b=FNlibsq(a):PRINT "main ";b
>90 ON ERROR LOCAL PRINT "trapped ";REPORT$:ENDPROC
>100 PROCnone
>110 ENDPROC
>RUN
        49
hello world
lib3 42
        49
hello world
lib3 42
      CF00
main 9
trapped No such FN/PROC
