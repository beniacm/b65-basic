MEGA65 (model $03), 384K chip RAM, 8MB attic RAM

>PRINT 1+2*3, (1+2)*3, 7 DIV 2, -7 MOD 3
         7         9         3        -1
>PRINT &FF, %101, ~255, 1<<4, -16>>2
       255         5        FF        16        -4
>PRINT 1=1, 1<>1, 3<5, "a"<"b"
        -1         0        -1        -1
>A$="abc":B$=A$+"def":PRINT B$;LEN(B$);LEFT$(B$,2);MID$(B$,3,2);RIGHT$(B$,2)
abcdef6abcdef
>PRINT CHR$(65);ASC("A");STR$(123);VAL("-42");INSTR("hello","ll");STRING$(3,"ab")
A65123-423ababab
>X=5:X+=2:X*=3:PRINT X
        21
>DIM A%(10),M%(2,3):A%(3)=7:M%(2,3)=9:PRINT A%(3)+M%(2,3)
        16
>IF 1 THEN PRINT "yes" ELSE PRINT "no"
yes
>IF 0 THEN PRINT "yes" ELSE PRINT "no"
no
>FOR I%=1 TO 3:PRINT I%;:NEXT:PRINT " after:";I%
         1         2         3 after:4
>FOR K%=10 TO 1 STEP -4:PRINT K%;" ";:NEXT:PRINT
        10          6          2 
