>LIST
   10 REM B65 BASIC smoke test
   20 FOR I%=1 TO 5
   30   PRINT I%, I%*I%
   40 NEXT
   50 X=0
   60 REPEAT X=X+3 : UNTIL X>10
   70 PRINT "X=";X
   80 PROChello("world",42)
   90 PRINT FNsq(7), FNfact(10)
  100 END
  110 DEF PROChello(a$,n%)
  120 LOCAL i%
  130 i%=n% DIV 2
  140 PRINT "hello ";a$;" ";i%
  150 ENDPROC
  160 DEF FNsq(y)=y*y
  170 DEF FNfact(n%) IF n%<=1 THEN =1 ELSE =n%*FNfact(n%-1)
>RUN
