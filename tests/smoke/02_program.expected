>LIST
   10 REM B65 BASIC smoke test
   20 FOR I%=1 TO 5
   30   PRINT I%, I%*I%
   40 NEXT
   50 X=0
   60 REPEAT X=X+3 : UNTIL X>10
   70 PRINT "X=";X
   80 PROChello("world",42)
   90 PRINT FNsq(7), FNfact(10)
>95 IF FALSE THEN GOTO 20 ELSE GOSUB 50
>RENUMBER 100,5
>LIST
  100 REM B65 BASIC smoke test
  105 FOR I%=1 TO 5
  110   PRINT I%, I%*I%
  115 NEXT
  120 X=0
  125 REPEAT X=X+3 : UNTIL X>10
  130 PRINT "X=";X
  135 PROChello("world",42)
  140 PRINT FNsq(7), FNfact(10)
  145 IF FALSE THEN GOTO 105 ELSE GOSUB 120
