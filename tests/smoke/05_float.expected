>PRINT 1/3
0.333333333
>PRINT 2/3, 1/7, 10/4
0.666666667         0.142857143                2.5
>PRINT PI
3.14159265
>PRINT 1.5+2.25, 0.1+0.2, 1E10, 1.5E-5
      3.75       0.3      1E10    1.5E-5
>PRINT 2147483647+1, 100000*30000
2.14748365E9               3E9
>PRINT SQR(2), SQR(16), SQR(1E10)
1.41421356         4    100000
>PRINT SIN(PI/6), COS(0), TAN(PI/4)
       0.5         1         1
>PRINT EXP(1), LN(10), LOG(1000)
2.718281832.30258509         3
>PRINT ATN(1)*4, ASN(1), ACS(0)
3.141592651.570796331.57079633
>PRINT 2^10, 2^0.5, 2^-1, (-2)^3
      10241.41421356       0.5        -8
>PRINT INT(-3.5), INT(3.99), ABS(-2.5), SGN(-0.1)
        -4         3       2.5        -1
>PRINT DEG(PI), RAD(180)
       1803.14159265
>PRINT VAL("3.25E2"), STR$(1/3)
       3250.333333333
>A%=7.9:PRINT A%
         7
>X=0.1:FOR I=1 TO 10:X=X+0.1:NEXT:PRINT X
       1.1
>FOR F=0 TO 1 STEP 0.25:PRINT F;" ";:NEXT:PRINT
         0       0.25        0.5       0.75          1 
