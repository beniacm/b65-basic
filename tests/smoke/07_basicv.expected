>10 FOR I%=1 TO 4
>20   CASE I% OF
>30   WHEN 1: PRINT "one"
>40   WHEN 2,3
>50     PRINT "two or three"
>60   OTHERWISE
>70     PRINT "other"
>80   ENDCASE
>90 NEXT
>100 A$="b":CASE A$ OF
>110 WHEN "a":PRINT "is a"
>120 WHEN "b":PRINT "is b"
>130 ENDCASE
>140 I%=0:REPEAT I%+=1:IF I%=3 THEN EXIT REPEAT
>150 UNTIL I%=10:PRINT "exit repeat at ";I%
>160 FOR J%=1 TO 10:IF J%=4 THEN EXIT FOR
>170 NEXT:PRINT "exit for at ";J%
>180 K%=0:WHILE TRUE:K%+=1:IF K%>5 THEN EXIT WHILE
>190 ENDWHILE:PRINT "exit while at ";K%
>200 X=1:Y=2:SWAP X,Y:PRINT X;Y
>210 S$="hello world":MID$(S$,7)="WORLD":LEFT$(S$,1)="H":PRINT S$
>220 DIM A(4),B(4):A()=1,2,3,4,5:B()=A():B()*=2:PRINT SUM(A()),SUM(B()),DIM(A()),DIM(A(),1)
>230 PROCarr(A()):PRINT A(0)
>240 DIM N$(2):N$()="x":N$(1)="yy":PRINT SUMLEN(N$())
>250 P%=^X:PRINT P%>0
>260 ON ERROR LOCAL PRINT "local handler": GOTO 280
>270 PRINT 1/0
>280 RESTORE ERROR
>290 PRINT "done"
>300 END
>310 DEF PROCarr(z()):z(0)=99:ENDPROC
>RUN
one
two or three
two or three
other
is b
exit repeat at 3
exit for at 4
exit while at 6
         21
Hello WORLD
        15        30         1         4
        99
         4
        -1
local handler
done
>NEW
>10 PROCd:READ A:PRINT "after PROC: ";A
>20 RESTORE +3:READ B:PRINT "RESTORE +3: ";B
>30 END
>40 DATA 1,2
>50 DATA 3
>60 DATA 4
>70 DATA 5
>80 DEF PROCd
>90 LOCAL DATA
>100 RESTORE 60:READ X:PRINT "in PROC: ";X
>110 ENDPROC
>RUN
in PROC: 4
after PROC: 1
RESTORE +3: 3
>