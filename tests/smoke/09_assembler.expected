>10 DIM code% 300
>20 FOR pass%=0 TO 3 STEP 3
>30 P%=code%
>40 [OPT pass%
>50 .start LDA #&41:STA &0800:STA &12:LDX #3
>60 .loop DEX:BNE loop:BRA loop
>70 LDQ &10:STQ &1234:LDQ (&20):LDQ [&20]:ADCQ &30:ASLQ:INQ:CPQ &40
>80 LDA [&20],Z:STA [&22],Z:ORA (&22),Y:LDA (&24),Z:LDA (&26,X):LDA (&28,SP),Y
>90 AND #&0F:EOR &1234,X:ORA &12,Y:ASL A:ROR &34,X:LSR &1234:INC:DEC A
>100 JSR sub:JMP (&1234):JMP (&1234,X):JSR (&1234)
>110 LBNE start:BSR sub:LBRA start
>120 BBR3 &12,start:SMB5 &34:RMB0 &56
>130 PHW #&1234:PHW &5678:RTN #2:NEG:ASR A:ASW &1234:ROW &1234:INW &12:DEW &14
>140 TAZ:TZA:TAB:TBA:TSY:TYS:CLE:SEE:MAP:EOM:LDZ #5:LDZ &1234:CPZ #1:STZ &12
>150 .sub RTS
>160 ]
>170 NEXT
>180 PRINT ~code%,P%-code%
>190 FOR I%=code% TO P%-1:PRINT ~?I%;" ";:NEXT
>RUN
