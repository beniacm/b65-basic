MEGA65 (model $03), 384K chip RAM, 8MB attic RAM

>10 A=1:B$="x":C%=5
>20 PROCchg(A,B$,C%)
>30 PRINT A;" ";B$;" ";C%
>40 X=FNtwice(A):PRINT X;" ";A
>50 DIM Q(3):Q(2)=7:PROCchg(Q(2),B$,C%):PRINT Q(2)
>60 END
>70 DEF PROCchg(RETURN p, RETURN q$, r%)
>80 p=p*10:q$=q$+"y":r%=99
>90 ENDPROC
>100 DEF FNtwice(RETURN v):v=v*2:=v+1
>RUN
        10 xy 5
        21 20
        70
>NEW
>10 FOR N%=1 TO 4
>20 IF N%=1 THEN
>30   PRINT "one"
>40 ELSE IF N%=2 THEN
>50   PRINT "two"
>60 ELSE IF N%=3 THEN;
>70   IF N%>0 THEN
>80     PRINT "three (nested)"
>90   ENDIF
>100 ELSE
>110   PRINT "other"
>120 ENDIF
>130 NEXT
>RUN
one
two
three (nested)
other
>
