MEGA65 (model $03), 384K chip RAM, 8MB attic RAM

>10 A=1:B$="x":C%=5
>20 PROCchg(A,B$,C%)
>30 PRINT A;" ";B$;" ";C%
>40 X=FNtwice(A):PRINT X;" ";A
>50 DIM Q(3):Q(2)=7:PROCchg(Q(2),B$,C%):PRINT Q(2)
>60 END
>70 DEF PROCchg(RETURN p, RETURN q$, r%)
>80 p=p*10:q$=q$+"y":r%=99
>90 ENDPROC
>100 DEF FNtwice(RETURN v):v=v*2:=v+1
>RUN
        10 xy 5
        21 20
        70
>NEW
>10 FOR N%=1 TO 4
>20 IF N%=1 THEN
>30   PRINT "one"
>40 ELSE IF N%=2 THEN
>50   PRINT "two"
>60 ELSE IF N%=3 THEN;
>70   IF N%>0 THEN
>80     PRINT "three (nested)"
>90   ENDIF
>100 ELSE
>110   PRINT "other"
>120 ENDIF
>130 NEXT
>RUN
one
two
three (nested)
other
>NEW
>10 DIM A(3),B(3),C(3),M(1,2),N(2,1),P(1,1),V(2),W(1)
>20 A()=1,2,3,4:B()=10,20,30,40
>30 C()=A()+B():PRINT C(0);C(3)
>40 C()=B()-A():PRINT C(1);C(2)
>50 C()=A()*3:PRINT C(3)
>60 C()=B()/A():PRINT C(2)
>70 M()=1,2,3,4,5,6:N()=7,8,9,10,11,12
>80 P()=M().N():PRINT P(0,0);" ";P(0,1);" ";P(1,0);" ";P(1,1)
>90 V()=1,2,3:W()=M().V():PRINT W(0);" ";W(1)
>RUN
        1144
        1827
        12
        10
        58 64 139 154
        14 32
>NEW
>10 PROCt(5):PROCt(7):PRINT "procs ok"
>15 PRINT "free ok: ";FNfree
>20 DIM B% 3:?B%=1:PRINT ?B%
>30 END
>40 DEF PROCt(n%)
>50 LOCAL a(),s$()
>60 DIM a(n%),s$(2):a(n%)=n%*2:s$(1)="z"
>70 DIM p% LOCAL 10:?p%=42:PRINT a(n%);" ";?p%;" ";s$(1);" ";p%<HIMEM
>80 ENDPROC
>90 DEF FNfree:LOCAL q%:DIM q% LOCAL -1:=q%>0
>RUN
        10 42 z -1
        14 42 z -1
procs ok
free ok: -1
         1
>
