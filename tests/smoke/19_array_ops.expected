MEGA65 (model $03), 384K chip RAM, 8MB attic RAM

>10 DIM A(3),B(3),C(3),I%(3),S$(2),T$(2),U$(2),M(1,2),N(2,1),R(1,1),V(2),W(1)
>20 B()=1,2,3,4:C()=10,20,30,40
>30 A()=B()+C():PROCp("b+c")
>40 A()=C()-B():PROCp("c-b")
>50 A()=B()*C():PROCp("b*c")
>60 A()=C()/B():PROCp("c/b")
>70 A()=B()*2:PROCp("b*2")
>80 A()=100-B():PROCp("100-b")
>90 A()=-B():PROCp("-b")
>100 A()=(1+1)*C():PROCp("(1+1)*c")
>110 I%()=C()/3:PRINT "int ";I%(0);" ";I%(3)
>120 A()=I%()+0.5:PROCp("i%+0.5")
>130 A()=7:PROCp("fill")
>140 M()=1,2,3,4,5,6:N()=7,8,9,10,11,12:R()=M().N():PRINT "dot ";R(0,0);" ";R(0,1);" ";R(1,0);" ";R(1,1)
>150 V()=1,2,3:W()=M().V():PRINT "mat.vec ";W(0);" ";W(1)
>160 S$()="a","b","c":T$()="x","y","z"
>170 U$()=S$()+T$():PRINT U$(0);U$(1);U$(2)
>180 U$()=S$()+"!":PRINT U$(0);U$(1);U$(2)
>190 U$()="<"+T$():PRINT U$(0);U$(1);U$(2)
>200 ON ERROR PRINT REPORT$:END
>210 U$()=S$()-T$()
>220 END
>300 DEF PROCp(t$):PRINT t$;": ";A(0);" ";A(1);" ";A(2);" ";A(3):ENDPROC
>RUN
